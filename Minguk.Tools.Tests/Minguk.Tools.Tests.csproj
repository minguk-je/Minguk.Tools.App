<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Platforms>x64</Platforms>
		<Platform Condition="'$(Platform)' == 'AnyCPU'">x64</Platform>
	</PropertyGroup>

	<PropertyGroup>
		<!-- 결과는 콘솔로 내보내지만, 검증 대상이 살아 있는 창이라 WPF 가 필요하다. -->
		<OutputType>Exe</OutputType>
		<UseWPF>true</UseWPF>

		<!-- 참조하는 Minguk.Tools 와 같은 TFM 이어야 한다. -->
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>

		<Nullable>enable</Nullable>
		<RootNamespace>Minguk.Tools.Tests</RootNamespace>
		<AssemblyName>Minguk.Tools.Tests</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.12" />
	</ItemGroup>

	<!--
	  단위 테스트 프레임워크를 쓰지 않는다. 검증 대상이 실제 커서 위치와 실제 창의 입력 처리라
	  목으로는 확인할 수 없다. 창을 띄우고 입력을 쏜 뒤 결과를 되읽는 실행형 하네스다.

	  interception.dll 과 DirectML 은 Minguk.Tools 의 Content 라 이 참조를 타고 따라온다.
	  Content 로 둔 이유가 이것이다.
	-->
	<ItemGroup>
		<ProjectReference Include="..\Minguk.Tools\Minguk.Tools.csproj" />
	</ItemGroup>

</Project>
