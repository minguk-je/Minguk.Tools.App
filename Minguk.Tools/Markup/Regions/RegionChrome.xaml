<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:regions="clr-namespace:Minguk.Tools.Markup.Regions">

    <!--
        참조 프로젝트(wpf_test_app.ResizeAdorner)의 DesignerItem · ResizeRotateChrome · SizeChrome 을 옮긴 것. 회전 손잡이는 뺐다.
        모양은 라벨링 캔버스(LabelCanvas)와 같게 맞췄다(2026-09-15, 사용자 "Adorner 라벨링 화면이랑 같게"):
        평소 1.5px 테두리 · 자리 색 바탕에 흰 11px 이름표 / 고르면 같은 색 3px 테두리 · 모서리와 변 가운데 6px 네모 손잡이.
        미리보기는 판을 LayoutTransform 으로 키우므로, 크기마다 배율 역수(RegionItem.InverseZoom)를 곱해 확대해도 화면에서 같은 크기다.
    -->

    <regions:RegionRoundConverter x:Key="RegionRoundConverter" />
    <regions:RegionZoomConverter x:Key="Zoom" />
    <!-- 배율 역수를 Transform 통째로. ScaleTransform 안의 {Binding} 은 조용히 죽는다(Freezable 이라 DataContext 가 없다) - RegionScaleConverter 참고. -->
    <regions:RegionScaleConverter x:Key="Scale" />

    <!-- 자리 색 - 겹그림(DetectionOverlay)의 NamedColour · SelectedNamedColour 와 같다. -->
    <SolidColorBrush x:Key="RegionBrush"
                     Color="#FF78C8FF" />
    <SolidColorBrush x:Key="RegionLabelBrush"
                     Color="#D978C8FF" />
    <!-- 고른 자리는 마젠타(사용자, 2026-09-18 "좀 더 눈에 띄는 다른 색") - 게임 화면에 거의 안 나오는 색이라 여러 자리 사이에서 한눈에 갈린다. 주황은 게임 UI 와 섞였다. -->
    <SolidColorBrush x:Key="RegionSelectedBrush"
                     Color="#FFFF2BD6" />

    <!-- 칸 색 - 자리(하늘색·주황)와 한눈에 갈리게 초록. 겹그림(DetectionOverlay)의 칸 점선과 같다. -->
    <SolidColorBrush x:Key="RegionCellBrush"
                     Color="#FF4CD964" />
    <SolidColorBrush x:Key="RegionCellLabelBrush"
                     Color="#D92E9E4A" />
    <SolidColorBrush x:Key="RegionCellSelectedBrush"
                     Color="#FF2EE06A" />

    <!-- 고른 자리의 보이는 손잡이 - 라벨링 캔버스처럼 6px 네모. 잡는 것은 위 투명 Thumb 이다. -->
    <Style x:Key="RegionGrip"
           TargetType="{x:Type Rectangle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Fill" Value="{StaticResource RegionSelectedBrush}" />
        <Setter Property="Width" Value="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=6}" />
        <Setter Property="Height" Value="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=6}" />
    </Style>

    <ControlTemplate x:Key="RegionMoveThumbTemplate"
                     TargetType="{x:Type regions:RegionMoveThumb}">
        <Rectangle Fill="Transparent" />
    </ControlTemplate>

    <!--
        자리 하나. 안쪽 전체가 옮기기 손잡이고, 얇은 테두리와 이름표를 그린다.
        고르면 RegionItem 이 어도너 층에 RegionResizeAdorner(테두리·손잡이)를 얹는다.
    -->
    <Style TargetType="{x:Type regions:RegionItem}">
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type regions:RegionItem}">
                    <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                        <regions:RegionMoveThumb Cursor="SizeAll"
                                                 Template="{StaticResource RegionMoveThumbTemplate}" />
                        <!-- 선 가운데를 자리 경계에(굵기 절반만큼 넓힘) - 라벨링 캔버스와 같다. -->
                        <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=-0.75}"
                                   Stroke="{StaticResource RegionBrush}"
                                   StrokeThickness="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=1.5}"
                                   IsHitTestVisible="False" />
                        <!-- 이름표는 사각형 위에 - 라벨링 캔버스의 이름표와 같은 모양. 크기는 배율 역수로 되돌린다. -->
                        <Border Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,-18,0,0'}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{StaticResource RegionLabelBrush}"
                                IsHitTestVisible="False"
                                LayoutTransform="{Binding InverseZoom, Converter={StaticResource Scale}}">
                            <TextBlock Padding="3,1,3,1"
                                       Foreground="White"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Text="{Binding Region.Name}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 고른 자리의 테두리와 손잡이 여덟 개. 잡는 Thumb 은 투명(8px 폭), 보이는 것은 아래 그리드다. -->
    <Style TargetType="{x:Type regions:RegionResizeChrome}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type regions:RegionResizeChrome}">
                    <Grid>
                        <Grid Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=-4}"
                              Opacity="0">
                            <regions:RegionResizeThumb Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=8}"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Top"
                                                       Cursor="SizeNS" />
                            <regions:RegionResizeThumb Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=8}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Stretch"
                                                       Cursor="SizeWE" />
                            <regions:RegionResizeThumb Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=8}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Stretch"
                                                       Cursor="SizeWE" />
                            <regions:RegionResizeThumb Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=8}"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Bottom"
                                                       Cursor="SizeNS" />

                            <regions:RegionResizeThumb Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       Cursor="SizeNWSE" />
                            <regions:RegionResizeThumb Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Top"
                                                       Cursor="SizeNESW" />
                            <regions:RegionResizeThumb Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Bottom"
                                                       Cursor="SizeNESW" />
                            <regions:RegionResizeThumb Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       Cursor="SizeNWSE" />
                        </Grid>

                        <!-- 보이는 것 - 라벨링 캔버스의 고른 사각형과 같다. -->
                        <Grid IsHitTestVisible="False">
                            <!--
                                Rectangle 의 선은 안쪽으로만 그려진다 - 그대로 두면 선이 1.5px 안으로 들어가 손잡이 점이 선 바깥으로 삐져 보였다.
                                선 굵기 절반만큼 넓혀 선 가운데가 자리 경계에 오게 한다(라벨링 캔버스의 펜과 같다, 2026-09-15).
                            -->
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=-1.5}"
                                       Stroke="{StaticResource RegionSelectedBrush}"
                                       StrokeThickness="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=3}"
                                       SnapsToDevicePixels="True" />

                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='-3,-3,0,0'}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Style="{StaticResource RegionGrip}" />
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,-3,0,0'}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Style="{StaticResource RegionGrip}" />
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,-3,-3,0'}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Style="{StaticResource RegionGrip}" />
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='-3,0,0,0'}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource RegionGrip}" />
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,0,-3,0'}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource RegionGrip}" />
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='-3,0,0,-3'}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource RegionGrip}" />
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,0,0,-3'}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource RegionGrip}" />
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,0,-3,-3'}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource RegionGrip}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 고른 칸의 보이는 손잡이 - 자리 손잡이와 같은 6px 네모, 초록. -->
    <Style x:Key="RegionCellGrip"
           TargetType="{x:Type Rectangle}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Fill" Value="{StaticResource RegionCellSelectedBrush}" />
        <Setter Property="Width" Value="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=6}" />
        <Setter Property="Height" Value="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=6}" />
    </Style>

    <!--
        자리 안의 칸 하나(사용자, 2026-09-16 - 자리는 LayoutGroup, 칸은 그 안 항목). 안쪽 전체가 옮기기 손잡이고, 초록 점선과 칸 이름표를 그린다.
        이름표는 칸 안쪽 위에 둔다 - 자리 이름표가 자리 바깥 위에 있어 겹치지 않게. 항목이 돌면(RenderTransform) 같이 돈다.
        고르면 RegionCellItem 이 어도너 층에 RegionCellAdorner(초록 테두리·손잡이·회전 손잡이)를 얹는다.
    -->
    <Style TargetType="{x:Type regions:RegionCellItem}">
        <Setter Property="MinWidth" Value="2" />
        <Setter Property="MinHeight" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type regions:RegionCellItem}">
                    <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                        <regions:RegionMoveThumb Cursor="SizeAll"
                                                 Template="{StaticResource RegionMoveThumbTemplate}" />
                        <Rectangle Stroke="{StaticResource RegionCellBrush}"
                                   StrokeThickness="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=1}"
                                   IsHitTestVisible="False"
                                   StrokeDashArray="3 2" />
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{StaticResource RegionCellLabelBrush}"
                                IsHitTestVisible="False"
                                LayoutTransform="{Binding InverseZoom, Converter={StaticResource Scale}}">
                            <TextBlock Padding="2,0,2,0"
                                       Foreground="White"
                                       FontFamily="Segoe UI"
                                       FontSize="9"
                                       Text="{Binding Cell.Name}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        고른 칸의 테두리·손잡이 여덟 개·회전 손잡이. 자리 어도너(RegionResizeChrome)와 모양은 같고 색이 초록이다.
        회전 손잡이는 위 변 가운데에서 선을 올린 끝의 동그라미 - 참조 ResizeRotateChrome 의 RotateThumb 을 되살렸다(사용자 「대각선 사각」).
    -->
    <Style TargetType="{x:Type regions:RegionCellChrome}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type regions:RegionCellChrome}">
                    <Grid>
                        <Grid Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=-4}"
                              Opacity="0">
                            <regions:RegionResizeThumb Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=8}"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Top"
                                                       Cursor="SizeNS" />
                            <regions:RegionResizeThumb Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=8}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Stretch"
                                                       Cursor="SizeWE" />
                            <regions:RegionResizeThumb Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=8}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Stretch"
                                                       Cursor="SizeWE" />
                            <regions:RegionResizeThumb Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=8}"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Bottom"
                                                       Cursor="SizeNS" />
                            <regions:RegionResizeThumb Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       Cursor="SizeNWSE" />
                            <regions:RegionResizeThumb Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Top"
                                                       Cursor="SizeNESW" />
                            <regions:RegionResizeThumb Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Bottom"
                                                       Cursor="SizeNESW" />
                            <regions:RegionResizeThumb Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       Cursor="SizeNWSE" />
                            <!-- 회전 손잡이 - 보이는 동그라미(아래) 자리에 12px. 이 그리드가 4px 넓혀져 있어 여백이 그만큼 작다. -->
                            <regions:RegionRotateThumb Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=12}"
                                                       Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=12}"
                                                       Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,-20,0,0'}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       Cursor="Hand" />
                        </Grid>

                        <Grid IsHitTestVisible="False">
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=-1}"
                                       Stroke="{StaticResource RegionCellSelectedBrush}"
                                       StrokeThickness="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=2}"
                                       SnapsToDevicePixels="True" />

                            <!-- 회전 손잡이 줄기와 동그라미 -->
                            <Rectangle Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=1}"
                                       Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=14}"
                                       Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,-14,0,0'}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Fill="{StaticResource RegionCellSelectedBrush}" />
                            <Ellipse Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=8}"
                                     Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=8}"
                                     Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,-20,0,0'}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top"
                                     Fill="White"
                                     Stroke="{StaticResource RegionCellSelectedBrush}"
                                     StrokeThickness="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=2}" />

                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='-3,-3,0,0'}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Style="{StaticResource RegionCellGrip}" />
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,-3,0,0'}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Style="{StaticResource RegionCellGrip}" />
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,-3,-3,0'}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Style="{StaticResource RegionCellGrip}" />
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='-3,0,0,0'}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource RegionCellGrip}" />
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,0,-3,0'}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource RegionCellGrip}" />
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='-3,0,0,-3'}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource RegionCellGrip}" />
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,0,0,-3'}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource RegionCellGrip}" />
                            <Rectangle Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,0,-3,-3'}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource RegionCellGrip}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 크기를 바꾸는 동안의 치수 - 아래에 너비, 오른쪽에 높이(원본 픽셀). 글자·선도 배율 역수로 되돌린다. -->
    <Style TargetType="{x:Type regions:RegionSizeChrome}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type regions:RegionSizeChrome}">
                    <Grid SnapsToDevicePixels="True">
                        <Path Height="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                              Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='-2,0,-2,-15'}"
                              VerticalAlignment="Bottom"
                              Stroke="Red"
                              StrokeThickness="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=1}"
                              Data="M0,0 0,10 M 0,5 100,5 M 100,0 100,10"
                              Stretch="Fill" />
                        <TextBlock Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,0,0,-18'}"
                                   Padding="3,0,3,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Background="White"
                                   Foreground="Red"
                                   LayoutTransform="{Binding InverseZoom, Converter={StaticResource Scale}}"
                                   Text="{Binding Path=SourceWidthPx, Converter={StaticResource RegionRoundConverter}}" />
                        <Path Width="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=10}"
                              Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,-2,-15,-2'}"
                              HorizontalAlignment="Right"
                              Stroke="Red"
                              StrokeThickness="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter=1}"
                              Data="M5,0 5,100 M 0,0 10,0 M 0,100 10,100"
                              Stretch="Fill" />
                        <TextBlock Margin="{Binding InverseZoom, Converter={StaticResource Zoom}, ConverterParameter='0,0,-18,0'}"
                                   Padding="3,0,3,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Background="White"
                                   Foreground="Red"
                                   LayoutTransform="{Binding InverseZoom, Converter={StaticResource Scale}, ConverterParameter=90}"
                                   Text="{Binding Path=SourceHeightPx, Converter={StaticResource RegionRoundConverter}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
