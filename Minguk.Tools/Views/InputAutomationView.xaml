<UserControl x:Class="Minguk.Tools.Views.InputAutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:image="clr-namespace:Minguk.Image;assembly=Minguk.Image"
             xmlns:markup="clr-namespace:Minguk.Tools.Markup"
             xmlns:sequencing="clr-namespace:Minguk.Tools.Input.Sequencing"
             xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
             Style="{DynamicResource BaseControlStyle}"
             FontFamily="{DynamicResource BaseFontFamily}"
             FontSize="{DynamicResource BaseFontSize}"
             DataContext="{dxmvvm:ViewModelSource Type={x:Type viewModels:InputAutomationViewModel}}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type viewModels:InputAutomationViewModel},
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="620"
             d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  고른 단계가 쓰지 않는 칸은 아예 접는다. IsEnabled 로 흐리게만 두면 자리를 계속 차지한다.  -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Command="{Binding OnInitializedCommand}"
                               EventName="Loaded" />

        <!--
            ViewModel 이 UI 스레드로 일을 넘길 때 쓴다 - 스크립트를 다시 읽는 것,
            테마가 바뀌어 편집기 색을 다시 재는 것. 없으면 부모 것에 기대게 되는데,
            이 화면만 따로 띄우거나 부모가 바뀌면 조용히 안 돌게 된다.
        -->
        <dxmvvm:DispatcherService />

        <!--  드라이버 설치 뒤 "재시작이 필요합니다" 를 띄운다. 없으면 조용히 안 뜬다.  -->
        <dx:DXMessageBoxService />

        <!--  스크립트를 파일로 열고 저장한다.  -->
        <dxmvvm:OpenFileDialogService />
        <dxmvvm:SaveFileDialogService />
    </dxmvvm:Interaction.Behaviors>

    <!--
        AllowItemSizing="False" 로 사용자가 런타임에 칸 크기를 바꾸지 못하게 막는다.
        (WinForms 의 AllowCustomization 에 해당하는 것은 WPF 에 없다.
         드래그로 항목을 재배치하는 customization 모드는 IsCustomization 이 기본 False 라
         코드에서 켜지 않는 한 애초에 들어갈 수 없다.)
    -->
    <dxlc:LayoutControl Padding="8"
                        AllowItemSizing="False"
                        Orientation="Vertical"
                        ScrollBars="Auto">

        <!--  도는 동안에는 설정을 잠근다. 중간에 바뀌면 엉뚱한 것이 나간다.  -->
        <dxlc:LayoutGroup Header="보내는 경로"
                          VerticalAlignment="Top"
                          IsEnabled="{Binding IsIdle}"
                          Orientation="Horizontal"
                          View="GroupBox">
            <!--
                EditValue 가 아니라 SelectedItem 으로 묶는다.
                EditValue 로 두면 콤보에 고른 것이 보이는데 ViewModel 은 그대로여서,
                화면은 PostMessage 라고 하면서 실제로는 SendInput 으로 나가는 일이 있었다.
                ItemsSource 가 있는 콤보에서 "어느 항목인가" 를 그대로 말하는 것은 SelectedItem 이다.
            -->
            <dxlc:LayoutItem Label="입력 경로">
                <dxe:ComboBoxEdit IsTextEditable="False"
                                  ItemsSource="{Binding InputBackends}"
                                  SelectedItem="{Binding SelectedInputBackend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="상태">
                <dxe:TextEdit EditValue="{Binding AdapterStatus}"
                              IsReadOnly="True" />
            </dxlc:LayoutItem>

            <!--
                Interception 은 커널 드라이버가 있어야 돈다. 없거나 재부팅이 안 됐을 때만 뜬다.
                "쓸 수 없다" 로 끝내면 사용자가 무엇을 해야 할지 모른다.
            -->
            <dxlc:LayoutItem Label="드라이버"
                             Visibility="{Binding HasDriverNotice, Converter={StaticResource BoolToVisibility}}">
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <dxe:TextEdit AcceptsReturn="True"
                                  EditValue="{Binding DriverNotice}"
                                  Foreground="#BF6A02"
                                  IsReadOnly="True"
                                  TextWrapping="Wrap"
                                  VerticalContentAlignment="Top" />

                    <dx:SimpleButton Width="120"
                                     Command="{Binding DoInstallDriverCommand}"
                                     Content="드라이버 설치"
                                     ToolTip="관리자 권한을 물어봅니다. 설치 뒤 Windows 를 다시 시작해야 합니다."
                                     Visibility="{Binding CanInstallDriver, Converter={StaticResource BoolToVisibility}}" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>

        <!--
            대상 창은 PostMessage 경로에서만 쓴다. 그 경로는 진짜 커서를 안 움직이므로
            "포커스를 가진 창" 에 기댈 수 없고, 어느 창에 넣을지 정해 줘야 한다.
            다른 경로에서는 줄을 아예 접는다 - 안 쓰는 칸이 늘 떠 있으면 뭘 채워야 하는지 흐려진다.
        -->
        <dxlc:LayoutGroup Header="대상 창"
                          VerticalAlignment="Top"
                          IsEnabled="{Binding IsIdle}"
                          Orientation="Horizontal"
                          View="GroupBox"
                          Visibility="{Binding NeedsWindowTarget, Converter={StaticResource BoolToVisibility}}">

            <dxlc:LayoutItem Label="창">
                <dxe:ComboBoxEdit DisplayMember="Display"
                                  IsTextEditable="False"
                                  ItemsSource="{Binding WindowTargets}"
                                  NullText="고르지 않으면 마지막 좌표 아래의 창으로 나간다"
                                  SelectedItem="{Binding SelectedWindowTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </dxlc:LayoutItem>

            <dx:SimpleButton Width="90"
                             Command="{Binding DoRefreshWindowsCommand}"
                             Content="새로고침"
                             ToolTip="지금 떠 있는 창을 다시 훑는다. 고르고 있던 창이 그대로면 선택은 지킨다." />
        </dxlc:LayoutGroup>

        <!--
            단계를 데이터로 들고 편집한다.
            예전에는 체크박스로 켜고 껐는데, 그러면 순서가 코드에 박혀서(글자 → 클릭 → 이동 → 휠)
            "이동한 다음 클릭" 같은 흔한 것도 짤 수 없었다.
        -->
        <dxlc:LayoutGroup Header="보낼 것"
                          VerticalAlignment="Top"
                          IsEnabled="{Binding IsIdle}"
                          Orientation="Vertical"
                          View="GroupBox">

            <dxlc:LayoutGroup HorizontalAlignment="Left"
                              Orientation="Horizontal"
                              VerticalAlignment="Top">
                <dxlc:LayoutItem Label="언어">
                    <dxe:ComboBoxEdit Width="140"
                                      IsTextEditable="False"
                                      ItemsSource="{Binding ScriptLanguages}"
                                      SelectedItem="{Binding SelectedScriptLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </dxlc:LayoutItem>

                <!--  파이썬은 처음 고를 때 11MB 를 받아 온다. 멈춘 것처럼 보이지 않게 적는다.  -->
                <dxlc:LayoutItem Width="330"
                                 Label="엔진">
                    <dxe:TextEdit EditValue="{Binding EngineStatus}"
                                  IsReadOnly="True"
                                  NullText="준비됨" />
                </dxlc:LayoutItem>

                <!--
                    파일 이름. 파일과 지금 글이 다르면 * 가 붙는다.
                    저장하지 않아도 글은 설정에 남으므로 "잃어버린다" 는 경고는 아니다.
                -->
                <dxlc:LayoutItem Width="230"
                                 Label="파일">
                    <dxe:TextEdit EditValue="{Binding ScriptFileLabel, Mode=OneWay}"
                                  IsReadOnly="True" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup HorizontalAlignment="Left"
                              Orientation="Horizontal"
                              VerticalAlignment="Top">
                <dx:SimpleButton Width="80"
                                 Command="{Binding DoNewScriptCommand}"
                                 Content="새로"
                                 ToolTip="본보기 글로 새로 시작한다. 파일과의 연결도 끊는다." />
                <dx:SimpleButton Width="80"
                                 Command="{Binding DoOpenScriptCommand}"
                                 Content="열기"
                                 ToolTip="확장자를 보고 언어까지 맞춘다 (.csx · .py · .js)" />
                <dx:SimpleButton Width="80"
                                 Command="{Binding DoSaveScriptCommand}"
                                 Content="저장" />
                <dx:SimpleButton Width="110"
                                 Command="{Binding DoSaveScriptAsCommand}"
                                 Content="다른 이름으로" />
            </dxlc:LayoutGroup>

            <!--  본보기 줄을 캐럿이 있는 줄 아래에 끼운다. 형식을 외우지 않아도 되게.  -->
            <dxlc:LayoutGroup HorizontalAlignment="Left"
                              Orientation="Horizontal"
                              VerticalAlignment="Top">
                <dx:SimpleButton Width="72"
                                 Command="{Binding DoAddStepCommand}"
                                 CommandParameter="{x:Static sequencing:SequenceStepKind.Type}"
                                 Content="글자" />
                <dx:SimpleButton Width="72"
                                 Command="{Binding DoAddStepCommand}"
                                 CommandParameter="{x:Static sequencing:SequenceStepKind.Enter}"
                                 Content="Enter" />
                <dx:SimpleButton Width="72"
                                 Command="{Binding DoAddStepCommand}"
                                 CommandParameter="{x:Static sequencing:SequenceStepKind.ToggleHangul}"
                                 Content="한/영" />
                <dx:SimpleButton Width="72"
                                 Command="{Binding DoAddStepCommand}"
                                 CommandParameter="{x:Static sequencing:SequenceStepKind.Click}"
                                 Content="클릭" />
                <dx:SimpleButton Width="72"
                                 Command="{Binding DoAddStepCommand}"
                                 CommandParameter="{x:Static sequencing:SequenceStepKind.MoveTo}"
                                 Content="이동" />
                <dx:SimpleButton Width="72"
                                 Command="{Binding DoAddStepCommand}"
                                 CommandParameter="{x:Static sequencing:SequenceStepKind.Scroll}"
                                 Content="휠" />
                <dx:SimpleButton Width="72"
                                 Command="{Binding DoAddStepCommand}"
                                 CommandParameter="{x:Static sequencing:SequenceStepKind.Wait}"
                                 Content="쉬기" />

                <dx:SimpleButton Width="80"
                                 Command="{Binding DoResetStepsCommand}"
                                 Content="처음으로"
                                 ToolTip="적은 것을 모두 버리고 기본 스크립트로 되돌린다." />
            </dxlc:LayoutGroup>

            <!--
                AvalonEdit. WPF 용이라 AvaloniaEdit 이 아니다.
                TextEditor 를 바로 쓰지 않고 markup:ScriptEditor 로 감싼 이유는 그쪽에 적어 두었다
                (그냥 얹으면 창 전체의 UI 자동화 트리가 빈다).
                Text 가 의존 속성이 아니어서 markup:AvalonEditText.Text 로 양방향을 잇는다.

                DevExpress 경량 테마는 표준 WPF 컨트롤을 손대지 않으므로 색을 직접 준다 -
                안 그러면 어두운 테마에서 이 편집기만 흰 판으로 남는다.
            -->
            <Border BorderBrush="{Binding EditorBorder}"
                    BorderThickness="1">
                <markup:ScriptEditor Height="200"
                                       Background="{Binding EditorBackground}"
                                       FontFamily="D2Coding, Consolas, Courier New"
                                       FontSize="13"
                                       Foreground="{Binding EditorForeground}"
                                       LineNumbersForeground="{Binding EditorLineNumberForeground}"
                                       ShowLineNumbers="True"
                                       SyntaxHighlighting="{Binding Highlighting}"
                                       WordWrap="False"
                                       markup:AvalonEditText.Text="{Binding ScriptText, Mode=TwoWay}">
                    <dxmvvm:Interaction.Behaviors>
                        <!--  ViewModel 이 캐럿 자리에 줄을 끼우려면 편집기를 직접 잡아야 한다.  -->
                        <dxmvvm:UIObjectService x:Name="EditorObjectService" />
                    </dxmvvm:Interaction.Behaviors>
                </markup:ScriptEditor>
            </Border>

            <!--  틀린 줄이 있을 때만 뜬다. 늘 자리를 차지하면 멀쩡할 때도 눈이 간다.  -->
            <!--  여러 줄이 될 수 있다. 한 줄에 이어 붙이면 뒤가 잘려서 정작 중요한 말이 안 보인다.  -->
            <dxlc:LayoutItem Label="고칠 줄"
                             Visibility="{Binding HasScriptError, Converter={StaticResource BoolToVisibility}}">
                <dxe:TextEdit AcceptsReturn="True"
                              EditValue="{Binding ScriptError}"
                              Foreground="#D1242F"
                              IsReadOnly="True"
                              TextWrapping="Wrap"
                              VerticalContentAlignment="Top" />
            </dxlc:LayoutItem>

            <!--
                고른 경로가 못 보내는 단계가 있을 때만 뜬다.
                이것이 없으면 PostMessage 를 골라 둔 사람은 순서가 비고 실행해도 아무 일이
                없는 이유를 알 수 없다. 틀린 것이 아니라 경로의 성질이라 색을 달리한다.
            -->
            <dxlc:LayoutItem Label="이 경로에서는"
                             Visibility="{Binding HasPathWarning, Converter={StaticResource BoolToVisibility}}">
                <dxe:TextEdit AcceptsReturn="True"
                              EditValue="{Binding PathWarning}"
                              Foreground="#BF6A02"
                              IsReadOnly="True"
                              TextWrapping="Wrap"
                              VerticalContentAlignment="Top" />
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>

        <dxlc:LayoutGroup Header="타이밍"
                          VerticalAlignment="Top"
                          IsEnabled="{Binding IsIdle}"
                          Orientation="Horizontal"
                          View="GroupBox">

            <dxlc:LayoutItem Label="누름 유지(ms)">
                <dxe:SpinEdit EditValue="{Binding HoldTimeMs}"
                              MaxValue="2000"
                              MinValue="1" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="단계 간격(ms)">
                <dxe:SpinEdit EditValue="{Binding IntervalMs}"
                              MaxValue="10000"
                              MinValue="1" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="편차(±ms)"
                             ToolTip="0 이면 늘 같은 간격으로 돈다. 값을 주면 매번 달라진다.">
                <dxe:SpinEdit EditValue="{Binding JitterMs}"
                              MaxValue="1000"
                              MinValue="0" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="시작 전 대기(초)"
                             ToolTip="이 사이에 대상 창을 앞으로 가져와야 한다. 안 그러면 이 앱으로 입력이 들어온다.">
                <dxe:SpinEdit EditValue="{Binding StartDelaySeconds}"
                              MaxValue="60"
                              MinValue="0" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="반복 횟수"
                             ToolTip="0 이면 중지할 때까지 돈다.">
                <dxe:SpinEdit EditValue="{Binding MaxLoops}"
                              MaxValue="100000"
                              MinValue="0" />
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>

        <dxlc:LayoutGroup Header="실행"
                          VerticalAlignment="Top"
                          Orientation="Vertical"
                          View="GroupBox">

            <dxlc:LayoutItem Label="단축키"
                             ToolTip="다른 창이 앞에 있을 때도 눌린다. 대상 창을 앞으로 가져온 뒤 F5/F6 을 누르면 된다. F4 는 커서 자리를 이동 단계로 담고, F3 은 커서 아래 창을 대상으로 집는다.">
                <dxe:TextEdit EditValue="{Binding HotkeyStatus}"
                              IsReadOnly="True" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="순서">
                <dxe:TextEdit EditValue="{Binding SequenceText}"
                              IsReadOnly="True" />
            </dxlc:LayoutItem>

            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Top">
                <dxlc:LayoutItem Label="진행">
                    <dxe:TextEdit EditValue="{Binding CurrentStep}"
                                  IsReadOnly="True" />
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="돈 횟수">
                    <dxe:TextEdit EditValue="{Binding LoopCount}"
                                  IsReadOnly="True" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup HorizontalAlignment="Left"
                              Orientation="Horizontal"
                              VerticalAlignment="Top">
                <dx:SimpleButton Width="120"
                                 Height="28"
                                 Command="{Binding DoRunOnceCommand}"
                                 Content="1회 실행"
                                 Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/action_play.png'}"
                                 GlyphHeight="16"
                                 GlyphWidth="16" />

                <dx:SimpleButton Width="120"
                                 Height="28"
                                 Command="{Binding DoStartLoopCommand}"
                                 Content="반복 시작"
                                 Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/action_play_forward.png'}"
                                 GlyphHeight="16"
                                 GlyphWidth="16" />

                <dx:SimpleButton Width="120"
                                 Height="28"
                                 Command="{Binding DoStopCommand}"
                                 Content="중지"
                                 Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/action_stop.png'}"
                                 GlyphHeight="16"
                                 GlyphWidth="16" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>

        <!--
            시험 입력란. 남는 자리를 채우므로 VerticalAlignment 를 Top 으로 두지 않는다.

            도는 동안에도 잠그지 않는다 - 잠그면 입력을 받을 수 없어 있으나 마나다.
            이 앱이 앞에 있고 여기에 포커스가 있으면 보낸 입력이 여기로 온다.
        -->
        <dxlc:LayoutGroup Header="시험 입력란"
                          Orientation="Vertical"
                          View="GroupBox">

            <dxlc:LayoutGroup HorizontalAlignment="Left"
                              Orientation="Horizontal"
                              VerticalAlignment="Top">
                <dx:SimpleButton Width="80"
                                 Command="{Binding DoClearTestPadCommand}"
                                 Content="지우기" />
                <!--  테마 색을 그대로 물려받고 흐리게만 한다. 테마 키를 짚으면 버전마다 이름이 달라진다.  -->
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.65"
                           Text="시작 전 대기 동안 이 칸을 눌러 두면 된다." />
            </dxlc:LayoutGroup>

            <!--
                MemoEdit 이 아니라 TextEdit 이다. WPF 의 MemoEdit 은 PopupBaseEdit 상속이라
                한 줄 상자에 드롭다운이 달린 모양으로 뜬다 - 여기서 필요한 것은 늘 펼쳐진 판이다.
                TextEdit 이 AcceptsReturn·TextWrapping·스크롤을 그대로 갖고 있다.
            -->
            <dxe:TextEdit AcceptsReturn="True"
                          FontFamily="D2Coding, Consolas, Courier New"
                          MinHeight="140"
                          NullText="여기로 입력이 들어온다"
                          Text="{Binding TestPadText, UpdateSourceTrigger=PropertyChanged}"
                          TextWrapping="Wrap"
                          VerticalContentAlignment="Top"
                          VerticalScrollBarVisibility="Auto" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>
