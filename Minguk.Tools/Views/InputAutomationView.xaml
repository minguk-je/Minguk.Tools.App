<UserControl x:Class="Minguk.Tools.Views.InputAutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:controls="clr-namespace:Minguk.Base.Controls;assembly=Minguk.Base"
             xmlns:image="clr-namespace:Minguk.Image;assembly=Minguk.Image"
             xmlns:sequencing="clr-namespace:Minguk.Tools.Input.Sequencing"
             xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
             Style="{DynamicResource BaseControlStyle}"
             FontFamily="{DynamicResource BaseFontFamily}"
             FontSize="{DynamicResource BaseFontSize}"
             DataContext="{dxmvvm:ViewModelSource Type={x:Type viewModels:InputAutomationViewModel}}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type viewModels:InputAutomationViewModel},
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="620"
             d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  고른 단계가 쓰지 않는 칸은 아예 접는다. IsEnabled 로 흐리게만 두면 자리를 계속 차지한다.  -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Command="{Binding OnInitializedCommand}"
                               EventName="Loaded" />
    </dxmvvm:Interaction.Behaviors>

    <!--
        AllowItemSizing="False" 로 사용자가 런타임에 칸 크기를 바꾸지 못하게 막는다.
        (WinForms 의 AllowCustomization 에 해당하는 것은 WPF 에 없다.
         드래그로 항목을 재배치하는 customization 모드는 IsCustomization 이 기본 False 라
         코드에서 켜지 않는 한 애초에 들어갈 수 없다.)
    -->
    <dxlc:LayoutControl Padding="8"
                        AllowItemSizing="False"
                        Orientation="Vertical"
                        ScrollBars="Auto">

        <!--  도는 동안에는 설정을 잠근다. 중간에 바뀌면 엉뚱한 것이 나간다.  -->
        <dxlc:LayoutGroup Header="보내는 경로"
                          VerticalAlignment="Top"
                          IsEnabled="{Binding IsIdle}"
                          Orientation="Horizontal"
                          View="GroupBox">
            <dxlc:LayoutItem Label="입력 경로">
                <dxe:ComboBoxEdit EditValue="{Binding SelectedInputBackend}"
                                  IsTextEditable="False"
                                  ItemsSource="{Binding InputBackends}" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="상태">
                <dxe:TextEdit EditValue="{Binding AdapterStatus}"
                              IsReadOnly="True" />
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>

        <!--
            단계를 데이터로 들고 편집한다.
            예전에는 체크박스로 켜고 껐는데, 그러면 순서가 코드에 박혀서(글자 → 클릭 → 이동 → 휠)
            "이동한 다음 클릭" 같은 흔한 것도 짤 수 없었다.
        -->
        <dxlc:LayoutGroup Header="보낼 것"
                          VerticalAlignment="Top"
                          IsEnabled="{Binding IsIdle}"
                          Orientation="Vertical"
                          View="GroupBox">

            <!--  담기. 고른 줄 바로 아래에 들어간다.  -->
            <dxlc:LayoutGroup HorizontalAlignment="Left"
                              Orientation="Horizontal"
                              VerticalAlignment="Top">
                <dx:SimpleButton Width="72"
                                 Command="{Binding DoAddStepCommand}"
                                 CommandParameter="{x:Static sequencing:SequenceStepKind.Type}"
                                 Content="글자" />
                <dx:SimpleButton Width="72"
                                 Command="{Binding DoAddStepCommand}"
                                 CommandParameter="{x:Static sequencing:SequenceStepKind.Enter}"
                                 Content="Enter" />
                <dx:SimpleButton Width="72"
                                 Command="{Binding DoAddStepCommand}"
                                 CommandParameter="{x:Static sequencing:SequenceStepKind.ToggleHangul}"
                                 Content="한/영" />
                <dx:SimpleButton Width="72"
                                 Command="{Binding DoAddStepCommand}"
                                 CommandParameter="{x:Static sequencing:SequenceStepKind.Click}"
                                 Content="클릭" />
                <dx:SimpleButton Width="72"
                                 Command="{Binding DoAddStepCommand}"
                                 CommandParameter="{x:Static sequencing:SequenceStepKind.MoveTo}"
                                 Content="이동" />
                <dx:SimpleButton Width="72"
                                 Command="{Binding DoAddStepCommand}"
                                 CommandParameter="{x:Static sequencing:SequenceStepKind.Scroll}"
                                 Content="휠" />
                <dx:SimpleButton Width="72"
                                 Command="{Binding DoAddStepCommand}"
                                 CommandParameter="{x:Static sequencing:SequenceStepKind.Wait}"
                                 Content="쉬기" />
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Top">

                <!--
                    그리드에서는 고르기만 한다. 값은 아래 "고른 단계" 에서 고친다 -
                    종류마다 쓰는 칸이 달라서 열로 펼치면 늘 대부분이 비어 있게 된다.
                -->
                <controls:BaseGridControl Height="170"
                                          AutoGenerateColumns="None"
                                          ItemsSource="{Binding Steps}"
                                          SelectedItem="{Binding SelectedStep, Mode=TwoWay}">
                    <dxg:GridControl.View>
                        <!--  두 줄짜리 목록에 검색·그룹 패널은 자리만 먹는다.  -->
                        <controls:BaseTableView AllowEditing="False"
                                                NavigationStyle="Row"
                                                ShowGroupPanel="False"
                                                ShowSearchPanelMode="Never" />
                    </dxg:GridControl.View>

                    <dxg:GridColumn Width="90"
                                    AllowSorting="False"
                                    FieldName="KindName"
                                    Header="종류" />
                    <dxg:GridColumn AllowSorting="False"
                                    FieldName="Summary"
                                    Header="내용" />
                </controls:BaseGridControl>

                <dxlc:LayoutGroup HorizontalAlignment="Left"
                                  Orientation="Vertical"
                                  VerticalAlignment="Top">
                    <dx:SimpleButton Width="72"
                                     Command="{Binding DoMoveStepUpCommand}"
                                     Content="위로" />
                    <dx:SimpleButton Width="72"
                                     Command="{Binding DoMoveStepDownCommand}"
                                     Content="아래로" />
                    <dx:SimpleButton Width="72"
                                     Command="{Binding DoDuplicateStepCommand}"
                                     Content="복제" />
                    <dx:SimpleButton Width="72"
                                     Command="{Binding DoRemoveStepCommand}"
                                     Content="삭제" />
                    <dx:SimpleButton Width="72"
                                     Command="{Binding DoResetStepsCommand}"
                                     Content="처음으로"
                                     ToolTip="담은 것을 모두 버리고 기본 시퀀스로 되돌린다." />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup Header="고른 단계"
                              HorizontalAlignment="Left"
                              Orientation="Horizontal"
                              VerticalAlignment="Top"
                              View="GroupBox"
                              Visibility="{Binding HasSelectedStep, Converter={StaticResource BoolToVisibility}}">

                <dxlc:LayoutItem Label="종류">
                    <dxe:ComboBoxEdit Width="110"
                                      DisplayMember="Name"
                                      EditValue="{Binding SelectedStep.Kind, UpdateSourceTrigger=PropertyChanged}"
                                      IsTextEditable="False"
                                      ItemsSource="{Binding StepKinds}"
                                      ValueMember="Value" />
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Width="260"
                                 Label="글자"
                                 Visibility="{Binding IsTypeStep, Converter={StaticResource BoolToVisibility}}">
                    <dxe:TextEdit EditValue="{Binding SelectedStep.Text, UpdateSourceTrigger=PropertyChanged}"
                                  NullText="한글·영문·숫자·문장부호" />
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Width="130"
                                 Label="버튼"
                                 Visibility="{Binding IsClickStep, Converter={StaticResource BoolToVisibility}}">
                    <dxe:ComboBoxEdit DisplayMember="Name"
                                      EditValue="{Binding SelectedStep.Button, UpdateSourceTrigger=PropertyChanged}"
                                      IsTextEditable="False"
                                      ItemsSource="{Binding MouseButtons}"
                                      ValueMember="Value" />
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Width="110"
                                 Label="X"
                                 Visibility="{Binding IsMoveStep, Converter={StaticResource BoolToVisibility}}">
                    <dxe:SpinEdit EditValue="{Binding SelectedStep.X, UpdateSourceTrigger=PropertyChanged}" />
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Width="110"
                                 Label="Y"
                                 Visibility="{Binding IsMoveStep, Converter={StaticResource BoolToVisibility}}">
                    <dxe:SpinEdit EditValue="{Binding SelectedStep.Y, UpdateSourceTrigger=PropertyChanged}" />
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Width="130"
                                 Label="칸 수"
                                 ToolTip="양수가 위, 음수가 아래."
                                 Visibility="{Binding IsScrollStep, Converter={StaticResource BoolToVisibility}}">
                    <dxe:SpinEdit EditValue="{Binding SelectedStep.Notches, UpdateSourceTrigger=PropertyChanged}"
                                  MaxValue="10"
                                  MinValue="-10" />
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Width="130"
                                 Label="쉬는 시간(ms)"
                                 Visibility="{Binding IsWaitStep, Converter={StaticResource BoolToVisibility}}">
                    <dxe:SpinEdit EditValue="{Binding SelectedStep.DelayMs, UpdateSourceTrigger=PropertyChanged}"
                                  MaxValue="600000"
                                  MinValue="0" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>

        <dxlc:LayoutGroup Header="타이밍"
                          VerticalAlignment="Top"
                          IsEnabled="{Binding IsIdle}"
                          Orientation="Horizontal"
                          View="GroupBox">

            <dxlc:LayoutItem Label="누름 유지(ms)">
                <dxe:SpinEdit EditValue="{Binding HoldTimeMs}"
                              MaxValue="2000"
                              MinValue="1" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="단계 간격(ms)">
                <dxe:SpinEdit EditValue="{Binding IntervalMs}"
                              MaxValue="10000"
                              MinValue="1" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="편차(±ms)"
                             ToolTip="0 이면 늘 같은 간격으로 돈다. 값을 주면 매번 달라진다.">
                <dxe:SpinEdit EditValue="{Binding JitterMs}"
                              MaxValue="1000"
                              MinValue="0" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="시작 전 대기(초)"
                             ToolTip="이 사이에 대상 창을 앞으로 가져와야 한다. 안 그러면 이 앱으로 입력이 들어온다.">
                <dxe:SpinEdit EditValue="{Binding StartDelaySeconds}"
                              MaxValue="60"
                              MinValue="0" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="반복 횟수"
                             ToolTip="0 이면 중지할 때까지 돈다.">
                <dxe:SpinEdit EditValue="{Binding MaxLoops}"
                              MaxValue="100000"
                              MinValue="0" />
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>

        <dxlc:LayoutGroup Header="실행"
                          VerticalAlignment="Top"
                          Orientation="Vertical"
                          View="GroupBox">

            <dxlc:LayoutItem Label="단축키"
                             ToolTip="다른 창이 앞에 있을 때도 눌린다. 대상 창을 앞으로 가져온 뒤 Ctrl+Alt+F5/F6 을 누르면 된다. Ctrl+Alt+F4 는 커서 자리를 고른 이동 단계에 담는다.">
                <dxe:TextEdit EditValue="{Binding HotkeyStatus}"
                              IsReadOnly="True" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="순서">
                <dxe:TextEdit EditValue="{Binding SequenceText}"
                              IsReadOnly="True" />
            </dxlc:LayoutItem>

            <dxlc:LayoutGroup Orientation="Horizontal"
                              VerticalAlignment="Top">
                <dxlc:LayoutItem Label="진행">
                    <dxe:TextEdit EditValue="{Binding CurrentStep}"
                                  IsReadOnly="True" />
                </dxlc:LayoutItem>

                <dxlc:LayoutItem Label="돈 횟수">
                    <dxe:TextEdit EditValue="{Binding LoopCount}"
                                  IsReadOnly="True" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup HorizontalAlignment="Left"
                              Orientation="Horizontal"
                              VerticalAlignment="Top">
                <dx:SimpleButton Width="120"
                                 Height="28"
                                 Command="{Binding DoRunOnceCommand}"
                                 Content="1회 실행"
                                 Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/action_play.png'}"
                                 GlyphHeight="16"
                                 GlyphWidth="16" />

                <dx:SimpleButton Width="120"
                                 Height="28"
                                 Command="{Binding DoStartLoopCommand}"
                                 Content="반복 시작"
                                 Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/action_play_forward.png'}"
                                 GlyphHeight="16"
                                 GlyphWidth="16" />

                <dx:SimpleButton Width="120"
                                 Height="28"
                                 Command="{Binding DoStopCommand}"
                                 Content="중지"
                                 Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/action_stop.png'}"
                                 GlyphHeight="16"
                                 GlyphWidth="16" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>
