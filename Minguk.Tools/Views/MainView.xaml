<UserControl x:Class="Minguk.Tools.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
             xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
             Style="{DynamicResource BaseControlStyle}"
             DataContext="{dxmvvm:ViewModelSource Type={x:Type viewModels:MainViewModel}}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type viewModels:MainViewModel},
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/ControlTemplate.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/DataTemplate.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/GridColumnStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <!-- 창 위치와 도킹 레이아웃 직렬화. 이 두 개가 있어야 탭 배치가 재시작 후에도 남는다. -->
        <dxmvvm:CurrentWindowSerializationBehavior />
        <dxmvvm:LayoutSerializationService />
        <dxmvvm:CurrentWindowService ClosingCommand="{Binding OnClosingCommand}" />
        <dxmvvm:DispatcherService />
        <dxmvvm:EventToCommand Command="{Binding OnInitializedCommand}"
                               EventName="Initialized" />
    </dxmvvm:Interaction.Behaviors>

    <DockPanel LastChildFill="True">

        <!-- ── 상태바 ─────────────────────────────────────────────────── -->
        <dxr:RibbonStatusBarControl DockPanel.Dock="Bottom"
                                    Visibility="Visible">
            <dxr:RibbonStatusBarControl.LeftItems>
                <dxb:BarStaticItem AutoSizeMode="Fill"
                                   Content="{Binding MainMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </dxr:RibbonStatusBarControl.LeftItems>
            <dxr:RibbonStatusBarControl.RightItems>
                <dxb:BarStaticItem AutoSizeMode="Content"
                                   Content="{Binding SubMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </dxr:RibbonStatusBarControl.RightItems>
        </dxr:RibbonStatusBarControl>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 0: 네비게이션 / 1: 스플리터 / 2: 문서 영역 -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <dxmvvm:Interaction.Behaviors>
                <!-- UIObjectService 로 ViewModel 이 컨트롤 자체를 잡는다.
                     메뉴 접기/전체화면처럼 "레이아웃을 직접 건드려야 하는" 동작 때문이다. -->
                <dxmvvm:UIObjectService x:Name="DockPanelGridObjectService" />
            </dxmvvm:Interaction.Behaviors>

            <!-- ── 네비게이션 ─────────────────────────────────────────── -->
            <dxdo:LayoutGroup Grid.Column="0"
                              Margin="0"
                              Padding="0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              AllowSplitters="False"
                              DockItemInterval="1"
                              ItemWidth="Auto"
                              LayoutGroupInterval="0"
                              LayoutItemInterval="0"
                              Orientation="Vertical">

                <dxmvvm:Interaction.Behaviors>
                    <dxmvvm:UIObjectService x:Name="LayoutGroupObjectService" />
                </dxmvvm:Interaction.Behaviors>

                <dxdo:LayoutPanel HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Caption="Navigation"
                                  ItemHeight="*"
                                  ShowCaption="False"
                                  ShowCloseButton="False"
                                  ShowPinButton="False">

                    <dxa:AccordionControl x:Name="Accordion"
                                          HorizontalAlignment="Stretch"
                                          Style="{DynamicResource BaseControlStyle}"
                                          FontFamily="{DynamicResource BaseFontFamily}"
                                          FontSize="{DynamicResource BaseFontSize}"
                                          AutoExpandAllItems="False"
                                          ChildrenPath="Children"
                                          CollapsedItemClickAction="Select"
                                          ExpandItemOnHeaderClick="True"
                                          IsCollapseButtonVisible="False"
                                          IsExpanded="True"
                                          ItemsSource="{Binding AccordionControlMenuItemSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          SearchControlFilterCondition="Like"
                                          SearchControlNullText="검색"
                                          SelectionMode="Single"
                                          SelectionUnit="SubItemOrRootItem"
                                          ShowSearchControl="True"
                                          SummaryItemGlyph="{dx:DXImage 'SvgImages/Setup/Properties.svg'}"
                                          SummaryItemGlyphSize="16,16"
                                          SummaryItemHeader="ALL"
                                          ViewMode="Accordion">

                        <dxmvvm:Interaction.Behaviors>
                            <dxmvvm:UIObjectService x:Name="AccordionControlObjectService" />
                            <dxmvvm:EventToCommand Command="{Binding OnMouseDoubleClickCommand}"
                                                   EventName="MouseDoubleClick"
                                                   PassEventArgsToCommand="True" />
                            <dxmvvm:EventToCommand Command="{Binding OnPreviewKeyDownCommand}"
                                                   EventName="PreviewKeyDown"
                                                   PassEventArgsToCommand="True" />
                            <dxmvvm:EventToCommand Command="{Binding OnAccordionSelectedItemChangedCommand}"
                                                   EventName="SelectedItemChanged"
                                                   PassEventArgsToCommand="True" />
                        </dxmvvm:Interaction.Behaviors>

                        <dxa:AccordionControl.ItemContainerStyle>
                            <Style TargetType="dxa:AccordionItem">
                                <Setter Property="Header" Value="{Binding MENU_NM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Setter Property="Glyph" Value="{Binding Icon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Setter Property="GlyphSize" Value="16,16" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                                <Setter Property="UseLayoutRounding" Value="True" />
                                <Setter Property="FontFamily" Value="{DynamicResource BaseFontFamily}" />
                                <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
                                <Setter Property="ShowInCollapsedMode" Value="{Binding ShowInCollapsedMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Setter Property="CanSelect" Value="{Binding CanSelect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Style.Triggers>
                                    <!-- 현재 활성 문서에 해당하는 메뉴를 굵게 -->
                                    <DataTrigger Binding="{Binding IS_ACTIVE}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IS_ACTIVE}" Value="False">
                                        <Setter Property="FontWeight" Value="Normal" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxa:AccordionControl.ItemContainerStyle>
                    </dxa:AccordionControl>
                </dxdo:LayoutPanel>
            </dxdo:LayoutGroup>

            <GridSplitter Grid.Column="1"
                          Width="2"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent">
                <dxmvvm:Interaction.Behaviors>
                    <dxmvvm:UIObjectService x:Name="GridSplitterObjectService" />
                </dxmvvm:Interaction.Behaviors>
            </GridSplitter>

            <!-- ── 문서 영역 ──────────────────────────────────────────── -->
            <dxdo:DockLayoutManager x:Name="DockLayoutManager"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    ClosingBehavior="ImmediatelyRemove"
                                    DockingStyle="Default"
                                    FloatingDocumentContainer="DocumentHost"
                                    FloatingMode="Desktop">

                <dxdo:LayoutGroup HorizontalAlignment="Stretch"
                                  Caption="RootLayoutGroup"
                                  Orientation="Horizontal">

                    <dxdo:DocumentGroup x:Name="DocumentGroup"
                                        Margin="-2"
                                        HorizontalAlignment="Stretch"
                                        Caption="Documents"
                                        ClosePageButtonShowMode="InAllTabPageHeaders"
                                        DestroyOnClosingChildren="False"
                                        ItemHeight="*"
                                        ItemWidth="*"
                                        MDIStyle="Default"
                                        PinLocation="Far"
                                        ShowDropDownButton="True"
                                        ShowPinButton="True"
                                        ShowTabHeaders="True"
                                        TabContentCacheMode="CacheTabsOnSelecting">

                        <dxmvvm:Interaction.Behaviors>
                            <!-- ViewModel 의 IDocumentManagerService 가 여기에 문서를 만들어 넣는다 -->
                            <dxdo:TabbedDocumentUIService DocumentGroup="{Binding ElementName=DocumentGroup}">
                                <dxdo:TabbedDocumentUIService.DocumentPanelStyle>
                                    <Style TargetType="dxdo:DocumentPanel">
                                        <!-- 탭 제목·아이콘은 각 화면의 ViewModel 이 Caption / CaptionImage 로 내놓는다 -->
                                        <Setter Property="Caption" Value="{Binding DataContext.Caption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource Self}}" />
                                        <Setter Property="CaptionImage" Value="{Binding DataContext.CaptionImage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource Self}}" />
                                        <Setter Property="SnapsToDevicePixels" Value="True" />
                                        <Setter Property="UseLayoutRounding" Value="True" />
                                        <Setter Property="MDIState" Value="Maximized" />
                                        <Setter Property="MDIMergeStyle" Value="Always" />
                                        <Setter Property="MDISize" Value="1024, 768" />
                                    </Style>
                                </dxdo:TabbedDocumentUIService.DocumentPanelStyle>
                            </dxdo:TabbedDocumentUIService>

                            <dxmvvm:UIObjectService x:Name="DocumentGroupObjectService" />
                        </dxmvvm:Interaction.Behaviors>
                    </dxdo:DocumentGroup>
                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </Grid>
    </DockPanel>
</UserControl>
