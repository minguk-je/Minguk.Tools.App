<UserControl x:Class="Minguk.Tools.Views.SolutionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxprg="http://schemas.devexpress.com/winfx/2008/xaml/propertygrid"
             xmlns:image="clr-namespace:Minguk.Image;assembly=Minguk.Image"
             xmlns:settings="clr-namespace:Minguk.Tools.Markup.Settings"
             xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
             xmlns:views="clr-namespace:Minguk.Tools.Views"
             Style="{DynamicResource BaseControlStyle}"
             FontFamily="{DynamicResource BaseFontFamily}"
             FontSize="{DynamicResource BaseFontSize}"
             DataContext="{dxmvvm:ViewModelSource Type={x:Type viewModels:SolutionSettingsViewModel}}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type viewModels:SolutionSettingsViewModel},
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="600"
             d:DesignWidth="1200">

    <!--
        설정 탭 - 솔루션·프로젝트마다 사람이 칸을 놓아 만드는 설정 화면(docs/솔루션-설정.md).
        VS 폼 디자이너 모양: 위 도구 모음 · 왼쪽 도구 상자 · 가운데 판(LayoutControl) · 오른쪽 속성 · 아래 상태 줄.
        [디자인] 을 끄면 미리보기 - 값을 바꾸는 곳은 여기 하나다.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <dxmvvm:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <dxmvvm:BooleanNegationConverter x:Key="BooleanNegationConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <!-- 스크립트가 값을 쓰면 스크립트 스레드에서 알려 온다. 판에 닿는 일은 이것으로 넘긴다. -->
        <dxmvvm:DispatcherService />

        <!-- 목록 칸 처음 행 대화 상자 - 속성 창 `처음 행` … -->
        <dx:DialogService x:Name="ListRowsDialogService"
                          DialogWindowStartupLocation="CenterOwner">
            <dx:DialogService.ViewTemplate>
                <DataTemplate>
                    <views:SettingsListRowsView />
                </DataTemplate>
            </dx:DialogService.ViewTemplate>
            <dx:DialogService.DialogStyle>
                <Style TargetType="dx:ThemedWindow">
                    <Setter Property="ShowIcon" Value="False" />
                    <Setter Property="SizeToContent" Value="WidthAndHeight" />
                </Style>
            </dx:DialogService.DialogStyle>
        </dx:DialogService>

        <dxmvvm:EventToCommand Command="{Binding OnInitializedCommand}"
                               EventName="Loaded" />
    </dxmvvm:Interaction.Behaviors>

    <dxb:BarManager>
        <dxb:BarManager.Bars>
            <dxb:Bar x:Name="SettingsBar"
                     AllowQuickCustomization="False"
                     Caption="설정">
                <dxb:Bar.DockInfo>
                    <dxb:BarDockInfo ContainerName="SettingsToolbarContainer"
                                     Row="0" />
                </dxb:Bar.DockInfo>
                <dxb:BarEditItem Content="편집 대상"
                                 EditWidth="200"
                                 Hint="솔루션 공통: 모든 프로젝트가 보는 칸·값. 이 프로젝트: 이 런에만 있는 칸, 그리고 공통 칸의 값을 이 런에서만 덮어쓰기."
                                 IsEnabled="{Binding HasProject}">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:ComboBoxEditSettings IsTextEditable="False"
                                                  ItemsSource="{Binding Layers}" />
                    </dxb:BarEditItem.EditSettings>
                    <dxb:BarEditItem.EditValue>
                        <Binding Mode="TwoWay"
                                 Path="SelectedLayer"
                                 UpdateSourceTrigger="PropertyChanged" />
                    </dxb:BarEditItem.EditValue>
                </dxb:BarEditItem>
                <dxb:BarItemSeparator />
                <dxb:BarCheckItem BarItemDisplayMode="ContentAndGlyph"
                                  Content="디자인"
                                  Glyph="{image:FreeImage ResourceName='axialis/basic/16x16/document-edit.png'}"
                                  Hint="켜면 칸을 놓고 끌어 옮깁니다. 끄면 미리보기에서 값을 바꿉니다."
                                  IsChecked="{Binding IsDesign, Mode=TwoWay}"
                                  IsEnabled="{Binding HasProject}" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Command="{Binding MoveUpCommand}"
                                   Content="▲"
                                   Hint="고른 칸을 앞으로 옮깁니다." />
                <dxb:BarButtonItem Command="{Binding MoveDownCommand}"
                                   Content="▼"
                                   Hint="고른 칸을 뒤로 옮깁니다." />
                <dxb:BarButtonItem Command="{Binding DeleteItemCommand}"
                                   Glyph="{image:FreeImage ResourceName='axialis/basic/16x16/delete.png'}"
                                   Hint="고른 칸을 지웁니다. 값은 파일에 남습니다." />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Command="{Binding ReloadCommand}"
                                   Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/refresh.png'}"
                                   Hint="설정 파일을 다시 읽습니다(밖에서 고쳤을 때)." />
                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                   Command="{Binding RemoveUnusedCommand}"
                                   Content="안 쓰는 값 정리"
                                   Glyph="{image:FreeImage ResourceName='axialis/basic/16x16/delete.png'}"
                                   Hint="편집 대상 층에서 칸이 없는 이름의 값을 지웁니다." />
                <dxb:BarButtonItem Command="{Binding OpenFolderCommand}"
                                   Glyph="{image:FreeImage ResourceName='axialis/basic/16x16/folder_open.png'}"
                                   Hint="편집 대상 층의 폴더를 엽니다(settings.form.json · settings.values.json)." />
            </dxb:Bar>
        </dxb:BarManager.Bars>

        <DockPanel LastChildFill="True">
            <!-- ContainerType=Top 만 두면 BarManager 제 위쪽에 붙는다 - 스크립트 화면과 같이 이름 붙인 자리에 얹는다. -->
            <dxb:BarContainerControl x:Name="SettingsToolbarContainer"
                                     ContainerType="Top"
                                     DockPanel.Dock="Top"
                                     TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                                     TextBlock.FontSize="{DynamicResource BaseFontSize}" />

            <!-- 상태 표시줄 - 왼쪽 상태 글(오류면 ⚠ 로 시작), 오른쪽 양식 파일 자리. -->
            <dxb:StatusBarControl AllowCustomizationMenu="False"
                                  DockPanel.Dock="Bottom"
                                  TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                                  TextBlock.FontSize="{DynamicResource BaseFontSize}">
                <dxb:BarStaticItem AutoSizeMode="Fill"
                                   Content="{Binding StatusText, Mode=OneWay}"
                                   ShowBorder="False" />
                <dxb:BarStaticItem Alignment="Far"
                                   Content="{Binding FormPath, Mode=OneWay}"
                                   ShowBorder="False" />
            </dxb:StatusBarControl>

            <dxlc:LayoutControl Padding="0,4,0,0"
                                Orientation="Horizontal">

                <!-- ── 도구 상자 ── 디자인일 때만. -->
                <dxlc:LayoutGroup Width="170"
                                  dxlc:LayoutControl.AllowHorizontalSizing="True"
                                  Header="도구 상자"
                                  Orientation="Vertical"
                                  View="GroupBox"
                                  Visibility="{Binding IsDesign, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <dxlc:LayoutItem VerticalAlignment="Stretch"
                                     AddColonToLabel="False"
                                     Label="">
                        <dxe:ListBoxEdit x:Name="ToolboxList"
                                         DisplayMember="Title"
                                         ItemsSource="{Binding Toolbox}"
                                         ShowBorder="False">
                            <dxe:ListBoxEdit.ItemTemplate>
                                <!-- 아이콘 + 이름(VS 도구 상자 모양). 한 줄의 둘 다 세로 가운데. -->
                                <DataTemplate>
                                    <DockPanel Margin="2,3"
                                               ToolTip="{Binding Description}">
                                        <Image Width="16"
                                               Height="16"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left"
                                               Source="{Binding Glyph}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding Title}" />
                                    </DockPanel>
                                </DataTemplate>
                            </dxe:ListBoxEdit.ItemTemplate>
                            <dxmvvm:Interaction.Behaviors>
                                <!-- 판으로 끌어 놓거나, 두 번 누르거나 Enter 로 놓는다(VS 도구 상자와 같다). 놓을 자리는 판이 파란 선·점선 상자로 보인다. -->
                                <settings:SettingsToolboxDragBehavior />
                                <dxmvvm:EventToCommand Command="{Binding AddItemCommand}"
                                                       CommandParameter="{Binding SelectedItem, ElementName=ToolboxList}"
                                                       EventName="MouseDoubleClick" />
                                <dxmvvm:KeyToCommand Command="{Binding AddItemCommand}"
                                                     CommandParameter="{Binding SelectedItem, ElementName=ToolboxList}"
                                                     KeyGesture="Enter" />
                            </dxmvvm:Interaction.Behaviors>
                        </dxe:ListBoxEdit>
                    </dxlc:LayoutItem>
                    <dxlc:LayoutItem AddColonToLabel="False"
                                     Label="">
                        <dx:SimpleButton Command="{Binding AddItemCommand}"
                                         CommandParameter="{Binding SelectedItem, ElementName=ToolboxList}"
                                         Content="놓기"
                                         Glyph="{image:FreeImage ResourceName='axialis/basic/16x16/add.png'}"
                                         GlyphHeight="16"
                                         GlyphWidth="16"
                                         ToolTip="고른 칸을 판에 놓습니다. 구역을 골라 두면 그 안에, 칸을 골라 두면 그 뒤에 놓입니다. 판으로 끌어 놓아도 됩니다." />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>

                <!-- ── 판 ── -->
                <dxlc:LayoutGroup Header="{Binding SelectedLayer.Title}"
                                  Orientation="Vertical"
                                  View="GroupBox">
                    <dxlc:LayoutItem VerticalAlignment="Stretch"
                                     AddColonToLabel="False"
                                     Label="">
                        <settings:SettingsFormCanvas>
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:UIObjectService x:Name="CanvasObjectService" />
                            </dxmvvm:Interaction.Behaviors>
                        </settings:SettingsFormCanvas>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>

                <!-- ── 속성 ── 디자인일 때만. -->
                <dxlc:LayoutGroup Width="300"
                                  dxlc:LayoutControl.AllowHorizontalSizing="True"
                                  Header="속성"
                                  Orientation="Vertical"
                                  View="GroupBox"
                                  Visibility="{Binding IsDesign, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <dxlc:LayoutItem VerticalAlignment="Stretch"
                                     AddColonToLabel="False"
                                     Label="">
                        <!--
                            일반 사용자가 만지는 창이라 VS 속성 창보다 단순하게 둔다(사용자, 2026-09-17).
                            순서는 사람이 읽는 순서(속성의 Display(Order)), 설명은 툴팁 - 바닥 설명 칸이 늘 비어 자리만 먹었다.
                            긴 글(콤보 항목·목록 열)은 끝이 잘려 ▾ 로 넓게 펼쳐 고친다(한 줄에 하나씩 적어도 된다).
                        -->
                        <dxprg:PropertyGridControl ExpandCategoriesWhenSelectedObjectChanged="True"
                                                   SelectedObject="{Binding SelectedEditor}"
                                                   ShowCategories="Visible"
                                                   ShowDescriptionIn="ToolTip"
                                                   ShowMenuButtonInRows="False"
                                                   ShowProperties="All"
                                                   ShowToolPanel="False"
                                                   SortMode="NoSort">
                            <dxprg:PropertyDefinition Path="Items">
                                <dxprg:PropertyDefinition.EditSettings>
                                    <dxe:MemoEditSettings MemoTextWrapping="Wrap"
                                                          MemoVerticalScrollBarVisibility="Auto"
                                                          PopupHeight="160"
                                                          PopupWidth="280"
                                                          ShowIcon="False" />
                                </dxprg:PropertyDefinition.EditSettings>
                            </dxprg:PropertyDefinition>
                            <dxprg:PropertyDefinition Path="Columns">
                                <dxprg:PropertyDefinition.EditSettings>
                                    <dxe:MemoEditSettings MemoTextWrapping="Wrap"
                                                          MemoVerticalScrollBarVisibility="Auto"
                                                          PopupHeight="160"
                                                          PopupWidth="280"
                                                          ShowIcon="False" />
                                </dxprg:PropertyDefinition.EditSettings>
                            </dxprg:PropertyDefinition>
                            <!-- 목록 처음 행 - 글로는 못 적어 … 이 표 대화 상자를 띄운다. 단추는 늘 보이게(안 누르면 무엇으로 고치는지 모른다). -->
                            <dxprg:PropertyDefinition Path="DefaultRows"
                                                      ShowEditorButtons="True">
                                <dxprg:PropertyDefinition.CellTemplate>
                                    <DataTemplate>
                                        <dxe:ButtonEdit x:Name="PART_Editor"
                                                        IsTextEditable="False"
                                                        ShowBorder="False">
                                            <dxmvvm:Interaction.Behaviors>
                                                <dxmvvm:EventToCommand Command="{Binding DataContext.EditListRowsCommand, RelativeSource={RelativeSource AncestorType=dxprg:PropertyGridControl}}"
                                                                       EventName="DefaultButtonClick" />
                                            </dxmvvm:Interaction.Behaviors>
                                        </dxe:ButtonEdit>
                                    </DataTemplate>
                                </dxprg:PropertyDefinition.CellTemplate>
                            </dxprg:PropertyDefinition>
                        </dxprg:PropertyGridControl>
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>
            </dxlc:LayoutControl>
        </DockPanel>
    </dxb:BarManager>
</UserControl>
