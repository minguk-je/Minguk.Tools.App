<UserControl x:Class="Minguk.Tools.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:image="clr-namespace:Minguk.Image;assembly=Minguk.Image" 
             xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
             Style="{DynamicResource BaseControlStyle}"
             FontFamily="{DynamicResource BaseFontFamily}"
             FontSize="{DynamicResource BaseFontSize}"
             DataContext="{dxmvvm:ViewModelSource Type={x:Type viewModels:DashboardViewModel}}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type viewModels:DashboardViewModel},
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="500"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Command="{Binding OnInitializedCommand}"
                               EventName="Loaded" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl Padding="8"
                        Orientation="Vertical"
                        ScrollBars="Auto">

        <dxlc:LayoutGroup Orientation="Horizontal"
                          View="GroupBox"
                          Header="파이프라인 지표">
            <dxlc:LayoutItem Label="처리 프레임">
                <dxe:TextEdit EditValue="{Binding TotalFrames}"
                              IsReadOnly="True"
                              MaskType="Numeric"
                              Mask="n0" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="스킵 프레임">
                <dxe:TextEdit EditValue="{Binding SkippedFrames}"
                              IsReadOnly="True"
                              MaskType="Numeric"
                              Mask="n0" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem Label="평균 지연(ms)">
                <dxe:TextEdit EditValue="{Binding AverageLatencyMs}"
                              IsReadOnly="True"
                              MaskType="Numeric"
                              Mask="n2" />
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>

        <dxlc:LayoutGroup Orientation="Horizontal"
                          VerticalAlignment="Top">
            <dx:SimpleButton Width="120"
                             HorizontalAlignment="Left"
                             Command="{Binding DoRefreshCommand}"
                             Content="새로고침"
                             Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/refresh.png'}"
                             GlyphHeight="16"
                             GlyphWidth="16" />

            <dxlc:LayoutItem Label="마지막 갱신">
                <dxe:TextEdit EditValue="{Binding LastUpdated}"
                              IsReadOnly="True" />
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>
