<UserControl x:Class="Minguk.Tools.Views.AutomationMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
             Style="{DynamicResource BaseControlStyle}"
             FontFamily="{DynamicResource BaseFontFamily}"
             FontSize="{DynamicResource BaseFontSize}"
             DataContext="{dxmvvm:ViewModelSource Type={x:Type viewModels:AutomationMainViewModel}}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type viewModels:AutomationMainViewModel},
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Command="{Binding OnInitializedCommand}"
                               EventName="Loaded" />
        <dx:DXMessageBoxService />
    </dxmvvm:Interaction.Behaviors>

    <!-- TamsTools StreamMode 화면과 같은 짜임 - 위에서 고르고, 아래 탭이 그 선택을 따라간다. -->
    <dxlc:LayoutControl Margin="-1"
                        Padding="0"
                        Orientation="Vertical">

        <!-- ── 위 : 솔루션 → 프로젝트 ─────────────────────────────────── -->
        <dxlc:LayoutGroup Margin="4,4,4,2"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          ItemSpace="8"
                          Orientation="Horizontal">

            <!-- 깊이로 내려간다: 작업공간 → 솔루션 → 프로젝트. 작업공간은 환경 메뉴에서 정한다(여기서는 보이기만). -->
            <dxlc:LayoutItem HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             AddColonToLabel="False"
                             Label="작업공간">
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding ProjectsRoot}"
                           ToolTip="솔루션들이 든 폴더입니다. 이 아래에서 솔루션을 찾습니다. 바꾸려면 환경 메뉴의 작업공간에서 고르세요." />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem HorizontalAlignment="Left"
                             AddColonToLabel="False"
                             Label="솔루션">
                <dxe:ComboBoxEdit MinWidth="140"
                                  DisplayMember="Name"
                                  IsTextEditable="False"
                                  ItemsSource="{Binding Solutions}"
                                  NullText="선택하세요"
                                  SelectedItem="{Binding SelectedSolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem HorizontalAlignment="Left"
                             AddColonToLabel="False"
                             Label="프로젝트">
                <dxe:ComboBoxEdit MinWidth="140"
                                  DisplayMember="Name"
                                  IsTextEditable="False"
                                  ItemsSource="{Binding Projects}"
                                  NullText="선택하세요"
                                  SelectedItem="{Binding SelectedProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </dxlc:LayoutItem>

            <!-- 고르는 칸 바로 옆에 만들기를 둔다 - StreamMode 머리 칸처럼 한 줄에서 끝난다. -->
            <dx:SimpleButton HorizontalAlignment="Left"
                             Command="{Binding DoNewProjectCommand}"
                             Content="새 프로젝트"
                             ToolTip="지금 솔루션에 프로젝트(모드·스테이지·런)를 하나 더하고 그리로 넘어갑니다." />

            <dx:SimpleButton HorizontalAlignment="Left"
                             Command="{Binding DoNewSharedProjectCommand}"
                             Content="새 공유 프로젝트"
                             ToolTip="여러 프로젝트가 같이 쓸 스크립트를 담는 공유 프로젝트를 만듭니다. 스크립트 화면 솔루션 탐색기에서 추가 &gt; 공유 프로젝트 참조로 물립니다." />

            <dx:SimpleButton HorizontalAlignment="Left"
                             Command="{Binding DoNewSolutionCommand}"
                             Content="새 솔루션"
                             ToolTip="새 게임(솔루션)과 첫 프로젝트를 만들고 그리로 넘어갑니다." />

            <dxlc:LayoutItem HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             AddColonToLabel="False"
                             Label="">
                <TextBlock Foreground="Gray"
                           Text="{Binding ProjectDirectory}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ProjectDirectory}" />
            </dxlc:LayoutItem>

            <dx:SimpleButton MinWidth="100"
                             HorizontalAlignment="Right"
                             Command="{Binding DoCloseCommand}"
                             Content="화면닫기"
                             Glyph="{dx:DXImage 'SvgImages/XAF/Action_Close.svg'}"
                             GlyphHeight="16"
                             GlyphWidth="16" />
        </dxlc:LayoutGroup>

        <!--
            ── 아래 : 이 프로젝트의 화면들 ─────────────────────────────────
            진짜 문서로 둔다(StreamMode 와 같다) - 부모 넣기·닫기·파기를 DevExpress 가 해 준다.
            서비스 이름(AutomationDocumentManagerService)으로 꺼낸다 - 셸(MainView)에도 같은 서비스가 있다.
            닫기 버튼은 없다. CacheTabsOnSelecting - 처음 고른 탭만 불러오고, 한 번 불러온 것은 옮겨도 버리지 않는다(캡처가 안 끊긴다).
            CacheAllTabs 로 두었더니 여는 순간 여섯 화면이 다 초기화됐다(실측: Roslyn 예열 3번·F5 쥐기 3번이 한꺼번에).
        -->
        <dxdo:DockLayoutManager Margin="0"
                                Padding="0"
                                AllowCustomization="False">
            <dxdo:LayoutGroup Margin="0,1,0,0" Padding="0">
                <dxdo:DocumentGroup x:Name="AutomationDocumentGroup"
                                    Margin="0"
                                    Padding="0"
                                    ClosePageButtonShowMode="NoWhere"
                                    DestroyOnClosingChildren="False"
                                    MDIStyle="Tabbed"
                                    ShowTabHeaders="True"
                                    TabContentCacheMode="CacheTabsOnSelecting">
                    <dxmvvm:Interaction.Behaviors>
                        <dxdo:TabbedDocumentUIService x:Name="AutomationDocumentManagerService"
                                                      DocumentGroup="{Binding ElementName=AutomationDocumentGroup}">
                            <dxdo:TabbedDocumentUIService.DocumentPanelStyle>
                                <Style TargetType="dxdo:DocumentPanel">
                                    <Setter Property="CaptionImage" Value="{Binding DataContext.CaptionImage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource Self}}" />
                                    <Setter Property="Caption" Value="{Binding DataContext.Caption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource Self}}" />
                                    <Setter Property="ShowCloseButton" Value="False" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                    <Setter Property="UseLayoutRounding" Value="True" />
                                </Style>
                            </dxdo:TabbedDocumentUIService.DocumentPanelStyle>
                        </dxdo:TabbedDocumentUIService>
                    </dxmvvm:Interaction.Behaviors>
                </dxdo:DocumentGroup>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
    </dxlc:LayoutControl>

</UserControl>
