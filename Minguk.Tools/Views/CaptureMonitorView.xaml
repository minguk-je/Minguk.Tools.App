<UserControl x:Class="Minguk.Tools.Views.CaptureMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:markup="clr-namespace:Minguk.Tools.Markup"
             xmlns:controls="clr-namespace:Minguk.Base.Controls;assembly=Minguk.Base"
             xmlns:dependency="clr-namespace:Minguk.Base.Dependency;assembly=Minguk.Base"
             xmlns:image="clr-namespace:Minguk.Image;assembly=Minguk.Image"
             xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
             Style="{DynamicResource BaseControlStyle}"
             FontFamily="{DynamicResource BaseFontFamily}"
             FontSize="{DynamicResource BaseFontSize}"
             DataContext="{dxmvvm:ViewModelSource Type={x:Type viewModels:CaptureMonitorViewModel}}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type viewModels:CaptureMonitorViewModel},
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="500"
             d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <dxmvvm:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <ResourceDictionary.MergedDictionaries>
                <!-- 행 번호가 그려지는 RowIndicator 템플릿이 DataTemplate.xaml 에 있다 -->
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/DataTemplate.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/GridColumnStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <!--
            캡처 콜백은 스레드풀에서 돈다. ViewModel 이 그리드를 건드리려면 디스패처가 필요하므로
            여기서 IDispatcherService 를 등록해 준다. 빠뜨리면 통계 줄이 한 줄도 안 쌓인다.
        -->
        <dxmvvm:DispatcherService />

        <dxmvvm:EventToCommand Command="{Binding OnInitializedCommand}"
                               EventName="Loaded" />
        <dxmvvm:EventToCommand Command="{Binding OnUnloadedCommand}"
                               EventName="Unloaded" />
    </dxmvvm:Interaction.Behaviors>

    <DockPanel LastChildFill="True">

        <!-- ── 동작 (메뉴 한 줄) ────────────────────────────────────── -->
        <!--
            동작만 메뉴 줄에 둔다. 하위 메뉴로 접지 않고 한 줄에 펼친다 -
            다섯 개뿐이라 접으면 한 번 더 눌러야 닿는다.
        -->
        <dxb:MainMenuControl DockPanel.Dock="Top"
                             AllowCustomizationMenu="False"
                             TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                             TextBlock.FontSize="{DynamicResource BaseFontSize}">

            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding RefreshTargetsCommand}"
                               Content="새로 고침"
                               Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/refresh.png'}"
                               ToolTip="캡처할 수 있는 창·모니터 목록을 다시 훑는다." />

            <dxb:BarItemSeparator />

            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding DoStartCommand}"
                               Content="시작"
                               Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/record-control_play.png'}" />
            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding DoStopCommand}"
                               Content="중지"
                               Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/record-control_stop.png'}" />

            <dxb:BarItemSeparator />

            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding DoClearCommand}"
                               Content="통계 지우기"
                               Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/delete.png'}"
                               ToolTip="쌓인 통계 줄을 비운다." />
            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding SaveFrameCommand}"
                               Content="프레임 저장"
                               Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/save.png'}"
                               ToolTip="다음 프레임 한 장을 captures 폴더에 PNG 로 저장한다. 캡처가 무엇을 잡고 있는지 눈으로 확인하는 용도라 라벨링에는 안 보인다." />
            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding CollectFrameCommand}"
                               Content="데이터셋에 담기 (F8)"
                               Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/add.png'}"
                               ToolTip="라벨링 화면이 읽는 폴더에 한 장 담는다. 여기 담은 그림에 몹 사각형을 찍는다. F8 은 게임이 앞에 있어도 눌린다 - 담기면 알림음, 안 되면 거절음." />
            <dxb:BarCheckItem BarItemDisplayMode="ContentAndGlyph"
                              Content="몹 찾기"
                              Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/search.png'}"
                              IsChecked="{Binding IsMobDetectionOn}"
                              ToolTip="학습한 모델로 0.25초에 한 번 찾아 점선으로 겹쳐 그린다. CPU 리드백이 켜져 있어야 한다." />

            <!--
                찾기만 하면 자동화가 아니다. 찾은 것 중 가장 자신 있는 것의 가운데를 누른다.
                입력 전달이 켜져 있어야 나간다 - 찾는 것은 화면만 보지만 누르는 것은
                남의 프로그램에 실제로 들어가므로, 켜는 일은 사람이 한 번 분명히 해야 한다.
            -->
            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding ClickDetectionCommand}"
                               Content="찾은 것 누르기"
                               Glyph="{image:FreeImage ResourceName='Axialis/HardwareNetwork/16x16/mouse.png'}"
                               ToolTip="가장 자신 있는 몹의 가운데를 누른다. 입력 전달이 켜져 있어야 한다." />

            <!--
                몇 마리를 몇 ms 에 찾았는지. 실제 속도가 여기 그대로 뜬다.

                "왜 못 켜는지" 같은 긴 안내는 여기 두지 않는다. 값은 들어 있는데(로그로 확인)
                이 메뉴 바의 정적 항목이 그 문구를 안 그렸다 - 짧은 "2마리 (…ms)" 는 그리면서.
                타이밍(디스패처 지연)·캡처 중 여부·AutoSizeMode=Fill 까지 갈라 봤지만 이유를
                못 밝혔고, Fill 은 넘침 화살표만 만들었다. 그런 안내는 아래 상태 줄로 간다
                (TurnOffDetection 이 StatusText 에도 적는다).
            -->
            <dxb:BarStaticItem Content="{Binding DetectionStatus, Mode=OneWay}" />
        </dxb:MainMenuControl>

        <!-- ── 설정 첫 줄 ──────────────────────────────────────────── -->
        <!--
            "미리보기" 체크는 반드시 이 줄에 둔다. 아래 줄은 통째로 ShowPreview 에
            걸려 있어서, 같은 줄에 두면 끄는 순간 자기 자신이 사라져 다시 켤 수 없다.
        -->
        <dxb:ToolBarControl DockPanel.Dock="Top"
                            AllowCustomizationMenu="False"
                            AllowQuickCustomization="False"
                            TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                            TextBlock.FontSize="{DynamicResource BaseFontSize}">

            <dxb:BarEditItem Content="대상"
                             EditValue="{Binding SelectedTarget}"
                             EditWidth="420"
                             IsEnabled="{Binding IsNotRunning}">
                <dxb:BarEditItem.EditSettings>
                    <dxe:ComboBoxEditSettings DisplayMember="Display"
                                              IsTextEditable="False"
                                              ItemsSource="{Binding Targets}" />
                </dxb:BarEditItem.EditSettings>
            </dxb:BarEditItem>

            <dxb:BarEditItem Content="fps"
                             EditValue="{Binding CaptureTargetFps}"
                             EditWidth="70"
                             ToolTip="캡처 상한(fps). 넘는 프레임은 받지 않는다 - 그만큼 일이 준다.">
                <dxb:BarEditItem.EditSettings>
                    <dxe:ComboBoxEditSettings IsTextEditable="False"
                                              ItemsSource="{Binding FpsOptions}" />
                </dxb:BarEditItem.EditSettings>
            </dxb:BarEditItem>

            <dxb:BarCheckItem Content="CPU 리드백"
                              IsChecked="{Binding EnableCpuReadback}"
                              IsEnabled="{Binding IsNotRunning}"
                              ToolTip="GPU 프레임을 CPU 메모리로 내린다. 프레임 저장·데이터셋에 담기·몹 찾기가 필요하면 알아서 켠다." />

            <dxb:BarItemSeparator />

            <dxb:BarCheckItem Content="미리보기"
                              IsChecked="{Binding ShowPreview}"
                              ToolTip="캡처 중인 화면을 그대로 보여 준다. 켜면 프레임마다 GPU→CPU 복사가 붙는다." />
            <dxb:BarCheckItem Content="열 자동 너비"
                              IsChecked="{Binding IsColumnAutoWidth}"
                              ToolTip="통계 열 너비를 내용에 맞춘다. 끄면 직접 조절한 너비가 유지된다." />
        </dxb:ToolBarControl>
        <!--  미리보기를 켰을 때만 쓰는 것들. 툴바째 숨겨 조건을 한 군데로 모은다.  -->
        <dxb:ToolBarControl DockPanel.Dock="Top"
                            AllowCustomizationMenu="False"
                            AllowQuickCustomization="False"
                            TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                            TextBlock.FontSize="{DynamicResource BaseFontSize}"
                            Visibility="{Binding ShowPreview, Converter={StaticResource BooleanToVisibilityConverter}}">

            <dxb:BarEditItem Content="갱신 상한"
                             EditValue="{Binding PreviewTargetFps}"
                             EditWidth="70"
                             ToolTip="미리보기 갱신 상한(fps). 캡처 자체는 이 값과 무관하게 계속 돈다.">
                <dxb:BarEditItem.EditSettings>
                    <dxe:ComboBoxEditSettings IsTextEditable="False"
                                              ItemsSource="{Binding FpsOptions}" />
                </dxb:BarEditItem.EditSettings>
            </dxb:BarEditItem>

            <dxb:BarStaticItem Content="{Binding PreviewFpsText, Mode=OneWay}"
                               ToolTip="지금 화면에 올라가고 있는 실제 fps. 왼쪽 값은 상한일 뿐이다." />

            <dxb:BarItemSeparator />

            <dxb:BarCheckItem Content="입력 전달"
                              IsChecked="{Binding IsInputForwardingEnabled}"
                              IsEnabled="{Binding IsInputForwardingAvailable}"
                              ToolTip="미리보기 클릭·키를 대상 창으로 보낸다. 요소 검사가 켜져 있으면 쓸 수 없다." />

            <dxb:BarCheckItem Content="요소 검사"
                              IsChecked="{Binding IsElementInspectEnabled}"
                              ToolTip="미리보기를 누르면 그 자리의 UI 요소를 상태 줄에 보여 준다. 켜져 있는 동안은 입력을 전달하지 않는다." />

            <dxb:BarEditItem Content="경로"
                             EditValue="{Binding SelectedInputBackend}"
                             EditWidth="130"
                             IsEnabled="{Binding IsInputForwardingEnabled}"
                             ToolTip="SendInput: 거의 모든 대상에 통하지만 대상이 앞으로 나온다. PostMessage: 포커스를 안 뺏지만 창 메시지를 보는 대상에만 통한다.">
                <dxb:BarEditItem.EditSettings>
                    <dxe:ComboBoxEditSettings IsTextEditable="False"
                                              ItemsSource="{Binding InputBackends}" />
                </dxb:BarEditItem.EditSettings>
            </dxb:BarEditItem>

            <dxb:BarCheckItem Content="클릭 후 돌아오기"
                              IsChecked="{Binding IsReturnFocusAfterClickEnabled}"
                              IsEnabled="{Binding IsInputForwardingEnabled}"
                              ToolTip="클릭이 대상에 닿은 뒤 커서와 포커스를 이 창으로 되돌린다. 끄면 대상 창이 앞에 남는다." />
        </dxb:ToolBarControl>
        <!-- ── 상태 줄 ─────────────────────────────────────────────────── -->
        <dxe:TextEdit Margin="4,0,4,4"
                      DockPanel.Dock="Bottom"
                      EditValue="{Binding StatusText, Mode=OneWay}"
                      IsReadOnly="True"
                      ShowBorder="False" />

        <!--
            미리보기(위) / 통계 그리드(아래). DevExpress LayoutControl 로 나눈다.
            AllowVerticalSizing 이 그룹 사이에 드래그 가능한 경계를 만들어 준다 —
            표준 WPF GridSplitter 는 경량 테마에서 테마가 먹지 않아 쓰지 않는다.
            
            높이는 바인딩하지 않고 ViewModel 이 UIObjectService 로 그룹을 잡아
            직접 넣고 뺀다(TamsTools 와 같은 방식).
        -->
        <dxlc:LayoutControl Margin="4,0,4,4"
                            Padding="0"
                            ItemSpace="0"
                            Orientation="Vertical">

            <dxlc:LayoutGroup Height="320"
                              dxlc:LayoutControl.AllowVerticalSizing="True"
                              ItemSpace="0"
                              Orientation="Vertical"
                              View="Group"
                              Visibility="{Binding ShowPreview, Converter={StaticResource BooleanToVisibilityConverter}}">

                <dxmvvm:Interaction.Behaviors>
                    <dxmvvm:UIObjectService x:Name="PreviewGroupObjectService" />
                </dxmvvm:Interaction.Behaviors>

                <!--
                    Stretch=Uniform 이라 원본 비율을 지킨다. 축소해서 보여 주는 용도이므로
                    BitmapScalingMode 는 LowQuality(선형 보간)로 둔다 — 60fps 로 갱신할 때
                    HighQuality 로 두면 축소 비용이 UI 스레드를 잡아먹는다.
                -->
                <!--
                    입력은 Border 가 받는다. Image 에는 Background 가 없어서 그림 바깥(검은 띠)이
                    히트 테스트에 안 걸리는데, Border 는 배경이 칠해져 있어 전 영역이 잡힌다.
                    Focusable 이 있어야 키 입력이 들어온다 — Image 는 Focusable 이 아니므로
                    누를 때 이 Border 에 포커스를 준다. 그래서 여기에도 UIObjectService 를 둔다.
                    좌표는 Image 기준으로 재므로 Image 에도 하나 있다.
                -->
                <Border Background="#202020"
                        Focusable="True">

                    <dxmvvm:Interaction.Behaviors>
                        <dxmvvm:UIObjectService x:Name="PreviewSurfaceObjectService" />

                        <dxmvvm:EventToCommand Command="{Binding OnPreviewMouseDownCommand}"
                                               EventName="MouseDown"
                                               PassEventArgsToCommand="True" />
                        <dxmvvm:EventToCommand Command="{Binding OnPreviewMouseWheelCommand}"
                                               EventName="MouseWheel"
                                               PassEventArgsToCommand="True" />
                        <dxmvvm:EventToCommand Command="{Binding OnPreviewKeyDownCommand}"
                                               EventName="KeyDown"
                                               PassEventArgsToCommand="True" />
                        <dxmvvm:EventToCommand Command="{Binding OnPreviewKeyUpCommand}"
                                               EventName="KeyUp"
                                               PassEventArgsToCommand="True" />
                    </dxmvvm:Interaction.Behaviors>

                    <Grid>
                        <Image RenderOptions.BitmapScalingMode="LowQuality"
                               Source="{Binding PreviewImage}"
                               Stretch="Uniform">

                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:UIObjectService x:Name="PreviewImageObjectService" />
                            </dxmvvm:Interaction.Behaviors>
                        </Image>

                        <!--
                            찾은 몹을 점선으로 겹쳐 그린다. Image 와 정확히 같은 자리를 차지하고
                            Source 로 원본 크기만 받아 Uniform 레터박스를 스스로 계산한다.
                            마우스는 통과시킨다 - 미리보기는 클릭을 대상 창으로 넘기는 일을 한다.
                        -->
                        <markup:DetectionOverlay Detections="{Binding Detections}"
                                                 Source="{Binding PreviewImage}" />
                    </Grid>
                </Border>
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup ItemSpace="0"
                              Orientation="Vertical"
                              View="Group">

                <!--
                    행 번호 칸(인디케이터) 폭을 행 수에 맞춰 늘리기 위한 틀. TamsTools 와 같은 구성이다.
                    
                    행 번호는 DataTemplate.xaml 의 RowIndicator 템플릿이 그리는데, 그 안의 열이
                    SharedSizeGroup="RowNumberGroup" 에 참여한다. 아래 숨은 Border 를 같은 그룹의
                    열에 두면 Border 가 "가장 넓은 행 번호" 만큼 넓어지고, 그 폭을 TableView 의
                    IndicatorWidth 로 되돌려 준다.
                    
                    이게 없으면 인디케이터가 DevExpress 기본 폭에 머물러서 세 자리 행 번호가
                    앞에서 잘린다(실제로 600행까지 쌓였을 때 ".11" 처럼 보였다).
                -->
                <Grid Grid.IsSharedSizeScope="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"
                                          SharedSizeGroup="RowNumberGroup" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 폭만 재는 자리. 눈에 보이지 않는다. Margin 은 셀 여백 보정. -->
                    <Border x:Name="GridRowNumberSizeProxy"
                            Margin="-4"
                            Visibility="Hidden" />

                    <controls:BaseGridControl Grid.Column="0"
                                              Grid.ColumnSpan="2"
                                              dependency:GridControlDependency.IsRowNumber="True"
                                              AutoGenerateColumns="None"
                                              ItemsSource="{Binding Rows}">

                        <dxmvvm:Interaction.Behaviors>
                            <!--
                                열 너비·순서·정렬·필터를 문자열로 뽑고 되돌린다.
                                ViewModel 이 ServiceContainer 에서 이 이름으로 꺼내 쓴다.
                            -->
                            <dxmvvm:LayoutSerializationService x:Name="GridLayoutService" />
                            <dxmvvm:UIObjectService x:Name="GridObjectService" />
                        </dxmvvm:Interaction.Behaviors>

                        <dxg:GridControl.View>
                            <!--
                                TamsTools 와 같은 구성. 행 번호는 항상 켜고, 열 자동 너비는 토글로 둔다.
                                (GridControlDependency 가 언바운드 열을 만들고 너비를 계산해 준다)
                            -->
                            <!--
                                AllowBestFit 은 BaseTableView 기본값(켜짐)을 그대로 쓴다.
                                열 머리글 오른쪽 메뉴의 "최적 너비" 가 여기서 나온다.

                                한동안 꺼 두었는데, 저장한 열 너비가 복원되지 않는 원인으로
                                이걸 의심했기 때문이다. 실제 원인은 "열 자동 너비" 였다 —
                                그게 켜지면 모든 열의 너비 단위가 Auto(내용에 맞춤)가 되어
                                끌어도 값이 안 남는다. best fit 과는 무관했다.
                            -->
                            <controls:BaseTableView dependency:GridControlDependency.IsColumnAutoWidth="{Binding IsColumnAutoWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=False}"
                                                    AllowEditing="False"
                                                    IndicatorWidth="{Binding Path=(Border.ActualWidth), ElementName=GridRowNumberSizeProxy, Mode=OneWay}"
                                                    ShowGroupPanel="False" />
                        </dxg:GridControl.View>

                        <!--
                            행 번호용 숨은 언바운드 열. 화면에는 안 보이고 왼쪽 인디케이터가 이 값을 쓴다.
                            (GridControlDependency 가 CustomUnboundColumnData 에서 채운다)
                        -->
                        <dxg:GridColumn Style="{StaticResource GridColumn.RowNumber.Style}" />

                        <dxg:GridColumn Width="160" FieldName="Timestamp" Header="시각">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="yyyy-MM-dd HH:mm:ss" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <!--
                            캡처 fps 는 WGC 가 주는 속도, 미리보기 fps 는 그중 화면에 올린 장수다.
                            미리보기 상한을 30 으로 두면 캡처는 60 인데 미리보기만 30 이 된다.
                        -->
                        <dxg:GridColumn Width="80" FieldName="Fps" Header="캡처 fps">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="n0" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Width="90" FieldName="PreviewFps" Header="미리보기 fps">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="n0" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Width="110" FieldName="AvgLatencyMs" Header="지연 평균(ms)">
