<UserControl x:Class="Minguk.Tools.Views.CaptureMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:controls="clr-namespace:Minguk.Base.Controls;assembly=Minguk.Base"
             xmlns:dependency="clr-namespace:Minguk.Base.Dependency;assembly=Minguk.Base"
             xmlns:image="clr-namespace:Minguk.Image;assembly=Minguk.Image"
             xmlns:parts="clr-namespace:Minguk.Tools.Views.Parts"
             xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
             Style="{DynamicResource BaseControlStyle}"
             FontFamily="{DynamicResource BaseFontFamily}"
             FontSize="{DynamicResource BaseFontSize}"
             DataContext="{dxmvvm:ViewModelSource Type={x:Type viewModels:CaptureMonitorViewModel}}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type viewModels:CaptureMonitorViewModel},
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="500"
             d:DesignWidth="900">

    <!--
        캡처 화면. 순수하게 잡는 일만 한다 - 대상을 골라 시작하고, 미리보기로 확인하고, 한 장을
        데이터셋에 담거나 파일로 떨어뜨린다. 몹 찾기·글자 읽기·스크립트는 편집 화면, 반복 실행은 플레이 화면.
        한 화면에 전부 얹었을 때 도구 줄이 넘쳐 글자 상태 칸이 밀려났던 것이 나눈 이유다.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <dxmvvm:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <ResourceDictionary.MergedDictionaries>
                <!-- 행 번호가 그려지는 RowIndicator 템플릿이 DataTemplate.xaml 에 있다 -->
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/DataTemplate.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/GridColumnStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <!--
            캡처 콜백은 스레드풀에서 돈다. ViewModel 이 그리드를 건드리려면 디스패처가 필요하므로
            여기서 IDispatcherService 를 등록해 준다. 빠뜨리면 통계 줄이 한 줄도 안 쌓인다.
        -->
        <dxmvvm:DispatcherService />

        <dxmvvm:EventToCommand Command="{Binding OnInitializedCommand}"
                               EventName="Loaded" />
        <dxmvvm:EventToCommand Command="{Binding OnUnloadedCommand}"
                               EventName="Unloaded" />
    </dxmvvm:Interaction.Behaviors>

    <DockPanel LastChildFill="True">

        <!-- ── 동작 (메뉴 한 줄) ────────────────────────────────────── -->
        <dxb:MainMenuControl AllowCustomizationMenu="False"
                             DockPanel.Dock="Top"
                             TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                             TextBlock.FontSize="{DynamicResource BaseFontSize}">

            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding RefreshTargetsCommand}"
                               Content="새로 고침"
                               Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/refresh.png'}"
                               ToolTip="캡처할 수 있는 창·모니터 목록을 다시 훑는다." />

            <dxb:BarItemSeparator />

            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding DoStartCommand}"
                               Content="시작"
                               Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/record-control_play.png'}" />
            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding DoStopCommand}"
                               Content="중지"
                               Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/record-control_stop.png'}" />

            <dxb:BarItemSeparator />

            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding DoClearCommand}"
                               Content="통계 지우기"
                               Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/delete.png'}"
                               ToolTip="쌓인 통계 줄을 비운다." />
            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding SaveFrameCommand}"
                               Content="프레임 저장"
                               Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/save.png'}"
                               ToolTip="다음 프레임 한 장을 captures 폴더에 PNG 로 저장한다. 캡처가 무엇을 잡고 있는지 눈으로 확인하는 용도라 라벨링에는 안 보인다." />
            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding CollectFrameCommand}"
                               Content="데이터셋에 담기 (F8)"
                               Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/add.png'}"
                               ToolTip="라벨링 화면이 읽는 폴더에 한 장 담는다. 여기 담은 그림에 몹 사각형을 찍는다. F8 은 게임이 앞에 있어도 눌린다 - 담기면 알림음, 안 되면 거절음. 편집 화면에서 몹 찾기를 켜고 담으면 찾은 것이 라벨로 같이 들어간다." />
        </dxb:MainMenuControl>

        <!-- ── 설정 ────────────────────────────────────────────────── -->
        <dxb:ToolBarControl AllowCustomizationMenu="False"
                            AllowQuickCustomization="False"
                            DockPanel.Dock="Top"
                            TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                            TextBlock.FontSize="{DynamicResource BaseFontSize}">

            <dxb:BarEditItem Content="대상"
                             EditValue="{Binding SelectedTarget}"
                             EditWidth="420"
                             IsEnabled="{Binding IsNotRunning}">
                <dxb:BarEditItem.EditSettings>
                    <dxe:ComboBoxEditSettings DisplayMember="Display"
                                              IsTextEditable="False"
                                              ItemsSource="{Binding Targets}" />
                </dxb:BarEditItem.EditSettings>
            </dxb:BarEditItem>

            <dxb:BarEditItem Content="fps"
                             EditValue="{Binding CaptureTargetFps}"
                             EditWidth="70"
                             ToolTip="캡처 상한(fps). 넘는 프레임은 받지 않는다 - 그만큼 일이 준다.">
                <dxb:BarEditItem.EditSettings>
                    <dxe:ComboBoxEditSettings IsTextEditable="False"
                                              ItemsSource="{Binding FpsOptions}" />
                </dxb:BarEditItem.EditSettings>
            </dxb:BarEditItem>

            <dxb:BarCheckItem Content="CPU 리드백"
                              IsChecked="{Binding EnableCpuReadback}"
                              IsEnabled="{Binding IsNotRunning}"
                              ToolTip="GPU 프레임을 CPU 메모리로 내린다. 프레임 저장·데이터셋에 담기가 필요하면 알아서 켠다." />

            <dxb:BarItemSeparator />

            <dxb:BarCheckItem Content="미리보기"
                              IsChecked="{Binding ShowPreview}"
                              ToolTip="캡처 중인 화면을 그대로 보여 준다." />

            <!-- 미리보기를 켰을 때만. 캡처 화면은 입력 전달이 없어 이 둘만 있으면 된다. -->
            <dxb:BarEditItem Content="갱신 상한"
                             EditValue="{Binding PreviewTargetFps}"
                             EditWidth="70"
                             IsVisible="{Binding ShowPreview}"
                             ToolTip="미리보기 갱신 상한(fps). 캡처 자체는 이 값과 무관하게 계속 돈다.">
                <dxb:BarEditItem.EditSettings>
                    <dxe:ComboBoxEditSettings IsTextEditable="False"
                                              ItemsSource="{Binding FpsOptions}" />
                </dxb:BarEditItem.EditSettings>
            </dxb:BarEditItem>
            <dxb:BarStaticItem Content="{Binding PreviewFpsText, Mode=OneWay}"
                               IsVisible="{Binding ShowPreview}"
                               ToolTip="지금 화면에 올라가고 있는 실제 fps. 왼쪽 값은 상한일 뿐이다." />

            <dxb:BarItemSeparator />

            <dxb:BarCheckItem Content="열 자동 너비"
                              IsChecked="{Binding IsColumnAutoWidth}"
                              ToolTip="통계 열 너비를 내용에 맞춘다. 끄면 직접 조절한 너비가 유지된다." />
        </dxb:ToolBarControl>

        <!-- ── 상태 줄 ─────────────────────────────────────────────────── -->
        <dxe:TextEdit Margin="4,0,4,4"
                      DockPanel.Dock="Bottom"
                      EditValue="{Binding StatusText, Mode=OneWay}"
                      IsReadOnly="True"
                      ShowBorder="False" />

        <!--
            미리보기(위) / 통계 그리드(아래). 통계 표를 마지막 한 줄만 두게 되면서 남는 자리를
            미리보기가 다 쓴다.
        -->
        <dxlc:LayoutControl Margin="4,0,4,4"
                            Padding="0"
                            ItemSpace="0"
                            Orientation="Vertical">

            <dxlc:LayoutGroup VerticalAlignment="Stretch"
                              ItemSpace="0"
                              Orientation="Vertical"
                              View="Group"
                              Visibility="{Binding ShowPreview, Converter={StaticResource BooleanToVisibilityConverter}}">

                <!-- 겹그림 없음. 이 화면은 찾지 않는다. -->
                <parts:CapturePreviewPanel />
            </dxlc:LayoutGroup>

            <!-- 통계는 마지막 1초 한 줄만(MaxRows = 1). 머리글 + 한 줄이 들어갈 높이로 고정한다. -->
            <dxlc:LayoutGroup Height="84"
                              VerticalAlignment="Bottom"
                              ItemSpace="0"
                              Orientation="Vertical"
                              View="Group">

                <!--
                    행 번호 칸(인디케이터) 폭을 행 수에 맞춰 늘리기 위한 틀. TamsTools 와 같은 구성이다.
                    행 번호는 DataTemplate.xaml 의 RowIndicator 템플릿이 그리는데, 그 안의 열이
                    SharedSizeGroup="RowNumberGroup" 에 참여한다. 아래 숨은 Border 를 같은 그룹의
                    열에 두면 Border 가 "가장 넓은 행 번호" 만큼 넓어지고, 그 폭을 TableView 의
                    IndicatorWidth 로 되돌려 준다.
                -->
                <Grid Grid.IsSharedSizeScope="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"
                                          SharedSizeGroup="RowNumberGroup" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 폭만 재는 자리. 눈에 보이지 않는다. Margin 은 셀 여백 보정. -->
                    <Border x:Name="GridRowNumberSizeProxy"
                            Margin="-4"
                            Visibility="Hidden" />

                    <controls:BaseGridControl Grid.Column="0"
                                              Grid.ColumnSpan="2"
                                              dependency:GridControlDependency.IsRowNumber="True"
                                              AutoGenerateColumns="None"
                                              ItemsSource="{Binding Rows}">

                        <dxmvvm:Interaction.Behaviors>
                            <!--
                                열 너비·순서·정렬·필터를 문자열로 뽑고 되돌린다.
                                ViewModel 이 ServiceContainer 에서 이 이름으로 꺼내 쓴다.
                            -->
                            <dxmvvm:LayoutSerializationService x:Name="GridLayoutService" />
                            <dxmvvm:UIObjectService x:Name="GridObjectService" />
                        </dxmvvm:Interaction.Behaviors>

                        <dxg:GridControl.View>
                            <!--
                                행 번호는 항상 켜고, 열 자동 너비는 토글로 둔다.
                                (GridControlDependency 가 언바운드 열을 만들고 너비를 계산해 준다)
                                검색 창은 끈다 - 마지막 한 줄만 보는 표다. 저장된 배치가 이것을 되살리는 것은
                                ViewModel 의 RestoreGridLayout 이 막는다.
                            -->
                            <controls:BaseTableView dependency:GridControlDependency.IsColumnAutoWidth="{Binding IsColumnAutoWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=False}"
                                                    AllowEditing="False"
                                                    IndicatorWidth="{Binding Path=(Border.ActualWidth), ElementName=GridRowNumberSizeProxy, Mode=OneWay}"
                                                    ShowGroupPanel="False"
                                                    ShowSearchPanelMode="Never" />
                        </dxg:GridControl.View>

                        <!-- 행 번호용 숨은 언바운드 열. 왼쪽 인디케이터가 이 값을 쓴다. -->
                        <dxg:GridColumn Style="{StaticResource GridColumn.RowNumber.Style}" />

                        <dxg:GridColumn Width="160" FieldName="Timestamp" Header="시각">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="yyyy-MM-dd HH:mm:ss" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <!--
                            캡처 fps 는 WGC 가 주는 속도, 미리보기 fps 는 그중 화면에 올린 장수다.
                            미리보기 상한을 30 으로 두면 캡처는 60 인데 미리보기만 30 이 된다.
                        -->
                        <dxg:GridColumn Width="80" FieldName="Fps" Header="캡처 fps">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="n0" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Width="90" FieldName="PreviewFps" Header="미리보기 fps">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="n0" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Width="110" FieldName="AvgLatencyMs" Header="지연 평균(ms)">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="n2" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Width="110" FieldName="MaxLatencyMs" Header="지연 최대(ms)">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="n2" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Width="100" FieldName="AvgReadbackMs" Header="리드백(ms)">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="n2" />
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn Width="110" FieldName="Resolution" Header="해상도" />
                        <dxg:GridColumn Width="100" FieldName="FrameId" Header="누적 프레임" />
                        <dxg:GridColumn FieldName="Note" Header="비고" />
                    </controls:BaseGridControl>
                </Grid>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>

    </DockPanel>
</UserControl>
