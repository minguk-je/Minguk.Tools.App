<UserControl x:Class="Minguk.Tools.Views.ScriptStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:controls="clr-namespace:Minguk.Base.Controls;assembly=Minguk.Base"
             xmlns:dependency="clr-namespace:Minguk.Base.Dependency;assembly=Minguk.Base"
             xmlns:image="clr-namespace:Minguk.Image;assembly=Minguk.Image"
             xmlns:markup="clr-namespace:Minguk.Tools.Markup"
             xmlns:parts="clr-namespace:Minguk.Tools.Views.Parts"
             xmlns:regions="clr-namespace:Minguk.Tools.Markup.Regions"
             xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
             xmlns:views="clr-namespace:Minguk.Tools.Views"
             Style="{DynamicResource BaseControlStyle}"
             FontFamily="{DynamicResource BaseFontFamily}"
             FontSize="{DynamicResource BaseFontSize}"
             DataContext="{dxmvvm:ViewModelSource Type={x:Type viewModels:ScriptStudioViewModel}}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type viewModels:ScriptStudioViewModel},
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="700"
             d:DesignWidth="1400">

    <!--
        스크립트 화면 - Visual Studio 2026 모양(docs/스크립트-프로젝트-설계.md).
        
        맨 위 메뉴·도구 모음(BarManager) · 가운데 도킹(DockLayoutManager) · 맨 아래 상태 표시줄.
        도킹: 미리보기(도구 창) | 문서 탭 | 솔루션 탐색기(도구 창), 아래에 오류 목록·출력·호출·변수·영역·중단점(도구 창 탭).
        도구 창은 VS 처럼 핀(자동 숨김)·닫기·끌어 붙이기·떼어 내기가 되고, 닫은 창은 보기 메뉴로 다시 연다.
        배치는 저장·복원한다(창 > 창 레이아웃 다시 설정).
        
        프로젝트를 열지 않았으면 문서 자리에 한 파일짜리 편집기가 뜬다(예전과 같다).
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <dxmvvm:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <dxmvvm:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"
                                                 Inverse="True" />
            <dxmvvm:BooleanNegationConverter x:Key="BooleanNegationConverter" />

            <!-- 편집기 한 벌. 문서 탭(프로젝트)은 문서가 데이터 문맥이고, 공용 설정은 문서가 들고 온 Settings(워크벤치)다. -->
            <DataTemplate x:Key="DocumentEditorTemplate">
                <Border BorderBrush="{Binding Settings.EditorBorder}"
                        BorderThickness="0">
                    <markup:ScriptEditor Background="{Binding Settings.EditorBackground}"
                                         Foreground="{Binding Settings.EditorForeground}"
                                         FontFamily="D2Coding, Consolas, Courier New"
                                         FontSize="13"
                                         markup:AvalonEditText.Text="{Binding Text, Mode=TwoWay}"
                                         Breakpoints="{Binding Breakpoints, Mode=OneWay}"
                                         CaretColumn="{Binding CaretColumn, Mode=OneWayToSource}"
                                         CaretLine="{Binding CaretLine, Mode=OneWayToSource}"
                                         CompletionSource="{Binding Settings.CompletionSource, Mode=OneWay}"
                                         Errors="{Binding Settings.Errors, Mode=OneWay}"
                                         FilePath="{Binding FilePath, Mode=OneWay}"
                                         IsReadOnly="{Binding Settings.IsLocked, Mode=OneWay}"
                                         Language="{Binding Settings.SelectedLanguage, Mode=OneWay}"
                                         LineNumbersForeground="{Binding Settings.EditorLineNumberForeground}"
                                         LineRequest="{Binding LineRequest, Mode=OneWay}"
                                         NavigateCommand="{Binding Settings.NavigateCommand}"
                                         ShowLineNumbers="True"
                                         SyntaxHighlighting="{Binding Settings.Highlighting}"
                                         WordWrap="False" />
                </Border>
            </DataTemplate>

            <!-- 영역 패널 트리 - 자리 줄 밑에 칸 줄(자리와 칸은 형식이 달라 자식 고르기로 묶는다). -->
            <regions:RegionTreeChildren x:Key="RegionTreeChildren" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <!-- 캡처 콜백은 스레드풀에서 돈다. 화면에 닿는 일은 이것으로 넘긴다. -->
        <dxmvvm:DispatcherService />

        <!-- 파일·프로젝트 열기와 저장, 저장 안 한 탭 닫기 묻기. -->
        <dxmvvm:OpenFileDialogService />
        <dxmvvm:SaveFileDialogService />
        <dx:DXMessageBoxService />

        <!-- 설정 값 창 - 실행 설정 줄의 [설정]. 모달이 아니다(게임 옆에 두고 도는 중에도 바꾼다). 플레이 화면과 같다. -->
        <dxmvvm:WindowService x:Name="SettingsWindowService"
                              WindowShowMode="Default"
                              WindowStartupLocation="CenterOwner">
            <dxmvvm:WindowService.ViewTemplate>
                <DataTemplate>
                    <views:PlaySettingsView />
                </DataTemplate>
            </dxmvvm:WindowService.ViewTemplate>
            <dxmvvm:WindowService.WindowStyle>
                <Style TargetType="dx:ThemedWindow">
                    <Setter Property="Width" Value="460" />
                    <Setter Property="Height" Value="600" />
                    <Setter Property="ShowIcon" Value="False" />
                    <Setter Property="ShowInTaskbar" Value="True" />
                    <!-- 최대화는 없다(사용자, 2026-09-17) - 게임 옆에 두는 작은 창이다. 크기는 끌어서 바꾸고 다음에 그 자리·크기로 뜬다. -->
                    <Setter Property="ControlBoxButtonSet" Value="Close, Minimize" />
                </Style>
            </dxmvvm:WindowService.WindowStyle>
        </dxmvvm:WindowService>

        <dxmvvm:EventToCommand Command="{Binding OnInitializedCommand}"
                               EventName="Loaded" />
        <dxmvvm:EventToCommand Command="{Binding OnUnloadedCommand}"
                               EventName="Unloaded" />
    </dxmvvm:Interaction.Behaviors>

    <!--
        BarManager 로 감싼다. 메뉴·상태 표시줄은 독립 컨트롤 그대로고, 도구 모음만 BarManager.Bars 에 두어 끌어 옮긴 자리를
        관리자가 저장·복원한다(BarLayout 설정). 도구 모음은 TamsTools 런처처럼 손잡이를 끌어 줄을 나누거나 합칠 수 있다.
    -->
    <dxb:BarManager>
        <dxmvvm:Interaction.Behaviors>
            <!-- 도구 모음을 끌어 옮긴 자리를 저장·복원한다(BarLayout 설정). 도구 모음마다 x:Name 이 있어야 이름으로 되찾는다. -->
            <dxmvvm:UIObjectService x:Name="BarManagerObjectService" />
        </dxmvvm:Interaction.Behaviors>

        <!--
            도구 모음은 BarManager.Bars 에 두고 위 컨테이너(ContainerType=Top)에 얹는다. 독립 ToolBarControl 로 두면 관리자의 Bars 에
            안 들어가 끌어 옮긴 자리를 저장·복원할 수 없다(실측: 배치 XML 이 빈 껍데기였다).
            VS 처럼 여러 줄이 한 자리에 들어가고 좁아지면 넘치는 것만 접힌다.
        -->
        <!--
            도구 줄은 하는 일 순서로 두 줄(사용자, 2026-09-17 "성격별로"):
            윗줄 = 코드 → 돌리기 : 표준(파일·편집) · 디버그(실행·멈춤·중단점·빌드) · 실행 설정(시작 대기·조준 배율·설정 값 창)
            아랫줄 = 보기        : 캡처(대상 → 시작·중지 → FPS·미리보기 → 담기 → 입력 경로) · 인식(검출)
            한 무리 안에서는 고르는 것 → 켜고 끄는 것 → 값 순서.
            배치를 바꾸면 ScriptStudioViewModel.BarLayoutVersion 을 올린다 - 저장된 옛 자리가 새 배치를 덮는다.
        -->
        <dxb:BarManager.Bars>
            <!-- ── 표준 ── 파일 | 편집 | 언어 -->
            <dxb:Bar x:Name="StandardBar"
                     AllowQuickCustomization="False"
                     Caption="표준">
                <dxb:Bar.DockInfo>
                    <dxb:BarDockInfo ContainerName="ToolbarContainer"
                                     Row="0" />
                </dxb:Bar.DockInfo>
                <dxb:BarButtonItem Command="{Binding Script.Project.NewProjectCommand}"
                                   Glyph="{image:FreeImage ResourceName='axialispureflat/development/16x16/project_csharp.png'}"
                                   Hint="새 프로젝트 (Ctrl+Shift+N)" />
                <dxb:BarButtonItem Command="{Binding Script.Project.OpenProjectCommand}"
                                   Glyph="{image:FreeImage ResourceName='axialis/basic/16x16/folder_open.png'}"
                                   Hint="프로젝트 열기 (Ctrl+Shift+O)" />
                <dxb:BarButtonItem Command="{Binding SaveCommand}"
                                   Glyph="{image:FreeImage ResourceName='axialispureflat/development/16x16/script-save.png'}"
                                   Hint="저장 (Ctrl+S)" />
                <dxb:BarButtonItem Command="{Binding SaveAllCommand}"
                                   Glyph="{image:FreeImage ResourceName='axialispureflat/development/16x16/project-save.png'}"
                                   Hint="모두 저장 (Ctrl+Shift+S)" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem Command="ApplicationCommands.Undo"
                                   Content="↶"
                                   Hint="실행 취소 (Ctrl+Z)" />
                <dxb:BarButtonItem Command="ApplicationCommands.Redo"
                                   Content="↷"
                                   Hint="다시 실행 (Ctrl+Y)" />
                <dxb:BarItemSeparator />
                <!-- 한 파일짜리일 때만. 프로젝트는 C# 이다. -->
                <dxb:BarEditItem Content="언어"
                                 EditValue="{Binding Script.SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 EditWidth="96"
                                 IsVisible="{Binding Script.IsProject, Converter={StaticResource BooleanNegationConverter}}">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:ComboBoxEditSettings IsTextEditable="False"
                                                  ItemsSource="{Binding Script.Languages}" />
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>
                <dxb:BarItemSeparator />
                <!-- 글자 읽기 엔진 - 돌려 보며 견준다(사용자, 2026-09-18). 앱 전체에 하나라 플레이도 같은 것으로 읽는다. -->
                <dxb:BarEditItem Content="글자 읽기"
                                 EditValue="{Binding SelectedOcrEngine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 EditWidth="200"
                                 Hint="글자 읽기 엔진. PP-OCRv5 는 한글·영문·숫자를 손질 없이 읽는다(GPU 는 검출과 GPU 를 나눠 쓴다, CPU 는 그 몫이 없다). PP-OCRv6 는 더 빠르지만 한글이 없다(숫자·영문 HUD 용). Windows 내장 OCR 은 빠르지만 게임 글자에 약하다.">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:ComboBoxEditSettings DisplayMember="Name"
                                                  IsTextEditable="False"
                                                  ItemsSource="{Binding OcrEngines}" />
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>
            </dxb:Bar>

            <!-- ── 실행 설정 ── 돌릴 때 쓰는 값. 시작 대기 | 조준 배율 · 자동 | 설정 값 창 -->
            <dxb:Bar x:Name="InputBar"
                     AllowQuickCustomization="False"
                     Caption="실행 설정">
                <dxb:Bar.DockInfo>
                    <dxb:BarDockInfo ContainerName="ToolbarContainer"
                                     Row="0" />
                </dxb:Bar.DockInfo>
                <dxb:BarEditItem Content="시작 대기(초)"
                                 EditValue="{Binding Player.StartDelaySeconds}"
                                 EditWidth="48"
                                 Hint="이 사이에 대상 창을 앞으로 가져와야 한다. 창을 골라 두었으면 알아서 앞으로 가져온다."
                                 IsEnabled="{Binding Player.IsIdle}">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:SpinEditSettings MaxValue="60"
                                              MinValue="0" />
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>
                <dxb:BarItemSeparator />
                <dxb:BarEditItem Content="조준 배율(%)"
                                 EditValue="{Binding Player.AimScalePercent}"
                                 EditWidth="56"
                                 Hint="조준(x, y) 이 화면 가운데에서 목표까지의 거리에 곱하는 값. 게임 감도마다 다르다.">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:SpinEditSettings MaxValue="2000"
                                              MinValue="1" />
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>
                <dxb:BarCheckItem Content="자동"
                                  Hint="겨눈 결과를 보고 배율을 스스로 맞춘다."
                                  IsChecked="{Binding Player.IsAimScaleAuto}" />
                <dxb:BarItemSeparator />
                <!-- 이 프로젝트의 설정 값(설정 탭에서 만든 칸) - 돌리는 동안 게임 옆에 띄워 두고 바꾼다. 플레이와 같은 창. -->
                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                   Command="{Binding ShowSettingsCommand}"
                                   Content="설정"
                                   Glyph="{image:FreeImage ResourceName='axialis/basic/16x16/gear.png'}"
                                   Hint="이 프로젝트의 설정 값을 창으로 띄웁니다. 도는 중에도 바꾸면 스크립트가 다음에 읽을 때부터 바뀐 값을 씁니다." />
                <!-- 대상이 관리자 권한인데 이 앱은 아닐 때만. 그 창에는 입력도 F5 도 못 닿는다(UIPI). -->
                <dxb:BarButtonItem Command="{Binding RestartAsAdminCommand}"
                                   Content="관리자로 다시 시작"
                                   Hint="{Binding ElevationNote, Mode=OneWay}"
                                   IsVisible="{Binding NeedsElevation, Mode=OneWay}" />
            </dxb:Bar>

            <!-- ── 캡처 ── 대상 | 시작 · 중지 | FPS · 미리보기 | 담기 | 입력 경로 -->
            <dxb:Bar x:Name="CaptureBar"
                     AllowQuickCustomization="False"
                     Caption="캡처">
                <dxb:Bar.DockInfo>
                    <dxb:BarDockInfo ContainerName="ToolbarContainer"
                                     Row="1" />
                </dxb:Bar.DockInfo>
                <dxb:BarEditItem Content="대상"
                                 EditValue="{Binding SelectedTarget}"
                                 EditWidth="200"
                                 IsEnabled="{Binding IsNotRunning}">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:ComboBoxEditSettings DisplayMember="Display"
                                                  IsTextEditable="False"
                                                  ItemsSource="{Binding Targets}" />
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>
                <dxb:BarButtonItem Command="{Binding RefreshTargetsCommand}"
                                   Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/refresh.png'}"
                                   Hint="캡처할 수 있는 창·모니터 목록을 다시 훑는다." />
                <dxb:BarItemSeparator />
                <!-- 글자를 붙인다 - 아이콘만 두었더니 디버그의 "▶ 시작"(스크립트)과 헷갈려 캡처를 못 켰다(실측). -->
                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                   Command="{Binding DoStartCommand}"
                                   Content="캡처 시작"
                                   Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/record-control_play.png'}"
                                   Hint="고른 대상을 잡기 시작한다. 미리보기·검출·글자 읽기·스크립트의 눈이 이것이다." />
                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                   Command="{Binding DoStopCommand}"
                                   Content="캡처 중지"
                                   Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/record-control_stop.png'}"
                                   Hint="캡처를 멈춘다." />
                <dxb:BarCheckItem BarItemDisplayMode="ContentAndGlyph"
                                  Content="캡처 일시정지"
                                  Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/record-control_pause.png'}"
                                  Hint="캡처를 끊지 않고 쉰다 - 미리보기는 마지막 장에 멈추고 검출·계속 읽기를 쉰다(영상 대상은 재생도 멈춘다). 다시 누르면 계속.&#10;도는 스크립트는 멈추지 않는다 - 스크립트는 디버그 도구 모음의 [실행 일시정지]."
                                  IsChecked="{Binding IsCapturePaused, Mode=TwoWay}"
                                  IsEnabled="{Binding IsRunning, Mode=OneWay}" />
                <dxb:BarItemSeparator />
                <dxb:BarEditItem Content="FPS"
                                 EditValue="{Binding CaptureTargetFps}"
                                 EditWidth="60"
                                 Hint="캡처 상한(FPS). 넘는 프레임은 받지 않는다.">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:ComboBoxEditSettings IsTextEditable="False"
                                                  ItemsSource="{Binding FpsOptions}" />
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>
                <!-- CPU 리드백 체크는 뺐다(2026-09-15) - 픽셀이 필요한 일이 그때 알아서 켠다. 확대·맞춤은 미리보기 아래 띠(VS XAML 디자이너처럼). -->
                <dxb:BarCheckItem Content="미리보기"
                                  Hint="캡처 중인 화면을 미리보기 창에 그대로 보여 준다."
                                  IsChecked="{Binding ShowPreview}" />
                <dxb:BarItemSeparator />
                <!-- 게임을 보는 길(캡처) 옆에 게임에 보내는 길 - 플레이 화면과 같은 자리. -->
                <dxb:BarEditItem Content="입력 경로"
                                 EditValue="{Binding SelectedInputBackend}"
                                 EditWidth="120"
                                 Hint="스크립트와 미리보기 입력 전달이 이 경로로 나간다. 게임은 SendInput 이나 Interception.">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:ComboBoxEditSettings IsTextEditable="False"
                                                  ItemsSource="{Binding InputBackends}" />
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                   Command="{Binding CollectFrameCommand}"
                                   Content="담기 (F8)"
                                   Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/add.png'}"
                                   Hint="한 장을 데이터셋에 담는다. 검출이 켜져 있으면 찾은 것이 라벨로 같이 들어간다." />
            </dxb:Bar>

            <!-- ── 인식 ── 검출 · 추적 · 문턱. 글자 읽기 자리는 영역 패널에 있다. -->
            <dxb:Bar x:Name="RecognitionBar"
                     AllowQuickCustomization="False"
                     Caption="인식">
                <dxb:Bar.DockInfo>
                    <dxb:BarDockInfo ContainerName="ToolbarContainer"
                                     Row="2" />
                </dxb:Bar.DockInfo>
                <dxb:BarCheckItem BarItemDisplayMode="ContentAndGlyph"
                                  Content="검출"
                                  Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/search.png'}"
                                  Hint="학습한 모델로 찾아 점선으로 겹쳐 그린다."
                                  IsChecked="{Binding IsDetectionOn}" />
                <dxb:BarCheckItem Content="추적"
                                  BarItemDisplayMode="ContentAndGlyph"
                                  Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/search.png'}"
                                  Hint="프레임 간 추적. 한 프레임짜리 헛것이 사라진다."
                                  IsChecked="{Binding IsTrackingOn}" />
                <dxb:BarEditItem Content="신뢰도(%)"
                                 EditValue="{Binding DetectMinimumScorePercent}"
                                 EditWidth="56"
                                 Hint="검출이 이 점수 아래는 버린다. 헛것을 쫓으면 올리고, 진짜를 놓치면 내린다.">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:SpinEditSettings MaxValue="99"
                                              MinValue="1" />
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>
                <dxb:BarItemSeparator />
            </dxb:Bar>

            <!-- ── 디버그 ── VS 의 "▶ 시작" 자리. 실행 · 실행 일시정지 · 중지 · 한 줄 | 중단점 | 빌드. 인식 줄 뒤(사용자, 2026-09-18). -->
            <dxb:Bar x:Name="DebugBar"
                     AllowQuickCustomization="False"
                     Caption="디버그">
                <dxb:Bar.DockInfo>
                    <dxb:BarDockInfo ContainerName="ToolbarContainer"
                                     Row="2" />
                </dxb:Bar.DockInfo>
                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                   Command="{Binding RunOrContinueCommand}"
                                   Content="실행(F5)"
                                   Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/action_play.png'}"
                                   Hint="스크립트 시작/계속 (F5) - 캡처가 켜져 있어야 검출·글자를 본다.시작 전 대기 뒤 대상 창을 앞으로 가져와 실시간으로 돌린다. 도는 동안 Pause 가 비상 정지다." />
                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                   Command="{Binding Player.StopCommand}"
                                   Content="중지(F6)"
                                   Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/action_stop.png'}"
                                   Hint="디버깅 중지(F6) (Shift+F5 · 게임 안에서는 F6)" />
                <!--
                    실행 일시정지 - 도는 스크립트만 멈춘다. 캡처는 캡처 도구 모음의 「캡처 일시정지」(사용자, 2026-09-17 - 한 단추가 둘 다 멈추니 실행 옆에서 실행용으로만 읽혔다).
                    Pause 키는 비상 정지라 단축키가 아니다.
                -->
                <dxb:BarCheckItem BarItemDisplayMode="ContentAndGlyph"
                                  Content="실행 일시정지"
                                  Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/action_pause.png'}"
                                  Hint="도는 스크립트를 멈춘다 - 다음 호출에서 멈추고 누르고 있던 키를 뗀다. 다시 누르거나 F5 로 계속.&#10;캡처(미리보기·검출)는 캡처 도구 모음의 [캡처 일시정지]."
                                  IsChecked="{Binding IsPaused, Mode=TwoWay}"
                                  IsEnabled="{Binding CanPause, Mode=OneWay}" />
                <dxb:BarButtonItem Command="{Binding StepCommand}"
                                   Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/action_goto_next.png'}"
                                   Hint="프로시저 단위 실행 (F10) - JavaScript·Python 만" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                   Command="{Binding ToggleBreakpointCommand}"
                                   Content="중단점"
                                   Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/flag_red.png'}"
                                   Hint="중단점 설정/해제 (F9)" />
                <dxb:BarItemSeparator />
                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                   Command="{Binding BuildCommand}"
                                   Content="빌드"
                                   Glyph="{image:FreeImage ResourceName='axialispureflat/development/16x16/project-save.png'}"
                                   Hint="프로젝트를 .NET DLL(.mtsx)로 빌드 (Ctrl+Shift+B) - 소스 없이 플레이어에서 실행만 하는 파일을 만듭니다." />
                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                   Command="{Binding BuildAllCommand}"
                                   Content="전체 빌드"
                                   Glyph="{image:FreeImage ResourceName='axialispureflat/development/16x16/project-save.png'}"
                                   Hint="솔루션의 프로젝트를 모두 저장하고 하나씩 빌드합니다. 시작 파일이 없는(공유) 프로젝트는 건너뜁니다." />
            </dxb:Bar>
        </dxb:BarManager.Bars>

        <DockPanel LastChildFill="True">

            <!-- ══ 메뉴 ═══════════════════════════════════════════════════════════════ -->
            <dxb:MainMenuControl AllowCustomizationMenu="False"
                                 DockPanel.Dock="Top"
                                 TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                                 TextBlock.FontSize="{DynamicResource BaseFontSize}">

                <!-- ── 파일 ── -->
                <dxb:BarSubItem Content="파일(_F)">
                    <dxb:BarSubItem Content="새로 만들기(_N)">
                        <dxb:BarButtonItem Command="{Binding Script.Project.NewProjectCommand}"
                                           Content="프로젝트(_P)..."
                                           Glyph="{image:FreeImage ResourceName='axialispureflat/development/16x16/project_csharp.png'}"
                                           KeyGesture="Ctrl+Shift+N" />
                        <dxb:BarButtonItem Command="{Binding Script.NewCommand}"
                                           Content="스크립트 파일(_F)"
                                           Glyph="{image:FreeImage ResourceName='axialispureflat/development/16x16/file_csharp.png'}"
                                           IsEnabled="{Binding Script.IsProject, Converter={StaticResource BooleanNegationConverter}}" />
                    </dxb:BarSubItem>
                    <dxb:BarSubItem Content="열기(_O)">
                        <dxb:BarButtonItem Command="{Binding Script.Project.OpenProjectCommand}"
                                           Content="프로젝트(_P)..."
                                           Glyph="{image:FreeImage ResourceName='axialis/basic/16x16/folder_open.png'}"
                                           KeyGesture="Ctrl+Shift+O" />
                        <dxb:BarButtonItem Command="{Binding Script.OpenCommand}"
                                           Content="스크립트 파일(_F)..."
                                           IsEnabled="{Binding Script.IsProject, Converter={StaticResource BooleanNegationConverter}}"
                                           KeyGesture="Ctrl+O" />
                    </dxb:BarSubItem>
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Command="{Binding CloseDocumentCommand}"
                                       Content="닫기(_C)"
                                       KeyGesture="Ctrl+F4" />
                    <dxb:BarButtonItem Command="{Binding Script.Project.CloseProjectCommand}"
                                       Content="프로젝트 닫기(_T)" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Command="{Binding SaveCommand}"
                                       Content="저장(_S)"
                                       Glyph="{image:FreeImage ResourceName='axialispureflat/development/16x16/script-save.png'}"
                                       KeyGesture="Ctrl+S" />
                    <dxb:BarButtonItem Command="{Binding SaveAsCommand}"
                                       Content="다른 이름으로 저장(_A)..." />
                    <dxb:BarButtonItem Command="{Binding SaveAllCommand}"
                                       Content="모두 저장(_L)"
                                       Glyph="{image:FreeImage ResourceName='axialispureflat/development/16x16/project-save.png'}"
                                       KeyGesture="Ctrl+Shift+S" />
                </dxb:BarSubItem>

                <!-- ── 편집 ── 편집기가 알아서 받는 명령이다(포커스 있는 곳으로 간다). -->
                <dxb:BarSubItem Content="편집(_E)">
                    <dxb:BarButtonItem Command="ApplicationCommands.Undo"
                                       Content="실행 취소(_U)" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Redo"
                                       Content="다시 실행(_R)" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Command="ApplicationCommands.Cut"
                                       Content="잘라내기(_T)" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Copy"
                                       Content="복사(_C)" />
                    <dxb:BarButtonItem Command="ApplicationCommands.Paste"
                                       Content="붙여넣기(_P)" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Command="ApplicationCommands.SelectAll"
                                       Content="모두 선택(_A)" />
                </dxb:BarSubItem>

                <!-- ── 보기 ── 닫은 도구 창을 다시 연다. -->
                <dxb:BarSubItem Content="보기(_V)">
                    <dxb:BarButtonItem Command="{Binding ShowToolWindowCommand}"
                                       CommandParameter="SolutionExplorerPanel"
                                       Content="솔루션 탐색기(_P)"
                                       Glyph="{image:FreeImage ResourceName='axialispureflat/development/16x16/project_csharp.png'}"
                                       KeyGesture="Ctrl+Alt+L" />
                    <dxb:BarButtonItem Command="{Binding ShowToolWindowCommand}"
                                       CommandParameter="PreviewPanel"
                                       Content="미리보기(_W)" />
                    <dxb:BarSubItem Content="미리보기 나누기(_S)">
                        <dxb:BarButtonItem Command="{Binding SplitVerticalCommand}"
                                           Content="위아래(_V)" />
                        <dxb:BarButtonItem Command="{Binding SplitHorizontalCommand}"
                                           Content="좌우(_H)" />
                        <dxb:BarButtonItem Command="{Binding SwapPanesCommand}"
                                           Content="자리 바꾸기(_W)" />
                    </dxb:BarSubItem>
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Command="{Binding ShowToolWindowCommand}"
                                       CommandParameter="ErrorListPanel"
                                       Content="오류 목록(_I)" />
                    <dxb:BarButtonItem Command="{Binding ShowToolWindowCommand}"
                                       CommandParameter="OutputPanel"
                                       Content="출력(_O)"
                                       KeyGesture="Ctrl+Alt+O" />
                    <dxb:BarButtonItem Command="{Binding ShowToolWindowCommand}"
                                       CommandParameter="CallsPanel"
                                       Content="호출(_A)" />
                    <dxb:BarButtonItem Command="{Binding ShowToolWindowCommand}"
                                       CommandParameter="VariablesPanel"
                                       Content="변수(_V)" />
                    <dxb:BarButtonItem Command="{Binding ShowToolWindowCommand}"
                                       CommandParameter="RegionsPanel"
                                       Content="영역(_R)" />
                    <dxb:BarButtonItem Command="{Binding ShowToolWindowCommand}"
                                       CommandParameter="BreakpointsPanel"
                                       Content="중단점(_B)" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Command="{Binding ShowToolWindowCommand}"
                                       CommandParameter="HelpPanel"
                                       Content="도움말(_H)"
                                       KeyGesture="F1" />
                </dxb:BarSubItem>

                <!-- ── 프로젝트 ── -->
                <dxb:BarSubItem Content="프로젝트(_P)">
                    <dxb:BarButtonItem Command="{Binding Script.Project.AddNewFileCommand}"
                                       Content="새 항목 추가(_W)..."
                                       Glyph="{image:FreeImage ResourceName='axialispureflat/development/16x16/file_csharp.png'}"
                                       KeyGesture="Ctrl+Shift+A" />
                    <dxb:BarButtonItem Command="{Binding Script.Project.AddExistingCommand}"
                                       Content="기존 항목 추가(_G)..."
                                       Glyph="{image:FreeImage ResourceName='axialispureflat/basic/16x16/folder-upload.png'}"
                                       KeyGesture="Shift+Alt+A" />
                    <dxb:BarButtonItem Command="{Binding Script.Project.AddFolderCommand}"
                                       Content="새 폴더(_D)"
                                       Glyph="{image:FreeImage ResourceName='axialis/basic/16x16/folder.png'}" />
                    <dxb:BarButtonItem Command="{Binding Script.Project.AddProjectReferenceCommand}"
                                       Content="공유 프로젝트 참조 추가(_S)..."
                                       Hint="같은 솔루션의 공유 프로젝트를 뭅니다. 그 소스가 이 프로젝트와 같이 컴파일·빌드됩니다." />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Command="{Binding Script.Project.SetEntryCommand}"
                                       Content="시작 파일로 설정(_A)" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Command="{Binding BuildCommand}"
                                       Content="빌드(_B)"
                                       Glyph="{image:FreeImage ResourceName='axialispureflat/development/16x16/project-save.png'}"
                                       Hint="프로젝트를 .NET DLL(.mtsx)로 빌드합니다. 소스가 아니라 IL 이라 플레이어에서 실행만 합니다."
                                       KeyGesture="Ctrl+Shift+B" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Command="{Binding ShowSettingsCommand}"
                                       Content="설정 값(_V)..."
                                       Glyph="{image:FreeImage ResourceName='axialis/basic/16x16/gear.png'}"
                                       Hint="이 프로젝트의 설정 값을 창으로 띄웁니다." />
                    <dxb:BarButtonItem Command="{Binding Script.Project.OpenFolderInExplorerCommand}"
                                       Content="파일 탐색기에서 폴더 열기(_X)" />
                </dxb:BarSubItem>

                <!-- ── 디버그 ── F5·F6·F10 은 게임 안에서도 먹게 전역으로도 쥔다. -->
                <dxb:BarSubItem Content="디버그(_D)">
                    <dxb:BarButtonItem Command="{Binding RunOrContinueCommand}"
                                       Content="시작/계속(_S)"
                                       Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/action_play.png'}"
                                       KeyGesture="F5" />
                    <dxb:BarCheckItem Content="실행 일시정지(_K)"
                                      Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/action_pause.png'}"
                                      IsChecked="{Binding IsPaused, Mode=TwoWay}"
                                      IsEnabled="{Binding CanPause, Mode=OneWay}" />
                    <dxb:BarButtonItem Command="{Binding Player.StopCommand}"
                                       Content="디버깅 중지(_E)"
                                       Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/action_stop.png'}"
                                       KeyGesture="Shift+F5" />
                    <dxb:BarButtonItem Command="{Binding StepCommand}"
                                       Content="프로시저 단위 실행(_O)"
                                       Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/action_goto_next.png'}"
                                       KeyGesture="F10" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Command="{Binding ToggleBreakpointCommand}"
                                       Content="중단점 설정/해제(_B)"
                                       Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/flag_red.png'}"
                                       KeyGesture="F9" />
                    <dxb:BarItemSeparator />
                    <dxb:BarStaticItem Content="비상 정지: Pause (도는 동안)" />
                </dxb:BarSubItem>

                <!-- ── 캡처 ── 이 앱에만 있는 것. -->
                <dxb:BarSubItem Content="캡처(_C)">
                    <dxb:BarButtonItem Command="{Binding RefreshTargetsCommand}"
                                       Content="대상 새로 고침(_R)"
                                       Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/refresh.png'}" />
                    <dxb:BarButtonItem Command="{Binding DoStartCommand}"
                                       Content="캡처 시작(_S)"
                                       Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/record-control_play.png'}" />
                    <dxb:BarButtonItem Command="{Binding DoStopCommand}"
                                       Content="캡처 중지(_T)"
                                       Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/record-control_stop.png'}" />
                    <dxb:BarCheckItem Content="캡처 일시정지(_P)"
                                      Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/record-control_pause.png'}"
                                      IsChecked="{Binding IsCapturePaused, Mode=TwoWay}"
                                      IsEnabled="{Binding IsRunning, Mode=OneWay}" />
                    <dxb:BarItemSeparator />
                    <dxb:BarButtonItem Command="{Binding CollectFrameCommand}"
                                       Content="데이터셋에 담기(_C)"
                                       Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/add.png'}" />
                    <dxb:BarButtonItem Command="{Binding ClickDetectionCommand}"
                                       Content="찾은 것 누르기(_K)"
                                       Glyph="{image:FreeImage ResourceName='Axialis/HardwareNetwork/16x16/mouse.png'}" />
                </dxb:BarSubItem>

                <!-- ── 창 ── -->
                <dxb:BarSubItem Content="창(_W)">
                    <dxb:BarButtonItem Command="{Binding ResetLayoutCommand}"
                                       Content="창 레이아웃 다시 설정(_R)" />
                </dxb:BarSubItem>
            </dxb:MainMenuControl>

            <!--
                ══ 도구 모음 자리 ═══ 도구 모음 자체는 위 BarManager.Bars 에 있고 BarDockInfo.ContainerName 으로 여기 붙는다.
                ContainerType=Top 으로만 두면 BarManager 제 위쪽 자리(메뉴보다 위)에 붙어 도구 모음이 메뉴 위에 그려졌다(실측).
            -->
            <dxb:BarContainerControl x:Name="ToolbarContainer"
                                     ContainerType="Top"
                                     DockPanel.Dock="Top"
                                     TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                                     TextBlock.FontSize="{DynamicResource BaseFontSize}" />

            <!--
                ══ 상태 표시줄 ═══════════════════════════════════════════════════════
                VS 처럼 왼쪽에 상태 글, 오른쪽에 줄·열 · 오류 수 · 인식 상태 · 입력 경로.
            -->
            <dxb:StatusBarControl AllowCustomizationMenu="False"
                                  DockPanel.Dock="Bottom"
                                  TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                                  TextBlock.FontSize="{DynamicResource BaseFontSize}">
                <dxb:BarStaticItem AutoSizeMode="Fill"
                                   Content="{Binding StatusText, Mode=OneWay}"
                                   ShowBorder="False" />
                <dxb:BarStaticItem Alignment="Far"
                                   Content="{Binding DetectionStatus, Mode=OneWay}"
                                   ShowBorder="False" />
                <dxb:BarStaticItem Alignment="Far"
                                   Content="{Binding OcrStatus, Mode=OneWay}"
                                   ShowBorder="False" />
                <dxb:BarStaticItem Alignment="Far"
                                   Content="{Binding Script.Project.ActiveDocument.CaretLine, Mode=OneWay}"
                                   IsVisible="{Binding Script.IsProject, Mode=OneWay}"
                                   ShowBorder="False">
                    <dxb:BarStaticItem.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='줄: {0}'}" />
                        </DataTemplate>
                    </dxb:BarStaticItem.ContentTemplate>
                </dxb:BarStaticItem>
                <dxb:BarStaticItem Alignment="Far"
                                   Content="{Binding Script.Project.ActiveDocument.CaretColumn, Mode=OneWay}"
                                   IsVisible="{Binding Script.IsProject, Mode=OneWay}"
                                   ShowBorder="False">
                    <dxb:BarStaticItem.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='열: {0}'}" />
                        </DataTemplate>
                    </dxb:BarStaticItem.ContentTemplate>
                </dxb:BarStaticItem>
                <dxb:BarStaticItem Alignment="Far"
                                   BarItemDisplayMode="ContentAndGlyph"
                                   Content="{Binding Script.Errors.Count, Mode=OneWay}"
                                   Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/flag_red.png'}"
                                   ShowBorder="False">
                    <dxb:BarStaticItem.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='오류 {0}'}" />
                        </DataTemplate>
                    </dxb:BarStaticItem.ContentTemplate>
                </dxb:BarStaticItem>
                <dxb:BarStaticItem Alignment="Far"
                                   Content="{Binding SelectedInputBackend, Mode=OneWay}"
                                   ShowBorder="False" />
            </dxb:StatusBarControl>

            <!-- ══ 도킹 ══════════════════════════════════════════════════════════════ -->
            <dxdo:DockLayoutManager ClosedPanelsBarVisibility="Never"
                                    ClosingBehavior="HideToClosedPanelsCollection"
                                    FloatingMode="Desktop">
                <dxmvvm:Interaction.Behaviors>
                    <dxmvvm:UIObjectService x:Name="DockObjectService" />
                    <markup:ScriptDocumentsBehavior Workspace="{Binding Script.Project}" />
                </dxmvvm:Interaction.Behaviors>

                <dxdo:LayoutGroup Orientation="Vertical">

                    <!-- 솔루션 탐색기(왼쪽) | 미리보기 · 문서 -->
                    <dxdo:LayoutGroup Orientation="Horizontal">

                        <!-- ── 솔루션 탐색기 ── -->
                        <dxdo:TabbedGroup ItemWidth="280">
                            <dxdo:LayoutPanel x:Name="SolutionExplorerPanel"
                                              Caption="솔루션 탐색기">
                                <DockPanel>
                                    <dxb:ToolBarControl AllowCustomizationMenu="False"
                                                        AllowQuickCustomization="False"
                                                        DockPanel.Dock="Top"
                                                        ShowBackground="False">
                                        <dxb:BarButtonItem Command="{Binding Script.Project.AddNewFileCommand}"
                                                           Glyph="{image:FreeImage ResourceName='axialispureflat/development/16x16/file_csharp.png'}"
                                                           Hint="새 항목 추가 (Ctrl+Shift+A)" />
                                        <dxb:BarButtonItem Command="{Binding Script.Project.AddFolderCommand}"
                                                           Glyph="{image:FreeImage ResourceName='axialis/basic/16x16/folder.png'}"
                                                           Hint="새 폴더" />
                                        <dxb:BarButtonItem Command="{Binding Script.Project.AddExistingCommand}"
                                                           Glyph="{image:FreeImage ResourceName='axialispureflat/basic/16x16/folder-upload.png'}"
                                                           Hint="기존 항목 추가 (Shift+Alt+A) - 파일을 끌어다 놓아도 된다" />
                                        <dxb:BarItemSeparator />
                                        <dxb:BarButtonItem Command="{Binding Script.Project.SaveAllCommand}"
                                                           Glyph="{image:FreeImage ResourceName='axialispureflat/development/16x16/project-save.png'}"
                                                           Hint="모두 저장" />
                                    </dxb:ToolBarControl>

                                    <!--
                                        뺀 것(사용자, 2026-09-15): 프로젝트 제목 줄(트리 첫 줄에 같은 이름이 있다), 프로젝트가 없을 때의
                                        "새 프로젝트 만들기·프로젝트 열기" 버튼(위 도구 모음·파일 메뉴에 같은 것이 있다).
                                    -->

                                    <controls:BaseGridControl AutoGenerateColumns="None"
                                                              ItemsSource="{Binding Script.Project.Nodes}"
                                                              SelectedItem="{Binding Script.Project.SelectedNode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectionMode="None">
                                        <dxmvvm:Interaction.Behaviors>
                                            <markup:ProjectTreeBehavior Workspace="{Binding Script.Project}" />
                                        </dxmvvm:Interaction.Behaviors>

                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn AllowEditing="True" FieldName="Name">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <dxe:TextEdit x:Name="PART_Editor">
                                                            <dxe:TextEdit.Style>
                                                                <Style TargetType="dxe:TextEdit">
                                                                    <Style.Triggers>
                                                                        <!-- VS 처럼 시작 파일·시작 프로젝트 줄만 굵게(IsEntry), 다른 프로젝트는 그대로. 디스크에 없는 것은 흐리게. -->
                                                                        <DataTrigger Binding="{Binding RowData.Row.IsEntry}"
                                                                                     Value="True">
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RowData.Row.IsMissing}"
                                                                                     Value="True">
                                                                            <Setter Property="Opacity" Value="0.5" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </dxe:TextEdit.Style>
                                                        </dxe:TextEdit>
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                        </dxg:GridControl.Columns>

                                        <dxg:GridControl.View>
                                            <!-- 펼침은 ProjectTreeBehavior 가 기억대로(기본 펼침) - 전부 펼침(AutoExpandAllNodes)이면 접어 둔 것이 다시 펴졌다. -->
                                            <controls:BaseTreeListView AllowEditing="True"
                                                                       AutoExpandAllNodes="False"
                                                                       AutoWidth="True"
                                                                       EditorShowMode="MouseUpFocused"
                                                                       ImageFieldName="Glyph"
                                                                       KeyFieldName="Id"
                                                                       ParentFieldName="ParentId"
                                                                       ShowColumnHeaders="False"
                                                                       ShowNodeImages="True"
                                                                       ShowSearchPanelMode="Never"
                                                                       TreeDerivationMode="Selfreference"
                                                                       UseEvenRowBackground="False">
                                                <!-- VS 의 오른쪽 메뉴. 메뉴 항목의 데이터 문맥은 셀 정보라 View.DataContext 로 화면 VM 에 닿는다. -->
                                                <dxg:TreeListView.RowCellMenuCustomizations>
                                                    <dxb:BarButtonItem Command="{Binding View.DataContext.Script.Project.OpenNodeCommand}"
                                                                       Content="열기(_O)" />
                                                    <!-- 솔루션의 다른 프로젝트 줄에서만 켜진다 - 그 프로젝트로 넘어가 파일을 더하고 지운다. -->
                                                    <dxb:BarButtonItem Command="{Binding View.DataContext.Script.Project.EditProjectCommand}"
                                                                       Content="이 프로젝트 편집(_E)" />
                                                    <dxb:BarItemSeparator />
                                                    <!-- 솔루션 줄은 전체 빌드, 프로젝트 줄(지금 연 것·다른 프로젝트 모두)은 그 하나만 빌드. -->
                                                    <dxb:BarButtonItem Command="{Binding View.DataContext.BuildAllCommand}"
                                                                       Content="전체 빌드(_A)" />
                                                    <dxb:BarButtonItem Command="{Binding View.DataContext.BuildProjectNodeCommand}"
                                                                       Content="빌드(_B)" />
                                                    <dxb:BarItemSeparator />
                                                    <dxb:BarSubItem Content="추가(_D)">
                                                        <dxb:BarButtonItem Command="{Binding View.DataContext.Script.Project.AddNewFileCommand}"
                                                                           Content="새 항목(_W)..."
                                                                           KeyGesture="Ctrl+Shift+A" />
                                                        <dxb:BarButtonItem Command="{Binding View.DataContext.Script.Project.AddExistingCommand}"
                                                                           Content="기존 항목(_G)..."
                                                                           KeyGesture="Shift+Alt+A" />
                                                        <dxb:BarButtonItem Command="{Binding View.DataContext.Script.Project.AddFolderCommand}"
                                                                           Content="새 폴더(_D)" />
                                                        <dxb:BarItemSeparator />
                                                        <dxb:BarButtonItem Command="{Binding View.DataContext.Script.Project.AddProjectReferenceCommand}"
                                                                           Content="공유 프로젝트 참조(_S)..." />
                                                    </dxb:BarSubItem>
                                                    <dxb:BarButtonItem Command="{Binding View.DataContext.Script.Project.SetEntryCommand}"
                                                                       Content="시작 파일로 설정(_A)" />
                                                    <dxb:BarItemSeparator />
                                                    <dxb:BarButtonItem Command="{Binding View.DataContext.Script.Project.ExcludeCommand}"
                                                                       Content="프로젝트에서 제외(_J)" />
                                                    <dxb:BarButtonItem Command="{Binding View.DataContext.Script.Project.DeleteCommand}"
                                                                       Content="삭제(_D)"
                                                                       KeyGesture="Delete" />
                                                    <dxb:BarButtonItem Command="{Binding View.DataContext.Script.Project.RenameCommand}"
                                                                       Content="이름 바꾸기(_M)"
                                                                       KeyGesture="F2" />
                                                    <dxb:BarItemSeparator />
                                                    <dxb:BarButtonItem Command="{Binding View.DataContext.Script.Project.OpenFolderInExplorerCommand}"
                                                                       Content="파일 탐색기에서 폴더 열기(_X)" />
                                                </dxg:TreeListView.RowCellMenuCustomizations>
                                            </controls:BaseTreeListView>
                                        </dxg:GridControl.View>
                                    </controls:BaseGridControl>
                                </DockPanel>
                            </dxdo:LayoutPanel>
                            <!--
                                ── 도움말 ── 스크립트 사용법과 부를 수 있는 함수 전부(사용자, 2026-09-15). 솔루션 탐색기·영역과 같은 탭 그룹.
                                내용은 ScriptHelp.Rows - 함수 줄은 ScriptApiCatalog(완성 목록과 같은 표)에서 뽑는다. 위 검색 칸으로 찾고, 고르면 아래에 설명·예시.
                            -->
                            <dxdo:LayoutPanel x:Name="HelpPanel"
                                              Caption="도움말">
                                <DockPanel>
                                    <!-- 고른 줄의 설명·예시. 좁은 패널이라 칸에 다 못 넣어 아래에 편다(VS 개체 브라우저의 아래 칸). -->
                                    <DockPanel DockPanel.Dock="Bottom">
                                        <dxe:TextEdit FontWeight="Bold"
                                                      DockPanel.Dock="Top"
                                                      EditValue="{Binding SelectedHelpRow.Title, Mode=OneWay}"
                                                      IsReadOnly="True"
                                                      ShowBorder="False" />
                                        <dxe:TextEdit MaxHeight="140"
                                                      VerticalContentAlignment="Top"
                                                      AcceptsReturn="True"
                                                      DockPanel.Dock="Top"
                                                      EditValue="{Binding SelectedHelpRow.Summary, Mode=OneWay}"
                                                      IsReadOnly="True"
                                                      ShowBorder="False"
                                                      TextWrapping="Wrap"
                                                      VerticalScrollBarVisibility="Auto" />
                                        <dxe:TextEdit MaxHeight="180"
                                                      Margin="0,2,0,0"
                                                      VerticalContentAlignment="Top"
                                                      FontFamily="D2Coding, Consolas, Courier New"
                                                      AcceptsReturn="True"
                                                      EditValue="{Binding SelectedHelpRow.Example, Mode=OneWay}"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      IsReadOnly="True"
                                                      TextWrapping="NoWrap"
                                                      ToolTip="예시 - 골라서 Ctrl+C 로 복사한다."
                                                      VerticalScrollBarVisibility="Auto"
                                                      Visibility="{Binding SelectedHelpRow.HasExample, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                                    </DockPanel>

                                    <controls:BaseGridControl AutoExpandAllGroups="True"
                                                              AutoGenerateColumns="None"
                                                              ItemsSource="{Binding HelpRows}"
                                                              SelectedItem="{Binding SelectedHelpRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn FieldName="Group" GroupIndex="0" Header="분류" />
                                            <dxg:GridColumn Width="*" FieldName="Name" Header="이름" />
                                            <!-- 설명·영문은 검색에만 쓴다(패널이 좁아 칸으로는 안 보인다). 보이는 곳은 아래 칸. -->
                                            <dxg:GridColumn FieldName="Summary" Header="설명" Visible="False" />
                                            <dxg:GridColumn FieldName="English" Header="영문" Visible="False" />
                                        </dxg:GridControl.Columns>
                                        <dxg:GridControl.View>
                                            <controls:BaseTableView AllowEditing="False"
                                                                    AutoWidth="True"
                                                                    SearchColumns="Name;Summary;English"
                                                                    ShowColumnHeaders="False"
                                                                    ShowGroupPanel="False"
                                                                    ShowGroupedColumns="False"
                                                                    ShowSearchPanelMode="Always" />
                                        </dxg:GridControl.View>
                                    </controls:BaseGridControl>
                                </DockPanel>
                            </dxdo:LayoutPanel>

                        </dxdo:TabbedGroup>

                        <!--
                            미리보기 | 문서 - VS 의 XAML 디자이너처럼 좌우(기본)·위아래로 나누고 자리를 바꿀 수 있다
                            (미리보기 판 아래 띠의 버튼, 보기 메뉴). 방향·순서는 도킹 배치에 같이 저장된다.
                            솔루션 탐색기는 이 그룹 밖이다 - 안에 두면 자리 바꾸기·위아래 나누기에 같이 딸려 간다.
                        -->
                        <dxdo:LayoutGroup x:Name="DesignSplitGroup"
                                          Orientation="Horizontal">

                            <!-- ── 미리보기 ── 잡은 화면. 검출·이름 붙인 자리(계속 읽는 자리는 읽은 글자까지)를 겹쳐 그린다. -->
                            <dxdo:LayoutPanel x:Name="PreviewPanel"
                                              Caption="미리보기"
                                              ItemHeight="1*"
                                              ItemWidth="1.2*">
                                <DockPanel>
                                    <!--
                                        미리보기를 켰을 때만: 확대 · 맞춤 · 실제 FPS · 입력 전달 · 요소 검사 · 클릭 후 돌아오기 ·
                                        나누기(위아래·좌우)·자리 바꾸기(SupportsPreviewSplit, 2026-09-18 에 이 도구 줄로 옮겼다 -
                                        전엔 판 아래 따로 띠가 있었다). 이름 붙인 자리는 영역 패널 한 곳에 있다(2026-09-15).
                                    -->
                                    <parts:PreviewForwardBar DockPanel.Dock="Top" />

                                    <!-- 비어 있으면 할 일을 말한다. 빈 창만 보이면 무엇을 눌러야 할지 모른다(실측 - 캡처 시작을 못 찾았다). -->
                                    <dxe:TextEdit Margin="8"
                                                  DockPanel.Dock="Top"
                                                  EditValue="{Binding PreviewHint, Mode=OneWay}"
                                                  IsReadOnly="True"
                                                  ShowBorder="False"
                                                  TextWrapping="Wrap"
                                                  Visibility="{Binding PreviewHint, Converter={dxmvvm:StringToVisibilityConverter}}" />

                                    <parts:CapturePreviewPanel Visibility="{Binding ShowPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <parts:CapturePreviewPanel.Overlay>
                                            <markup:DetectionOverlay Detections="{Binding Detections}"
                                                                     IsRegionEditing="{Binding IsRegionEditingActive}"
                                                                     RegionDraft="{Binding RegionDraft}"
                                                                     Regions="{Binding Regions}"
                                                                     RegionsRevision="{Binding RegionsRevision}"
                                                                     SelectedRegion="{Binding SelectedRegion}"
                                                                     ShowRegions="{Binding IsRegionVisible}"
                                                                     Source="{Binding PreviewImage}"
                                                                     Zoom="{Binding PreviewZoom}" />
                                        </parts:CapturePreviewPanel.Overlay>
                                        <!--
                                            자리 편집기 - 자리마다 Thumb 손잡이, 고른 것에 테두리·손잡이 어도너.
                                            영역 보기가 켜져 있고 입력 전달이 꺼져 있으면 돈다(IsRegionEditingActive, 2026-09-15). 빈 자리 끌기는 새 자리.
                                        -->
                                        <parts:CapturePreviewPanel.Editor>
                                            <regions:RegionCanvas CellEditCommand="{Binding CellEditCommand}"
                                                                  EditCommand="{Binding RegionEditCommand}"
                                                                  IsEditing="{Binding IsRegionEditingActive}"
                                                                  Regions="{Binding Regions}"
                                                                  RegionsRevision="{Binding RegionsRevision}"
                                                                  SelectedCell="{Binding SelectedCell, Mode=TwoWay}"
                                                                  SelectedRegion="{Binding SelectedRegion, Mode=TwoWay}"
                                                                  Source="{Binding PreviewImage}"
                                                                  Zoom="{Binding PreviewZoom}" />
                                        </parts:CapturePreviewPanel.Editor>
                                    </parts:CapturePreviewPanel>
                                </DockPanel>
                            </dxdo:LayoutPanel>

                            <!--
                                ── 문서 탭(프로젝트) ── 파일마다 탭. 저장 안 한 것은 제목 뒤 *.
                                닫기 × 는 탭마다(사용자, 2026-09-15 - 그룹 오른쪽 끝 하나였다). 누르면 ScriptDocumentsBehavior 가 받아 작업 공간이 닫는다(저장 안 했으면 묻는다).
                                탭이 넘치면 여러 줄로 쌓는다 - VS 의 "여러 행 탭"(사용자, 2026-09-19).
                            -->
                            <dxdo:DocumentGroup x:Name="ProjectDocumentGroup"
                                                ClosePageButtonShowMode="InAllTabPageHeaders"
                                                DestroyOnClosingChildren="False"
                                                ItemContentTemplate="{StaticResource DocumentEditorTemplate}"
                                                ItemHeight="1*"
                                                ItemWidth="1.4*"
                                                ItemsSource="{Binding Script.Project.Documents}"
                                                ShowWhenEmpty="True"
                                                TabHeaderLayoutType="MultiLine"
                                                Visibility="{Binding Script.IsProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <dxdo:DocumentGroup.ItemStyle>
                                    <Style TargetType="dxdo:DocumentPanel">
                                        <Setter Property="Caption" Value="{Binding Title}" />
                                        <Setter Property="ToolTip" Value="{Binding FilePath}" />
                                    </Style>
                                </dxdo:DocumentGroup.ItemStyle>
                            </dxdo:DocumentGroup>

                            <!-- ── 문서(한 파일짜리) ── 프로젝트를 안 열었을 때. -->
                            <dxdo:DocumentGroup x:Name="SingleDocumentGroup"
                                                DestroyOnClosingChildren="False"
                                                ItemHeight="1*"
                                                ItemWidth="1.4*"
                                                Visibility="{Binding Script.IsProject, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <dxdo:DocumentPanel x:Name="SingleDocumentPanel"
                                                    AllowClose="False"
                                                    Caption="{Binding Script.FileLabel, Mode=OneWay}">
                                    <DockPanel>
                                        <!-- 파이썬은 처음 고를 때 11MB 를 받아 온다. 멈춘 것처럼 보이지 않게 적는다. -->
                                        <dxe:TextEdit DockPanel.Dock="Top"
                                                      EditValue="{Binding Script.EngineStatus, Mode=OneWay}"
                                                      IsReadOnly="True"
                                                      Visibility="{Binding Script.HasEngineStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <markup:ScriptEditor Background="{Binding Script.EditorBackground}"
                                                             Foreground="{Binding Script.EditorForeground}"
                                                             FontFamily="D2Coding, Consolas, Courier New"
                                                             FontSize="13"
                                                             markup:AvalonEditText.Text="{Binding Script.Text, Mode=TwoWay}"
                                                             Breakpoints="{Binding Live.Debug.Breakpoints, Mode=OneWay}"
                                                             CaretColumn="{Binding SingleCaretColumn, Mode=OneWayToSource}"
                                                             CaretLine="{Binding SingleCaretLine, Mode=OneWayToSource}"
                                                             CompletionSource="{Binding Script.CompletionSource, Mode=OneWay}"
                                                             CurrentLine="{Binding Live.Debug.PausedLine, Mode=OneWay}"
                                                             Errors="{Binding Script.Errors, Mode=OneWay}"
                                                             IsReadOnly="{Binding Script.IsLocked}"
                                                             Language="{Binding Script.SelectedLanguage, Mode=OneWay}"
                                                             LineNumbersForeground="{Binding Script.EditorLineNumberForeground}"
                                                             LineRequest="{Binding Script.LineRequest, Mode=OneWay}"
                                                             NavigateCommand="{Binding Script.NavigateCommand}"
                                                             ShowLineNumbers="True"
                                                             SyntaxHighlighting="{Binding Script.Highlighting}"
                                                             WordWrap="False">
                                            <dxmvvm:Interaction.Behaviors>
                                                <!-- 캐럿 줄에 중단점을 찍으려면 편집기를 직접 잡아야 한다. -->
                                                <dxmvvm:UIObjectService x:Name="EditorObjectService" />
                                            </dxmvvm:Interaction.Behaviors>
                                        </markup:ScriptEditor>
                                    </DockPanel>
                                </dxdo:DocumentPanel>
                            </dxdo:DocumentGroup>

                        </dxdo:LayoutGroup>
                    </dxdo:LayoutGroup>

                    <!-- ── 아래 도구 창들 ── VS 의 오류 목록·출력 자리. -->
                    <dxdo:TabbedGroup ItemHeight="230">

                        <!--
                            ── 영역 ── 이름 붙인 자리. 아래 탭 줄 맨 왼쪽이다(사용자, 2026-09-16 - 칸이 늘어 옆 패널에는 좁고,
                            처음 쓰는 사람이 이 탭이 있다는 것을 알아채야 한다).
                            도구 줄(새 영역 · 새 구역 · 지금 읽기 · 지우기 · 영역 보기) + 트리(영역 → 구역, 이름 · 계속 읽기 · 읽은 글자).
                            화면 말은 영역·구역(사용자, 2026-09-16), 코드 이름은 NamedRegion(자리)·RegionCell(칸) 그대로.
                            자리는 LayoutGroup, 칸은 그 안 항목(사용자, 2026-09-16) - 읽는 것은 칸들이고 스크립트는 「자리.칸」 으로 부른다.
                        -->
                        <dxdo:LayoutPanel x:Name="RegionsPanel"
                                          Caption="영역">
                            <DockPanel>
                                <dxb:ToolBarControl AllowCustomizationMenu="False"
                                                    AllowQuickCustomization="False"
                                                    DockPanel.Dock="Top"
                                                    ShowBackground="False"
                                                    TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                                                    TextBlock.FontSize="{DynamicResource BaseFontSize}">
                                    <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                                       Command="{Binding NewRegionCommand}"
                                                       Content="새 영역"
                                                       Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/add.png'}"
                                                       Hint="화면 가운데에 새 영역을 놓고 이름 칸을 연다. 미리보기에서 끌어 옮기고 손잡이로 크기를 맞춘다.&#10;영역 보기가 켜져 있고 입력 전달이 꺼져 있으면 미리보기의 빈 곳을 끌어서도 만든다." />
                                    <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                                       Command="{Binding AddCellCommand}"
                                                       Content="새 구역"
                                                       Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/add.png'}"
                                                       Hint="고른 영역 안에 따로 읽을 구역을 더한다. 영역이나 그 구역을 골랐을 때만 켜진다.&#10;구역마다 따로 읽고, 스크립트는 읽기(&quot;영역.구역&quot;) 으로 부른다. 구역은 위쪽 동그라미로 돌릴 수 있다." />
                                    <!--
                                        눌러 놓는 동안 계속 갱신(사용자, 2026-09-18 "체크 형태로 바꿔서 눌러져 있는 동안 계속 미리보기 갱신") - 값(밝기 기준·반전·확대)을
                                        이리저리 바꿔 보며 바로 비교할 수 있다. 한 번만 읽는 것은 그리드 오른쪽 버튼 메뉴의 「지금 읽기」.
                                    -->
                                    <dxb:BarCheckItem BarItemDisplayMode="ContentAndGlyph"
                                                      Content="미리보기"
                                                      Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/view.png'}"
                                                      Hint="눌러 놓은 동안 고른 자리(구역을 골랐으면 그 구역)를 0.3초마다 다시 잘라 오른쪽 미리보기를 새로 입힌다.&#10;밝기 기준·반전·확대 값을 이리저리 바꿔 보며 바로바로 비교할 수 있다."
                                                      IsChecked="{Binding IsRegionPreviewLive, Mode=TwoWay}" />
                                    <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                                       Command="{Binding SaveTemplateCommand}"
                                                       Content="영역 이미지 저장"
                                                       Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/picture.png'}"
                                                       Hint="고른 영역을 지금 화면에서 잘라 영역 이미지(Resources\영역이름.png)로 저장한다.&#10;글자가 아닌 그림 버튼(메뉴 카드·아이콘)은 스크립트에서 그림누르기(&quot;영역이름.png&quot;) 로 찾아 누른다." />
                                    <dxb:BarButtonItem Command="{Binding RemoveRegionCommand}"
                                                       Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/delete.png'}"
                                                       Hint="고른 구역을 지운다(구역이 하나뿐이면 못 지운다). 영역 줄을 골랐으면 영역을 지운다." />
                                    <dxb:BarItemSeparator />
                                    <dxb:BarCheckItem Content="영역 보기"
                                                      Hint="만들어 둔 영역을 미리보기에 겹쳐 그린다.&#10;입력 전달이 꺼져 있으면 미리보기에서 영역을 눌러 고르고, 끌어 옮기고, 손잡이로 크기를 바꾼다(빈 곳 끌기는 새 영역)."
                                                      IsChecked="{Binding ShowRegions, Mode=TwoWay}" />
                                </dxb:ToolBarControl>
                                <!--
                                    미리보기(사용자, 2026-09-18 "콤보만 있으니 잘 모르겠어 도움되는 컨트롤 없어?") - 「지금 읽기」가 자른 그림에
                                    지금 손질(밝기 기준·반전·확대 - 앞으로 더 늘 수 있다, 그래서 "밝기 기준 미리보기"가 아니라 그냥 "미리보기")을
                                    입힌 모습. 자리를 골랐으면 그 안 구역마다 하나씩(사용자 "최대 이미지는 안 보여") -
                                    구역이 여럿이면 나란히 가로로 놓고 모자라면 다음 줄로(사용자, 2026-09-18 "옆으로 보여 달라니까").
                                    그리드는 열 너비가 내용에 맞춰져 오른쪽에 빈 자리가 남는다(사용자 "그리드 오른쪽에 여백이 많은데 거기에 놔줘") -
                                    그리드 오른쪽에 스플리터로 나눠 놓는다(사용자 "스플리터 하나 넣어줘"). 늘 보인다(사용자 "일부러 숨길 필요 없어") -
                                    비어 있으면 그냥 빈 채로 둔다.
                                -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <controls:BaseGridControl Grid.Column="0"
                                                              AutoGenerateColumns="None"
                                                              ItemsSource="{Binding Regions}"
                                                              SelectedItem="{Binding SelectedRegionNode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectionMode="None">
                                        <dxmvvm:Interaction.Behaviors>
                                            <!-- 새 자리를 만들면 ViewModel 이 이 그리드의 이름 칸을 편집 상태로 연다(OnRegionCreated). -->
                                            <dxmvvm:UIObjectService x:Name="RegionsGridObjectService" />
                                        </dxmvvm:Interaction.Behaviors>
                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn FieldName="Name" Header="이름" />
                                            <!-- 계속 읽기는 자리 단위 - 칸 줄에서는 체크를 숨긴다. -->
                                            <dxg:GridColumn FieldName="KeepReading" Header="계속 읽기">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <dxe:CheckEdit x:Name="PART_Editor"
                                                                       HorizontalAlignment="Center">
                                                            <dxe:CheckEdit.Style>
                                                                <Style TargetType="dxe:CheckEdit">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RowData.Row.IsRegion}"
                                                                                     Value="False">
                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </dxe:CheckEdit.Style>
                                                        </dxe:CheckEdit>
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <!-- 숫자만 - 자리·칸 어느 줄에서나 켠다. 켜면 읽은 글자에 숫자 덩어리만 보인다(스크립트의 숫자읽기와 같은 눈). -->
                                            <dxg:GridColumn FieldName="NumbersOnly" Header="숫자만">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <dxe:CheckEdit x:Name="PART_Editor"
                                                                       HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <!-- 이진화(그레이스케일 + 밝기 기준) - 자리 단위(사용자, 2026-09-18 "탄약 숫자도 잘 못 읽잖아"), 칸 줄에서는 숨긴다. 0 이면 꺼짐. -->
                                            <dxg:GridColumn FieldName="Threshold" Header="밝기 기준">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings MaxValue="255"
                                                                          MinValue="0" />
                                                </dxg:GridColumn.EditSettings>
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <dxe:SpinEdit x:Name="PART_Editor">
                                                            <dxe:SpinEdit.Style>
                                                                <Style TargetType="dxe:SpinEdit">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RowData.Row.IsRegion}"
                                                                                     Value="False">
                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </dxe:SpinEdit.Style>
                                                        </dxe:SpinEdit>
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn FieldName="Invert" Header="반전">
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <dxe:CheckEdit x:Name="PART_Editor"
                                                                       HorizontalAlignment="Center">
                                                            <dxe:CheckEdit.Style>
                                                                <Style TargetType="dxe:CheckEdit">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RowData.Row.IsRegion}"
                                                                                     Value="False">
                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </dxe:CheckEdit.Style>
                                                        </dxe:CheckEdit>
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <!-- 확대(1~4배) - 게임 HUD 의 작은 글자를 키워 읽는다. 자리 단위, 칸 줄에서는 숨긴다. 1 이면 꺼짐. -->
                                            <dxg:GridColumn FieldName="Scale" Header="확대">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:SpinEditSettings DisplayFormat="0.0x"
                                                                          Increment="0.5"
                                                                          MaxValue="4"
                                                                          MinValue="1" />
                                                </dxg:GridColumn.EditSettings>
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <dxe:SpinEdit x:Name="PART_Editor">
                                                            <dxe:SpinEdit.Style>
                                                                <Style TargetType="dxe:SpinEdit">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RowData.Row.IsRegion}"
                                                                                     Value="False">
                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </dxe:SpinEdit.Style>
                                                        </dxe:SpinEdit>
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <!--
                                                OCR 엔진 - 자리 단위(사용자, 2026-09-18 "영역별로 어떤 OCR 쓸지 따로 지정"), 칸 줄에서는 숨긴다.
                                                기본(null)이면 위 콤보에서 고른 전체 엔진을 그대로 쓴다.
                                            -->
                                            <dxg:GridColumn FieldName="OcrEngineName" Header="OCR 엔진">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:ComboBoxEditSettings DisplayMember="Label"
                                                                              IsTextEditable="False"
                                                                              ItemsSource="{Binding RegionOcrEngineOptions}"
                                                                              ValueMember="EngineName" />
                                                </dxg:GridColumn.EditSettings>
                                                <dxg:GridColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!--
                                                            CellTemplate 안 DataContext 는 자리 줄이라 EditSettings 의 ItemsSource(뷰모델 것)가 안 먹는다 -
                                                            오른쪽 버튼 메뉴와 같은 길(View.DataContext)로 다시 준다.
                                                        -->
                                                        <dxe:ComboBoxEdit x:Name="PART_Editor"
                                                                          DisplayMember="Label"
                                                                          IsTextEditable="False"
                                                                          ItemsSource="{Binding View.DataContext.RegionOcrEngineOptions}"
                                                                          ValueMember="EngineName">
                                                            <dxe:ComboBoxEdit.Style>
                                                                <Style TargetType="dxe:ComboBoxEdit">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RowData.Row.IsRegion}"
                                                                                     Value="False">
                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </dxe:ComboBoxEdit.Style>
                                                        </dxe:ComboBoxEdit>
                                                    </DataTemplate>
                                                </dxg:GridColumn.CellTemplate>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn AllowEditing="False" FieldName="LastText" Header="읽은 글자" />
                                            <!-- 자리·크기 열은 숨겼다(2026-09-15, 사용자) - 미리보기의 손잡이로 고치고 치수는 끄는 동안 픽셀로 뜬다. 열 고르기로 다시 켤 수 있다. -->
                                            <dxg:GridColumn AllowEditing="False" FieldName="X" Header="가로" Visible="False">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings DisplayFormat="P1" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn AllowEditing="False" FieldName="Y" Header="세로" Visible="False">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings DisplayFormat="P1" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn AllowEditing="False" FieldName="Width" Header="너비" Visible="False">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings DisplayFormat="P1" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn AllowEditing="False" FieldName="Height" Header="높이" Visible="False">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings DisplayFormat="P1" />
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                        </dxg:GridControl.Columns>
                                        <dxg:GridControl.View>
                                            <!-- 칸 너비는 내용에 맞춘다(사용자, 2026-09-16) - 열에 Width 를 안 적고, 자동 너비는 ViewModel 이 화면이 뜬 뒤 건다(OnLoaded). -->
                                            <controls:BaseTreeListView AllowBestFit="True"
                                                                       AllowEditing="True"
                                                                       AutoExpandAllNodes="True"
                                                                       ChildNodesSelector="{StaticResource RegionTreeChildren}"
                                                                       EditorShowMode="Default"
                                                                       ShowSearchPanelMode="Never"
                                                                       TreeDerivationMode="ChildNodesSelector">
                                                <!-- 오른쪽 버튼 메뉴 - 도구 줄과 같은 것. -->
                                                <dxg:TreeListView.RowCellMenuCustomizations>
                                                    <dxb:BarButtonItem Command="{Binding Path=View.DataContext.NewRegionCommand}"
                                                                       Content="새 영역(_N)"
                                                                       Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/add.png'}" />
                                                    <dxb:BarButtonItem Command="{Binding View.DataContext.AddCellCommand}"
                                                                       Content="새 구역(_C)"
                                                                       Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/add.png'}" />
                                                    <dxb:BarButtonItem Command="{Binding View.DataContext.TestRegionCommand}"
                                                                       Content="지금 읽기(_R)"
                                                                       Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/refresh.png'}" />
                                                    <dxb:BarButtonItem Command="{Binding View.DataContext.SaveTemplateCommand}"
                                                                       Content="영역 이미지 저장(_T)"
                                                                       Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/picture.png'}" />
                                                    <dxb:BarItemSeparator />
                                                    <dxb:BarButtonItem Command="{Binding View.DataContext.RemoveRegionCommand}"
                                                                       Content="지우기(_D)"
                                                                       Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/delete.png'}" />
                                                </dxg:TreeListView.RowCellMenuCustomizations>
                                            </controls:BaseTreeListView>
                                        </dxg:GridControl.View>
                                    </controls:BaseGridControl>

                                    <!-- 미리보기 자리는 늘 보인다(사용자, 2026-09-18 "일부러 숨길 필요 없어") - 비어 있으면 그냥 빈 채로. -->
                                    <GridSplitter Grid.Column="1"
                                                  Width="4"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ResizeBehavior="PreviousAndNext"
                                                  ShowsPreview="True" />

                                    <Border Grid.Column="2"
                                            Width="280"
                                            Padding="6"
                                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                            BorderThickness="1,0,0,0">
                                        <DockPanel>
                                            <!--
                                                저장된 영역 이미지(사용자, 2026-09-19 "저장된 그림 미리보기 넣어줘") - 고른 자리로 저장해 둔 Resources\자리.png.
                                                버튼이 뜨기 전 화면이 저장돼 닮음이 0.5 에 머문 적이 있다 - 무엇이 저장됐는지 눈으로 본다.
                                            -->
                                            <StackPanel Margin="0,8,0,0"
                                                        DockPanel.Dock="Bottom">
                                                <TextBlock Margin="0,0,0,2"
                                                           FontWeight="Bold"
                                                           Text="저장된 영역 이미지" />
                                                <TextBlock Margin="0,0,0,4"
                                                           Text="{Binding SavedTemplateCaption}"
                                                           TextWrapping="Wrap" />
                                                <Border HorizontalAlignment="Left"
                                                        BorderBrush="Gray"
                                                        BorderThickness="1">
                                                    <Image MaxWidth="260"
                                                           MaxHeight="120"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                           Source="{Binding SavedTemplateImage}"
                                                           Stretch="Uniform"
                                                           StretchDirection="DownOnly" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,0,0,6"
                                                       FontWeight="Bold"
                                                       DockPanel.Dock="Top"
                                                       Text="미리보기" />
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding RegionPreviewImages}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,10,10">
                                                                <TextBlock Margin="0,0,0,2"
                                                                           HorizontalAlignment="Center"
                                                                           Text="{Binding Label}" />
                                                                <Border BorderBrush="Gray"
                                                                        BorderThickness="1">
                                                                    <Image MaxWidth="120"
                                                                           MaxHeight="60"
                                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                           Source="{Binding Image}"
                                                                           Stretch="Uniform" />
                                                                </Border>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </DockPanel>
                        </dxdo:LayoutPanel>

                        <dxdo:LayoutPanel x:Name="ErrorListPanel"
                                          Caption="오류 목록">
                            <controls:BaseGridControl AutoGenerateColumns="None"
                                                      ItemsSource="{Binding Script.Errors, Mode=OneWay}">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn Width="*" FieldName="Message" Header="설명" />
                                    <dxg:GridColumn Width="160" FieldName="FileName" Header="파일" />
                                    <dxg:GridColumn Width="60" FieldName="Line" Header="줄" />
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <controls:BaseTableView AllowEditing="False"
                                                            AutoWidth="True"
                                                            ShowGroupPanel="False"
                                                            ShowSearchPanelMode="Never">
                                        <dxmvvm:Interaction.Behaviors>
                                            <!-- 더블 클릭하면 그 파일·줄로 간다. -->
                                            <dxmvvm:EventToCommand Command="{Binding GoToErrorCommand}"
                                                                   EventName="RowDoubleClick"
                                                                   PassEventArgsToCommand="True">
                                                <dxmvvm:EventToCommand.EventArgsConverter>
                                                    <dx:EventArgsToDataRowConverter />
                                                </dxmvvm:EventToCommand.EventArgsConverter>
                                            </dxmvvm:EventToCommand>
                                        </dxmvvm:Interaction.Behaviors>
                                    </controls:BaseTableView>
                                </dxg:GridControl.View>
                            </controls:BaseGridControl>
                        </dxdo:LayoutPanel>

                        <!-- 새 줄이 붙으면 맨 아래로 따라간다. 단, 사람이 위로 올려 본 동안에는 멈춘다. -->
                        <dxdo:LayoutPanel x:Name="OutputPanel"
                                          Caption="출력">
                            <DockPanel>
                                <!-- VS 출력 창처럼 위에 「모두 지우기」(사용자, 2026-09-19) - 출력 글만 비운다(호출·변수는 그대로). -->
                                <dxb:ToolBarControl AllowCustomizationMenu="False"
                                                    AllowQuickCustomization="False"
                                                    DockPanel.Dock="Top"
                                                    ShowBackground="False"
                                                    TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                                                    TextBlock.FontSize="{DynamicResource BaseFontSize}">
                                    <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                                       Command="{Binding Live.Console.ClearOutputCommand}"
                                                       Content="모두 지우기"
                                                       Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/delete.png'}"
                                                       Hint="출력 칸에 쌓인 글을 모두 지운다. 호출·변수 칸은 그대로 둔다." />
                                </dxb:ToolBarControl>
                                <dxe:TextEdit VerticalContentAlignment="Top"
                                              FontFamily="D2Coding, Consolas, Courier New"
                                              markup:AutoScrollToEnd.IsEnabled="True"
                                              AcceptsReturn="True"
                                              EditValue="{Binding Live.Console.Text, Mode=OneWay}"
                                              IsReadOnly="True"
                                              TextWrapping="Wrap"
                                              VerticalScrollBarVisibility="Auto" />
                            </DockPanel>
                        </dxdo:LayoutPanel>

                        <dxdo:LayoutPanel x:Name="CallsPanel"
                                          Caption="호출">
                            <dxe:TextEdit VerticalContentAlignment="Top"
                                          FontFamily="D2Coding, Consolas, Courier New"
                                          markup:AutoScrollToEnd.IsEnabled="True"
                                          AcceptsReturn="True"
                                          EditValue="{Binding Live.Console.CallsText, Mode=OneWay}"
                                          HorizontalScrollBarVisibility="Auto"
                                          IsReadOnly="True"
                                          TextWrapping="NoWrap"
                                          VerticalScrollBarVisibility="Auto" />
                        </dxdo:LayoutPanel>

                        <dxdo:LayoutPanel x:Name="VariablesPanel"
                                          Caption="변수">
                            <dxlc:LayoutControl Orientation="Vertical">
                                <dxlc:LayoutItem Label="보기">
                                    <dxe:TextEdit EditValue="{Binding Live.Console.Watches, Mode=OneWay}"
                                                  IsReadOnly="True" />
                                </dxlc:LayoutItem>
                                <!-- 멈춘 줄의 지역 변수. JavaScript·Python 만. C# 은 비어 있다. -->
                                <dxe:TextEdit VerticalContentAlignment="Top"
                                              FontFamily="D2Coding, Consolas, Courier New"
                                              AcceptsReturn="True"
                                              EditValue="{Binding Live.Debug.Locals, Mode=OneWay}"
                                              IsReadOnly="True"
                                              NullText="멈춘 줄의 변수가 여기 뜹니다 (JavaScript·Python)"
                                              VerticalScrollBarVisibility="Auto" />
                            </dxlc:LayoutControl>
                        </dxdo:LayoutPanel>


                        <dxdo:LayoutPanel x:Name="BreakpointsPanel"
                                          Caption="중단점">
                            <dxlc:LayoutControl Orientation="Vertical">
                                <dxe:TextEdit VerticalAlignment="Top"
                                              Opacity="0.7"
                                              IsReadOnly="True"
                                              ShowBorder="False"
                                              Text="편집기 왼쪽 여백을 누르거나 F9 로 켜고 끕니다. 한 줄씩(F10)은 JavaScript·Python 만 됩니다." />
                                <dxe:ListBoxEdit VerticalAlignment="Stretch"
                                                 ItemsSource="{Binding Live.Debug.Breakpoints}" />
                            </dxlc:LayoutControl>
                        </dxdo:LayoutPanel>
                    </dxdo:TabbedGroup>
                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </DockPanel>
    </dxb:BarManager>
</UserControl>
