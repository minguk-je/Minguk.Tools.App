<UserControl x:Class="Minguk.Tools.Views.Parts.CapturePreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
             xmlns:parts="clr-namespace:Minguk.Tools.Views.Parts">

    <!--
        입력은 Border 가 받는다. Image 에는 Background 가 없어서 그림 바깥(검은 띠)이
        히트 테스트에 안 걸리는데, Border 는 배경이 칠해져 있어 전 영역이 잡힌다.
        Focusable 이 있어야 키 입력이 들어온다 — Image 는 Focusable 이 아니므로
        누를 때 이 Border 에 포커스를 준다. 그래서 여기에도 UIObjectService 를 둔다.
        좌표는 Image 기준으로 재므로 Image 에도 하나 있다.
        
        서비스 이름(PreviewSurfaceObjectService · PreviewImageObjectService)은 CaptureViewModelBase 가
        InitializeControls 에서 찾는 이름이다. 이 컨트롤을 얹은 화면의 DataContext(그 ViewModel)에 등록된다.
    -->
    <!--
        미리보기 바탕(그림 둘레의 여백). 하드코딩 색 대신 DevExpress 경량 테마의 창 배경을 쓴다 - 테마를 바꾸면 같이 바뀐다.
        Minguk.Base 의 Style.xaml 이 쓰는 것과 같은 방식(dxi:ThemeResource + dxt:PaletteBrushThemeKey). TamsTools 도 같은 길이다.
    -->
    <Border x:Name="Surface"
            Background="{dxi:ThemeResource {dxt:PaletteBrushThemeKey ResourceKey=WindowBackground}}"
            Focusable="True">

        <dxmvvm:Interaction.Behaviors>
            <dxmvvm:UIObjectService x:Name="PreviewSurfaceObjectService" />

            <dxmvvm:EventToCommand Command="{Binding OnPreviewMouseDownCommand}"
                                   EventName="MouseDown"
                                   PassEventArgsToCommand="True" />
            <!-- 글자 영역을 끌 때만 쓴다. 전달과 무관하다. -->
            <dxmvvm:EventToCommand Command="{Binding OnPreviewMouseMoveCommand}"
                                   EventName="MouseMove"
                                   PassEventArgsToCommand="True" />
            <dxmvvm:EventToCommand Command="{Binding OnPreviewMouseUpCommand}"
                                   EventName="MouseUp"
                                   PassEventArgsToCommand="True" />
            <!--
                휠은 터널(Preview) 로 받는다. 안의 ScrollViewer 가 버블 MouseWheel 을 늘 먹어(Handled) 여기까지 안 올라온다 -
                확대도, 게임으로 보내는 휠도 다 죽었다(실측, 스크립트 화면 하네스가 잡는다). 핸들러가 Handled 로 두면 스크롤도 안 한다.
            -->
            <dxmvvm:EventToCommand Command="{Binding OnPreviewMouseWheelCommand}"
                                   EventName="PreviewMouseWheel"
                                   PassEventArgsToCommand="True" />
            <dxmvvm:EventToCommand Command="{Binding OnPreviewKeyDownCommand}"
                                   EventName="KeyDown"
                                   PassEventArgsToCommand="True" />
            <dxmvvm:EventToCommand Command="{Binding OnPreviewKeyUpCommand}"
                                   EventName="KeyUp"
                                   PassEventArgsToCommand="True" />
        </dxmvvm:Interaction.Behaviors>

        <!--
            확대는 <c>LayoutTransform</c> 으로 한다. 그래야 속의 Image 가 제 좌표계를 그대로 써서,
            마우스 자리를 비율로 바꾸는 계산(PreviewInputMapper)을 손대지 않아도 된다.
            RenderTransform 으로 하면 즐은 그려지기만 하고 자리 계산은 안 바뀌어 어긋난다.

            크기를 바깥 Border 에 맞춘다 - 스크롤 뷰포트에 맞추면 막대가 나타났다 사라졌다 하며 떨린다.
        -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid Width="{Binding ActualWidth, ElementName=Surface}"
                  Height="{Binding ActualHeight, ElementName=Surface}">
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding PreviewZoom}"
                                    ScaleY="{Binding PreviewZoom}" />
                </Grid.LayoutTransform>
            <!--
                Stretch=Uniform 이라 원본 비율을 지킨다. 축소해서 보여 주는 용도이므로
                BitmapScalingMode 는 LowQuality(선형 보간)로 둔다 — 60fps 로 갱신할 때
                HighQuality 로 두면 축소 비용이 UI 스레드를 잡아먹는다.
            -->
            <Image RenderOptions.BitmapScalingMode="LowQuality"
                   Source="{Binding PreviewImage}"
                   Stretch="Uniform">

                <dxmvvm:Interaction.Behaviors>
                    <dxmvvm:UIObjectService x:Name="PreviewImageObjectService" />
                </dxmvvm:Interaction.Behaviors>
            </Image>

            <!-- 화면이 얹는 겹그림(찾은 몹 점선 등). 없으면 비어 있다. 마우스는 통과시킨다. -->
            <ContentPresenter Content="{Binding Overlay, RelativeSource={RelativeSource AncestorType=parts:CapturePreviewPanel}}"
                              IsHitTestVisible="False" />

            <!-- 화면이 얹는 편집기(영역 손잡이). 마우스를 받을지는 그 안이 정한다 - 편집 중이 아니면 스스로 빠진다. -->
            <ContentPresenter Content="{Binding Editor, RelativeSource={RelativeSource AncestorType=parts:CapturePreviewPanel}}" />
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
