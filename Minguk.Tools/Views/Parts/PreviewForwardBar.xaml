<UserControl x:Class="Minguk.Tools.Views.Parts.PreviewForwardBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:markup="clr-namespace:Minguk.Tools.Markup">

    <UserControl.Resources>
        <dxmvvm:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <!-- 미리보기를 켰을 때만 쓰는 것들. 툴바째 숨겨 조건을 한 군데로 모은다. -->
    <dxb:ToolBarControl AllowCustomizationMenu="False"
                        AllowQuickCustomization="False"
                        TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                        TextBlock.FontSize="{DynamicResource BaseFontSize}"
                        Visibility="{Binding ShowPreview, Converter={StaticResource BooleanToVisibilityConverter}}">

        <!--
            미리보기 갱신 상한 칸은 뺐다(2026-09-15, 사용자 "FPS 콤보랑 맞춰줘") - 화면캡처 화면처럼 미리보기는 위 FPS 콤보를 따른다
            (PreviewTargetFps = CaptureTargetFps). 두 칸이 따로 있으면 미리보기만 30 으로 묶여 캡처는 60 인데 화면이 뚝뚝 끊겨 보였다.
        -->
        <!--
            미리보기 확대 - 라벨링 화면 그림 판과 같은 콤보(2026-09-15). 고르거나 직접 치고, 휠로 바꾼 배율도 여기 뜬다(PreviewZoom 양방향).
            판 위 휠 확대·오른쪽 끌기 이동은 입력 전달이 꺼져 있거나 영역을 손보는 중에 된다. 값이 Decimal 로 올 수 있어 ToDoubleConverter 로 잇는다.
        -->
        <dxb:BarEditItem Content="확대"
                         EditValue="{Binding PreviewZoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={markup:ToDoubleConverter}}"
                         EditWidth="64"
                         ToolTip="미리보기를 키우고 줄입니다. 100% 면 창에 맞춤.&#10;입력 전달이 꺼져 있거나 영역을 손보는 중이면 판 위에서 휠로도 되고, 오른쪽 버튼으로 끌면 옮겨집니다. 전달 중에는 Ctrl+휠.">
            <dxb:BarEditItem.EditSettings>
                <dxe:ComboBoxEditSettings DisplayFormat="0%"
                                          IsTextEditable="True"
                                          ItemsSource="{Binding ZoomOptions}" />
            </dxb:BarEditItem.EditSettings>
        </dxb:BarEditItem>
        <dxb:BarButtonItem Command="{Binding ZoomResetCommand}"
                           Content="맞춤"
                           ToolTip="확대를 1(창에 맞춤) 로 되돌립니다." />

        <dxb:BarItemSeparator />

        <dxb:BarStaticItem Content="{Binding PreviewFpsText, Mode=OneWay}"
                           ToolTip="지금 화면에 올라가고 있는 실제 FPS. 상한은 위 FPS 콤보를 따른다." />

        <dxb:BarItemSeparator />

        <dxb:BarCheckItem Content="입력 전달"
                          IsChecked="{Binding IsInputForwardingEnabled}"
                          IsEnabled="{Binding IsInputForwardingAvailable}"
                          ToolTip="미리보기 클릭·키를 대상 창으로 보낸다. 요소 검사가 켜져 있으면 쓸 수 없다." />

        <dxb:BarCheckItem Content="요소 검사"
                          IsChecked="{Binding IsElementInspectEnabled}"
                          ToolTip="미리보기를 누르면 그 자리의 UI 요소를 상태 줄에 보여 준다. 켜져 있는 동안은 입력을 전달하지 않는다." />

        <dxb:BarCheckItem Content="클릭 후 돌아오기"
                          IsChecked="{Binding IsReturnFocusAfterClickEnabled}"
                          IsEnabled="{Binding IsInputForwardingEnabled}"
                          ToolTip="클릭이 대상에 닿은 뒤 커서와 포커스를 이 창으로 되돌린다. 끄면 대상 창이 앞에 남는다." />
    </dxb:ToolBarControl>
</UserControl>
