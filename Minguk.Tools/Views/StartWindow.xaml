<dx:ThemedWindow x:Class="Minguk.Tools.Views.StartWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                 xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                 xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                 xmlns:controls="clr-namespace:Minguk.Base.Controls;assembly=Minguk.Base"
                 xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
                 Title="시작"
                 Width="760"
                 Height="440"
                 Style="{DynamicResource BaseControlStyle}"
                 FontFamily="{DynamicResource BaseFontFamily}"
                 FontSize="{DynamicResource BaseFontSize}"
                 DataContext="{dxmvvm:ViewModelSource Type={x:Type viewModels:StartWindowViewModel}}"
                 ResizeMode="NoResize"
                 ShowIcon="False"
                 WindowStartupLocation="CenterOwner"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance {x:Type viewModels:StartWindowViewModel},
                                                  IsDesignTimeCreatable=False}">

    <dx:ThemedWindow.Resources>
        <ResourceDictionary>
            <dxmvvm:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
            <dxmvvm:BooleanNegationConverter x:Key="Not" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/DataTemplate.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/GridColumnStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dx:ThemedWindow.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Command="{Binding OnInitializedCommand}"
                               EventName="Loaded" />

        <dxmvvm:CurrentWindowService />
        <dx:DXMessageBoxService />
        <dxmvvm:OpenFileDialogService />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl Padding="12"
                        Orientation="Horizontal">

        <!-- 왼쪽 : 최근 솔루션. 더블 클릭이면 바로 연다 - 목록에서 고르고 버튼까지 가는 걸음을 줄인다. -->
        <dxlc:LayoutGroup HorizontalAlignment="Stretch"
                          Header="최근 솔루션"
                          Orientation="Vertical"
                          View="GroupBox">

            <dxlc:LayoutGroup.GroupBoxStyle>
                <Style TargetType="dxlc:GroupBox">
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </dxlc:LayoutGroup.GroupBoxStyle>

            <dxlc:LayoutItem VerticalAlignment="Stretch"
                             AddColonToLabel="False"
                             Label="">
                <controls:BaseGridControl AutoGenerateColumns="None"
                                          ItemsSource="{Binding Recent}"
                                          SelectedItem="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <dxg:GridControl.View>
                        <controls:BaseTableView AllowEditing="False"
                                                ShowGroupPanel="False"
                                                ShowSearchPanelMode="Never">
                            <!--
                                더블 클릭으로 연다. GridControl 의 MouseDoubleClick 은 안 온다(셀 템플릿이 먼저 먹는다) -
                                줄을 더블 클릭한 것은 TableView 의 RowDoubleClick 으로 온다.
                            -->
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand Command="{Binding DoOpenSelectedCommand}"
                                                       EventName="RowDoubleClick"
                                                       PassEventArgsToCommand="False" />
                            </dxmvvm:Interaction.Behaviors>
                        </controls:BaseTableView>
                    </dxg:GridControl.View>

                    <dxg:GridColumn Width="150" FieldName="Name" Header="이름" />
                    <dxg:GridColumn Width="*" FieldName="Where" Header="자리" />
                </controls:BaseGridControl>
            </dxlc:LayoutItem>

            <dxlc:LayoutGroup HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Orientation="Horizontal">
                <dx:SimpleButton Width="80"
                                 Command="{Binding DoOpenSelectedCommand}"
                                 Content="열기" />
                <dx:SimpleButton Width="110"
                                 Command="{Binding DoForgetCommand}"
                                 Content="목록에서 빼기"
                                 ToolTip="최근 목록에서만 뺍니다. 폴더와 파일은 그대로 둡니다." />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>

        <!-- 오른쪽 : 시작하기. 만들기를 누르면 같은 자리가 이름 두 칸으로 바뀐다. -->
        <!-- 폭을 못 박지 않는다 - 버튼 폭만큼만 차지하고 나머지는 최근 목록이 쓴다. -->
        <dxlc:LayoutGroup HorizontalAlignment="Left"
                          Header="시작"
                          Orientation="Vertical"
                          View="GroupBox">

            <dxlc:LayoutGroup.GroupBoxStyle>
                <Style TargetType="dxlc:GroupBox">
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </dxlc:LayoutGroup.GroupBoxStyle>

            <!-- 고르는 중 -->
            <dxlc:LayoutGroup Orientation="Vertical"
                              Visibility="{Binding IsCreating, Converter={StaticResource Not}, ConverterParameter=Visibility}">
                <dxlc:LayoutItem AddColonToLabel="False"
                                 Label="">
                    <dx:SimpleButton Width="150"
                                     HorizontalAlignment="Left"
                                     Command="{Binding DoBrowseCommand}"
                                     Content="솔루션 열기..." />
                </dxlc:LayoutItem>

                <dxlc:LayoutItem AddColonToLabel="False"
                                 Label="">
                    <dx:SimpleButton Width="150"
                                     HorizontalAlignment="Left"
                                     Command="{Binding DoBeginCreateCommand}"
                                     Content="새 솔루션 만들기..." />
                </dxlc:LayoutItem>

                <dxlc:LayoutItem VerticalAlignment="Bottom"
                                 AddColonToLabel="False"
                                 Label="">
                    <TextBlock MaxWidth="150"
                               Margin="2,12,2,2"
                               HorizontalAlignment="Left"
                               Foreground="Gray"
                               Text="게임 = 솔루션&#10;모드·스테이지 = 프로젝트"
                               TextWrapping="Wrap" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>

            <!-- 만드는 중 -->
            <dxlc:LayoutGroup Orientation="Vertical"
                              Visibility="{Binding IsCreating, Converter={StaticResource BooleanToVisibility}}">
                <dxlc:LayoutItem AddColonToLabel="False"
                                 Label="게임 이름">
                    <dxe:TextEdit Width="150"
                                  EditValue="{Binding NewSolutionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  NullText="오버워치" />
                </dxlc:LayoutItem>

                <dxlc:LayoutItem AddColonToLabel="False"
                                 Label="첫 프로젝트">
                    <dxe:TextEdit Width="150"
                                  EditValue="{Binding NewProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  NullText="사격장" />
                </dxlc:LayoutItem>

                <dxlc:LayoutItem AddColonToLabel="False"
                                 Label="">
                    <TextBlock MaxWidth="230"
                               Margin="2,4,2,4"
                               HorizontalAlignment="Left"
                               Foreground="Gray"
                               Text="{Binding NewSolutionPath, StringFormat=여기에 만듭니다 - {0}}"
                               TextWrapping="Wrap" />
                </dxlc:LayoutItem>

                <dxlc:LayoutGroup HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Orientation="Horizontal">
                    <dx:SimpleButton Width="80"
                                     Command="{Binding DoCreateCommand}"
                                     Content="만들기" />
                    <dx:SimpleButton Width="80"
                                     Command="{Binding DoCancelCreateCommand}"
                                     Content="취소" />
                </dxlc:LayoutGroup>
            </dxlc:LayoutGroup>

        </dxlc:LayoutGroup>

    </dxlc:LayoutControl>

</dx:ThemedWindow>
