<UserControl
    x:Class="Minguk.Tools.Views.ConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
    d:DataContext="{d:DesignInstance {x:Type viewModels:ConfigViewModel},
                                     IsDesignTimeCreatable=False}"
    FontFamily="{DynamicResource BaseFontFamily}"
    FontSize="{DynamicResource BaseFontSize}"
    Style="{DynamicResource BaseControlStyle}"
    mc:Ignorable="d">

    <!--
        DataContext 를 여기서 물리지 않는다. DialogService 가 ViewModel 을 넣어 준다.
        (MainWindow.xaml 의 ConfigDialogService 참조)
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dx:CurrentDialogService />
        <dx:DXMessageBoxService />
        <dxmvvm:DispatcherService />
        <dxmvvm:EventToCommand Command="{Binding OnInitializedCommand}" EventName="Loaded" />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl
        MinWidth="320"
        Orientation="Vertical"
        Padding="8">

        <dxlc:LayoutGroup
            Header="실행 환경"
            Orientation="Vertical"
            View="GroupBox">

            <dxlc:LayoutGroup.GroupBoxStyle>
                <Style TargetType="dxlc:GroupBox">
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </dxlc:LayoutGroup.GroupBoxStyle>

            <!-- 어느 AppSettings.*.json 을 읽을지. 다음 실행부터 적용된다. -->
            <dxlc:LayoutItem AddColonToLabel="False" Label="">
                <dxe:ComboBoxEdit
                    EditValue="{Binding AppSettings, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsTextEditable="False">
                    <dxe:ComboBoxEdit.Items>
                        <dxe:ComboBoxEditItem>Development</dxe:ComboBoxEditItem>
                        <dxe:ComboBoxEditItem>Production</dxe:ComboBoxEditItem>
                    </dxe:ComboBoxEdit.Items>
                </dxe:ComboBoxEdit>
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>

        <dxlc:LayoutGroup
            Header="글꼴"
            Orientation="Vertical"
            View="GroupBox">

            <dxlc:LayoutGroup.GroupBoxStyle>
                <Style TargetType="dxlc:GroupBox">
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </dxlc:LayoutGroup.GroupBoxStyle>

            <dxlc:LayoutItem AddColonToLabel="False" Label="폰트">
                <dxe:FontEdit
                    AllowSpinOnMouseWheel="False"
                    EditValue="{Binding FontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue='D2Coding'}"
                    IsTextEditable="False" />
            </dxlc:LayoutItem>

            <dxlc:LayoutItem AddColonToLabel="False" Label="크기">
                <dxe:SpinEdit
                    AllowSpinOnMouseWheel="False"
                    EditValue="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=12}"
                    EditValueType="{x:Type sys:Double}"
                    Increment="1"
                    IsTextEditable="False"
                    MaxValue="32"
                    MinValue="10" />
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>

        <dxlc:LayerSeparator
            Height="5"
            Margin="0,5,0,5"
            Kind="Horizontal" />

        <dxlc:LayoutGroup Orientation="Horizontal">
            <dxlc:LayoutGroup HorizontalAlignment="Left" View="GroupBox">
                <dxlc:LayoutGroup.GroupBoxStyle>
                    <Style TargetType="dxlc:GroupBox">
                        <Setter Property="TitleVisibility" Value="Collapsed" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </dxlc:LayoutGroup.GroupBoxStyle>

                <dx:SimpleButton
                    Width="100"
                    Command="{Binding DoInitializeSettingCommand}"
                    Content="초기화"
                    Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Clear.svg'}"
                    GlyphHeight="16"
                    GlyphWidth="16"
                    ToolTip="저장된 설정을 모두 지우고 기본값으로 되돌린 뒤 다시 시작한다." />
            </dxlc:LayoutGroup>

            <dxlc:LayoutGroup HorizontalAlignment="Right" View="GroupBox">
                <dxlc:LayoutGroup.GroupBoxStyle>
                    <Style TargetType="dxlc:GroupBox">
                        <Setter Property="TitleVisibility" Value="Collapsed" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </dxlc:LayoutGroup.GroupBoxStyle>

                <dx:SimpleButton
                    Width="90"
                    Command="{Binding DoYesCommand}"
                    Content="확인"
                    Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_CheckCircled.svg'}"
                    GlyphHeight="16"
                    GlyphWidth="16"
                    IsDefault="True" />

                <dx:SimpleButton
                    Width="90"
                    Command="{Binding DoNoCommand}"
                    Content="취소"
                    Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_DeleteCircled.svg'}"
                    GlyphHeight="16"
                    GlyphWidth="16"
                    IsCancel="True" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>
</UserControl>
