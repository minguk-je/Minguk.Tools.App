<dx:ThemedWindow x:Class="Minguk.Tools.Views.NameInputWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                 xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                 xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
                 Width="360"
                 SizeToContent="Height"
                 Style="{DynamicResource BaseControlStyle}"
                 FontFamily="{DynamicResource BaseFontFamily}"
                 FontSize="{DynamicResource BaseFontSize}"
                 DataContext="{dxmvvm:ViewModelSource Type={x:Type viewModels:NameInputWindowViewModel}}"
                 ResizeMode="NoResize"
                 ShowIcon="False"
                 WindowStartupLocation="CenterOwner"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance {x:Type viewModels:NameInputWindowViewModel},
                                                  IsDesignTimeCreatable=False}">

    <dx:ThemedWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dx:ThemedWindow.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:CurrentWindowService />
    </dxmvvm:Interaction.Behaviors>

    <!-- Enter 가 확인, Esc 가 취소. 이름 하나 적는 창에서 마우스로 버튼까지 가게 하지 않는다. -->
    <dx:ThemedWindow.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding DoOkCommand}" />
        <KeyBinding Key="Escape" Command="{Binding DoCancelCommand}" />
    </dx:ThemedWindow.InputBindings>

    <dxlc:LayoutControl Padding="12" Orientation="Vertical">

        <dxlc:LayoutItem AddColonToLabel="False" Label="">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </dxlc:LayoutItem>

        <dxlc:LayoutItem AddColonToLabel="False" Label="">
            <dxe:TextEdit x:Name="NameEdit"
                          EditValue="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </dxlc:LayoutItem>

        <dxlc:LayoutItem AddColonToLabel="False" Label="">
            <TextBlock Foreground="Firebrick"
                       Text="{Binding Error}"
                       TextWrapping="Wrap" />
        </dxlc:LayoutItem>

        <dxlc:LayoutGroup HorizontalAlignment="Right" Orientation="Horizontal">
            <dx:SimpleButton Width="80"
                             Command="{Binding DoOkCommand}"
                             Content="확인" />
            <dx:SimpleButton Width="80"
                             Command="{Binding DoCancelCommand}"
                             Content="취소" />
        </dxlc:LayoutGroup>

    </dxlc:LayoutControl>

</dx:ThemedWindow>
