<UserControl x:Class="Minguk.Tools.Views.SettingsListRowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:settings="clr-namespace:Minguk.Tools.Markup.Settings"
             xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels.Settings"
             Width="520"
             Height="340"
             Style="{DynamicResource BaseControlStyle}"
             FontFamily="{DynamicResource BaseFontFamily}"
             FontSize="{DynamicResource BaseFontSize}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type viewModels:SettingsListRowsViewModel},
                                              IsDesignTimeCreatable=False}">

    <!-- 목록 칸의 처음 행 - 설정 탭 속성 창 `처음 행` … 이 DialogService 로 띄운다. 확인·취소 단추는 대화 상자 창이 단다. -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxlc:LayoutControl Padding="8"
                        Orientation="Vertical">
        <dxlc:LayoutItem AddColonToLabel="False"
                         Label="">
            <TextBlock VerticalAlignment="Center"
                       Opacity="0.8"
                       Text="{Binding Hint, Mode=OneWay}"
                       TextWrapping="Wrap" />
        </dxlc:LayoutItem>
        <dxlc:LayoutItem VerticalAlignment="Stretch"
                         AddColonToLabel="False"
                         Label="">
            <settings:SettingsListRowsEditor Columns="{Binding Columns, Mode=OneWay}"
                                             Rows="{Binding Rows, Mode=TwoWay}" />
        </dxlc:LayoutItem>
    </dxlc:LayoutControl>
</UserControl>
