<UserControl x:Class="Minguk.Tools.Views.LabelingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:markup="clr-namespace:Minguk.Tools.Markup"
             xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
             Style="{DynamicResource BaseControlStyle}"
             FontFamily="{DynamicResource BaseFontFamily}"
             FontSize="{DynamicResource BaseFontSize}"
             DataContext="{dxmvvm:ViewModelSource Type={x:Type viewModels:LabelingViewModel}}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type viewModels:LabelingViewModel},
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="600"
             d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <dxmvvm:BooleanNegationConverter x:Key="NotBool" />
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Command="{Binding OnInitializedCommand}"
                               EventName="Loaded" />

        <!-- 폴더 고르기 · 알림 창. 선언하지 않으면 ViewModel 에서 부를 때 예외로 터진다. -->
        <dxmvvm:FolderBrowserDialogService />
        <dxmvvm:DispatcherService />

        <!--
            libtorch 2.2GB 를 받기 전에 물어보는 데 쓴다. 선언하지 않으면 GetService 가
            null 이 아니라 예외로 터져, Guard 가 삼키고 아무 일도 안 일어난 것처럼 보인다.
            실제로 그랬다 - 학습 시작을 눌러도 화면이 그대로였다.
        -->
        <dx:DXMessageBoxService />
    </dxmvvm:Interaction.Behaviors>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 데이터셋 ──────────────────────────────────────────────── -->
        <dxlc:LayoutControl Grid.Row="0"
                            Padding="0"
                            Orientation="Vertical">
            <dxlc:LayoutGroup Header="데이터셋"
                              Orientation="Horizontal"
                              View="GroupBox">
                <dxlc:LayoutItem Label="폴더">
                    <dxe:TextEdit EditValue="{Binding DatasetRoot, Mode=OneWay}"
                                  IsReadOnly="True"
                                  ToolTip="{Binding DatasetRoot}" />
                </dxlc:LayoutItem>

                <dx:SimpleButton Width="90"
                                 Command="{Binding DoChooseFolderCommand}"
                                 Content="폴더 고르기" />
                <dx:SimpleButton Width="90"
                                 Command="{Binding DoOpenFolderCommand}"
                                 Content="탐색기로" />
                <dx:SimpleButton Width="90"
                                 Command="{Binding DoReloadCommand}"
                                 Content="다시 읽기"
                                 ToolTip="캡처 모니터에서 새로 담은 그림을 가져옵니다." />

                <dxlc:LayoutItem Width="150"
                                 Label="진행">
                    <dxe:TextEdit EditValue="{Binding ProgressText, Mode=OneWay}"
                                  IsReadOnly="True" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>

        <!-- ── 목록 · 그림 · 몹 ──────────────────────────────────────── -->
        <Grid Grid.Row="1"
              Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>

            <!-- 그림 목록 -->
            <GroupBox Grid.Column="0"
                      Header="그림">
                <dxe:ListBoxEdit ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <dxe:ListBoxEdit.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- 찍은 것에만 표시를 둔다. 어디까지 했는지 목록에서 바로 보이게. -->
                                
                                <TextBlock Width="14"
                                           Foreground="#2E9E4F"
                                           Text="●"
                                           Visibility="{Binding HasLabel, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </dxe:ListBoxEdit.ItemTemplate>
                </dxe:ListBoxEdit>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch" />

            <!-- 그림 + 사각형 -->
            <GroupBox Grid.Column="2"
                      Header="라벨">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        끌어서 사각형을 그린다. 좌표를 다루는 일이라 컨트롤 하나로 두었다
                        (Markup/LabelCanvas). Boxes 는 컨트롤이 직접 고치고, ViewModel 은
                        바뀐 것을 CollectionChanged 로 안다.
                    -->
                    <Border Grid.Row="0"
                            Background="#20808080">
                        <markup:LabelCanvas Boxes="{Binding Boxes}"
                                            Predictions="{Binding Predictions}"
                                            ClassNames="{Binding ClassNameSnapshot}"
                                            CurrentClassId="{Binding SelectedClassIndex}"
                                            ImageSource="{Binding CurrentImage}"
                                            SelectedIndex="{Binding SelectedBoxIndex, Mode=TwoWay}" />
                    </Border>

                    <dxlc:LayoutGroup Grid.Row="1"
                                      Margin="0,4,0,0"
                                      HorizontalAlignment="Left"
                                      Orientation="Horizontal">
                        <dx:SimpleButton Width="70"
                                         Command="{Binding DoPreviousCommand}"
                                         Content="◀ 이전" />
                        <dx:SimpleButton Width="70"
                                         Command="{Binding DoNextCommand}"
                                         Content="다음 ▶" />
                        <dx:SimpleButton Width="110"
                                         Command="{Binding DoNextUnlabeledCommand}"
                                         Content="안 찍은 다음"
                                         ToolTip="아직 사각형이 없는 그림으로 건너뜁니다." />
                        <dx:SimpleButton Width="105"
                                         Command="{Binding DoDeleteBoxCommand}"
                                         Content="고른 것 지우기"
                                         ToolTip="Delete 키로도 됩니다." />
                        <dx:SimpleButton Width="95"
                                         Command="{Binding DoClearBoxesCommand}"
                                         Content="모두 지우기" />
                        <dx:SimpleButton Width="70"
                                         Command="{Binding DoSaveCommand}"
                                         Content="저장"
                                         ToolTip="그림을 넘길 때 자동으로 저장됩니다." />
                    </dxlc:LayoutGroup>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="3"
                          HorizontalAlignment="Stretch" />

            <!-- 몹 이름 -->
            <GroupBox Grid.Column="4"
                      Header="몹">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 지금 찍는 몹의 색. 그림 위 사각형과 같은 색이어야 헷갈리지 않는다. -->
                    <Border Grid.Row="0"
                            Height="6"
                            Margin="0,0,0,4"
                            Background="{Binding CurrentClassBrush}" />

                    <dxe:ListBoxEdit Grid.Row="1"
                                     ItemsSource="{Binding ClassNames}"
                                     SelectedIndex="{Binding SelectedClassIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="여기서 고른 몹으로 새 사각형이 그려집니다." />

                    <StackPanel Grid.Row="2"
                                Margin="0,4,0,0">
                        <dxe:TextEdit EditValue="{Binding NewClassName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      NullText="몹 이름" />

                        <dxlc:LayoutGroup Margin="0,4,0,0"
                                          Orientation="Horizontal">
                            <dx:SimpleButton Command="{Binding DoAddClassCommand}"
                                             Content="더하기" />
                            <dx:SimpleButton Command="{Binding DoRenameClassCommand}"
                                             Content="이름 바꾸기"
                                             ToolTip="번호는 그대로라 찍어 둔 라벨은 안 흔들립니다." />
                        </dxlc:LayoutGroup>

                        <!--
                            지우기는 두지 않는다. 라벨 파일에는 이름이 아니라 번호가 들어 있어,
                            중간을 지우면 뒤가 당겨져 이미 찍어 둔 것이 다른 몹을 가리킨다.
                        -->
                        <TextBlock Margin="0,6,0,0"
                                   Opacity="0.65"
                                   Text="몹은 지울 수 없습니다. 번호가 당겨져 찍어 둔 라벨이 어긋납니다."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ── 학습 · 찾아보기 ──────────────────────────────────────── -->
        <!--
            dxlc:LayoutControl 로 감싸지 않는다. Auto 행 안에서 내용만큼 늘어나지 않아
            셋째 줄(안내)이 잘렸다 - 실제로 그렇게 사라졌다.
        -->
        <GroupBox Grid.Row="2"
                  Header="학습">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 학습 -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,6,4"
                           VerticalAlignment="Center"
                           Text="바퀴(epoch)" />
                <dxe:SpinEdit Grid.Row="0"
                              Grid.Column="1"
                              Width="80"
                              Margin="0,0,6,4"
                              EditValue="{Binding TrainEpochs, Mode=TwoWay}"
                              IsEnabled="{Binding IsTraining, Converter={StaticResource NotBool}}"
                              MaxValue="500"
                              MinValue="1"
                              ToolTip="적으면 아무것도 못 배우고 많으면 외워 버립니다." />
                <!--
                    작은 몹을 놓칠 때만 키운다. 값이 픽셀 수에 비례해 늘어난다 -
                    320x180 이 220ms, 640x360 이 587ms 다(실측). 학습 시간도 같은 비율이다.
                    바꾸면 반드시 다시 학습해야 한다 - 이미 만들어 둔 모델은 제가 학습된
                    크기를 옆에 들고 있어(detector.json) 여기를 바꿔도 안 흔들린다.
                -->
                <dxe:ComboBoxEdit Grid.Row="0"
                                  Grid.Column="2"
                                  Width="110"
                                  Margin="0,0,6,4"
                                  IsEnabled="{Binding IsTraining, Converter={StaticResource NotBool}}"
                                  IsTextEditable="False"
                                  ItemsSource="{Binding InputSizes}"
                                  SelectedItem="{Binding SelectedInputSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="모델이 실제로 볼 크기. 작은 몹을 놓칠 때만 키웁니다 - 키우면 느려지고 다시 학습해야 합니다." />

                <dx:SimpleButton Grid.Row="0"
                                 Grid.Column="3"
                                 Width="110"
                                 Margin="0,0,6,4"
                                 Command="{Binding DoTrainCommand}"
                                 Content="학습 시작" />
                <dx:SimpleButton Grid.Row="0"
                                 Grid.Column="4"
                                 Width="80"
                                 Margin="0,0,6,4"
                                 Command="{Binding DoCancelTrainCommand}"
                                 Content="멈추기" />
                <dxe:TextEdit Grid.Row="0"
                              Grid.Column="5"
                              Margin="0,0,0,4"
                              EditValue="{Binding TrainingStatus, Mode=OneWay}"
                              IsReadOnly="True"
                              NullText="아직 안 돌렸습니다." />

                <!--
                    찾아보기는 라벨을 고치는 일이 아니라 학습한 모델을 쓰는 일이라 이 칸에 둔다.
                    점선이 모델이 찾은 것, 실선이 사람이 찍은 것이다.
                -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,0,6,4"
                           VerticalAlignment="Center"
                           Text="자신 있는 정도" />
                <!-- 0번 열은 크기 고르기가 차지했다. 여기서는 두 칸을 걸쳐 빈 자리를 없앤다. -->
                <dxe:TrackBarEdit Grid.Row="1"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  Width="195"
                                  Margin="0,0,6,4"
                                  EditValue="{Binding MinimumScore, Mode=TwoWay}"
                                  Maximum="0.95"
                                  Minimum="0.05"
                                  SmallStep="0.05"
                                  TickFrequency="0.1"
                                  ToolTip="낮추면 놓친 것까지 보이지만 헛것도 같이 늘어납니다." />
                <dx:SimpleButton Grid.Row="1"
                                 Grid.Column="3"
                                 Width="110"
                                 Margin="0,0,6,4"
                                 Command="{Binding DoDetectCommand}"
                                 Content="찾아보기"
                                 ToolTip="학습한 모델로 이 그림에서 몹을 찾아 점선으로 겹쳐 그립니다." />
                <dx:SimpleButton Grid.Row="1"
                                 Grid.Column="4"
                                 Width="100"
                                 Margin="0,0,6,4"
                                 Command="{Binding DoClearPredictionsCommand}"
                                 Content="점선 지우기" />
                <dxe:TextEdit Grid.Row="1"
                              Grid.Column="5"
                              EditValue="{Binding DetectStatus, Mode=OneWay}"
                              IsReadOnly="True"
                              NullText="아직 안 찾아봤습니다." />

                <!--
                    libtorch 를 아직 안 받았거나 GPU 가 없을 때만 뜬다.
                    2.2GB 를 받고 나서 "못 씁니다" 라고 하면 안 되므로 누르기 전에 말한다.
                -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="6"
                           Margin="0,4,0,0"
                           Foreground="#BF6A02"
                           Text="{Binding TrainingNotice}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasTrainingNotice, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </GroupBox>

        <!-- ── 알림 ──────────────────────────────────────────────────── -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{Binding StatusText}"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="#BF6A02"
                       Text="저장 안 함"
                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
