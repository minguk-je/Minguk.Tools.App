<UserControl x:Class="Minguk.Tools.Views.LabelingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:markup="clr-namespace:Minguk.Tools.Markup"
             xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
             Style="{DynamicResource BaseControlStyle}"
             FontFamily="{DynamicResource BaseFontFamily}"
             FontSize="{DynamicResource BaseFontSize}"
             DataContext="{dxmvvm:ViewModelSource Type={x:Type viewModels:LabelingViewModel}}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type viewModels:LabelingViewModel},
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="600"
             d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <dxmvvm:BooleanNegationConverter x:Key="NotBool" />
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Command="{Binding OnInitializedCommand}"
                               EventName="Loaded" />

        <!-- 폴더 고르기 · 알림 창. 선언하지 않으면 ViewModel 에서 부를 때 예외로 터진다. -->
        <dxmvvm:FolderBrowserDialogService />
        <dxmvvm:DispatcherService />

        <!--
            libtorch 2.2GB 를 받기 전에 물어보는 데 쓴다. 선언하지 않으면 GetService 가
            null 이 아니라 예외로 터져, Guard 가 삼키고 아무 일도 안 일어난 것처럼 보인다.
            실제로 그랬다 - 학습 시작을 눌러도 화면이 그대로였다.
        -->
        <dx:DXMessageBoxService />
    </dxmvvm:Interaction.Behaviors>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 데이터셋 ──────────────────────────────────────────────── -->
        <dxlc:LayoutControl Grid.Row="0"
                            Padding="0"
                            Orientation="Vertical">
            <dxlc:LayoutGroup Header="데이터셋"
                              Orientation="Horizontal"
                              View="GroupBox">
                <dxlc:LayoutItem Label="폴더">
                    <dxe:TextEdit EditValue="{Binding DatasetRoot, Mode=OneWay}"
                                  IsReadOnly="True"
                                  ToolTip="{Binding DatasetRoot}" />
                </dxlc:LayoutItem>

                <dx:SimpleButton Width="90"
                                 Command="{Binding DoChooseFolderCommand}"
                                 Content="폴더 고르기" />
                <dx:SimpleButton Width="90"
                                 Command="{Binding DoOpenFolderCommand}"
                                 Content="탐색기로" />
                <dx:SimpleButton Width="90"
                                 Command="{Binding DoReloadCommand}"
                                 Content="다시 읽기"
                                 ToolTip="캡처 모니터에서 새로 담은 그림을 가져옵니다." />

                <dxlc:LayoutItem Width="150"
                                 Label="진행">
                    <dxe:TextEdit EditValue="{Binding ProgressText, Mode=OneWay}"
                                  IsReadOnly="True" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>

        <!-- ── 목록 · 그림 · 몹 ──────────────────────────────────────── -->
        <Grid Grid.Row="1"
              Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>

            <!-- 그림 목록 -->
            <GroupBox Grid.Column="0"
                      Header="그림">
                <dxe:ListBoxEdit ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <dxe:ListBoxEdit.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- 찍은 것에만 표시를 둔다. 어디까지 했는지 목록에서 바로 보이게. -->
                                
                                <TextBlock Width="14"
                                           Foreground="#2E9E4F"
                                           Text="●"
                                           Visibility="{Binding HasLabel, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </dxe:ListBoxEdit.ItemTemplate>
                </dxe:ListBoxEdit>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch" />

            <!-- 그림 + 사각형 -->
            <GroupBox Grid.Column="2"
                      Header="라벨">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        끌어서 사각형을 그린다. 좌표를 다루는 일이라 컨트롤 하나로 두었다
                        (Markup/LabelCanvas). Boxes 는 컨트롤이 직접 고치고, ViewModel 은
                        바뀐 것을 CollectionChanged 로 안다.
                    -->
                    <Border Grid.Row="0"
                            Background="#20808080">
                        <markup:LabelCanvas Boxes="{Binding Boxes}"
                                            ClassNames="{Binding ClassNameSnapshot}"
                                            CurrentClassId="{Binding SelectedClassIndex}"
                                            ImageSource="{Binding CurrentImage}"
                                            SelectedIndex="{Binding SelectedBoxIndex, Mode=TwoWay}" />
                    </Border>

                    <dxlc:LayoutGroup Grid.Row="1"
                                      Margin="0,4,0,0"
                                      HorizontalAlignment="Left"
                                      Orientation="Horizontal">
                        <dx:SimpleButton Width="70"
                                         Command="{Binding DoPreviousCommand}"
                                         Content="◀ 이전" />
                        <dx:SimpleButton Width="70"
                                         Command="{Binding DoNextCommand}"
                                         Content="다음 ▶" />
                        <dx:SimpleButton Width="110"
                                         Command="{Binding DoNextUnlabeledCommand}"
                                         Content="안 찍은 다음"
                                         ToolTip="아직 사각형이 없는 그림으로 건너뜁니다." />
                        <dx:SimpleButton Width="90"
                                         Command="{Binding DoDeleteBoxCommand}"
                                         Content="고른 것 지우기"
                                         ToolTip="Delete 키로도 됩니다." />
                        <dx:SimpleButton Width="80"
                                         Command="{Binding DoClearBoxesCommand}"
                                         Content="모두 지우기" />
                        <dx:SimpleButton Width="70"
                                         Command="{Binding DoSaveCommand}"
                                         Content="저장"
                                         ToolTip="그림을 넘길 때 자동으로 저장됩니다." />
                    </dxlc:LayoutGroup>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="3"
                          HorizontalAlignment="Stretch" />

            <!-- 몹 이름 -->
            <GroupBox Grid.Column="4"
                      Header="몹">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 지금 찍는 몹의 색. 그림 위 사각형과 같은 색이어야 헷갈리지 않는다. -->
                    <Border Grid.Row="0"
                            Height="6"
                            Margin="0,0,0,4"
                            Background="{Binding CurrentClassBrush}" />

                    <dxe:ListBoxEdit Grid.Row="1"
                                     ItemsSource="{Binding ClassNames}"
                                     SelectedIndex="{Binding SelectedClassIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="여기서 고른 몹으로 새 사각형이 그려집니다." />

                    <StackPanel Grid.Row="2"
                                Margin="0,4,0,0">
                        <dxe:TextEdit EditValue="{Binding NewClassName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      NullText="몹 이름" />

                        <dxlc:LayoutGroup Margin="0,4,0,0"
                                          Orientation="Horizontal">
                            <dx:SimpleButton Command="{Binding DoAddClassCommand}"
                                             Content="더하기" />
                            <dx:SimpleButton Command="{Binding DoRenameClassCommand}"
                                             Content="이름 바꾸기"
                                             ToolTip="번호는 그대로라 찍어 둔 라벨은 안 흔들립니다." />
                        </dxlc:LayoutGroup>

                        <!--
                            지우기는 두지 않는다. 라벨 파일에는 이름이 아니라 번호가 들어 있어,
                            중간을 지우면 뒤가 당겨져 이미 찍어 둔 것이 다른 몹을 가리킨다.
                        -->
                        <TextBlock Margin="0,6,0,0"
                                   Opacity="0.65"
                                   Text="몹은 지울 수 없습니다. 번호가 당겨져 찍어 둔 라벨이 어긋납니다."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ── 학습 ──────────────────────────────────────────────────── -->
        <dxlc:LayoutControl Grid.Row="2"
                            Padding="0"
                            Orientation="Vertical">
            <dxlc:LayoutGroup Header="학습"
                              Orientation="Vertical"
                              View="GroupBox">
                <dxlc:LayoutGroup Orientation="Horizontal">
                    <dxlc:LayoutItem Width="150"
                                     Label="바퀴(epoch)">
                        <dxe:SpinEdit EditValue="{Binding TrainEpochs, Mode=TwoWay}"
                                      IsEnabled="{Binding IsTraining, Converter={StaticResource NotBool}}"
                                      MaxValue="500"
                                      MinValue="1"
                                      ToolTip="적으면 아무것도 못 배우고 많으면 외워 버립니다." />
                    </dxlc:LayoutItem>

                    <dx:SimpleButton Width="110"
                                     Command="{Binding DoTrainCommand}"
                                     Content="학습 시작" />
                    <dx:SimpleButton Width="80"
                                     Command="{Binding DoCancelTrainCommand}"
                                     Content="멈추기" />

                    <dxlc:LayoutItem Label="진행">
                        <dxe:TextEdit EditValue="{Binding TrainingStatus, Mode=OneWay}"
                                      IsReadOnly="True"
                                      NullText="아직 안 돌렸습니다." />
                    </dxlc:LayoutItem>
                </dxlc:LayoutGroup>

                <!--
                    libtorch 를 아직 안 받았거나 GPU 가 없을 때만 뜬다.
                    2.2GB 를 받고 나서 "못 씁니다" 라고 하면 안 되므로 누르기 전에 말한다.
                -->
                <TextBlock Foreground="#BF6A02"
                           Text="{Binding TrainingNotice}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasTrainingNotice, Converter={StaticResource BoolToVisibility}}" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>

        <!-- ── 알림 ──────────────────────────────────────────────────── -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{Binding StatusText}"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="#BF6A02"
                       Text="저장 안 함"
                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
