<UserControl x:Class="Minguk.Tools.Views.LabelingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:controls="clr-namespace:Minguk.Base.Controls;assembly=Minguk.Base"
             xmlns:dependency="clr-namespace:Minguk.Base.Dependency;assembly=Minguk.Base"
             xmlns:image="clr-namespace:Minguk.Image;assembly=Minguk.Image"
             xmlns:markup="clr-namespace:Minguk.Tools.Markup"
             xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
             Style="{DynamicResource BaseControlStyle}"
             FontFamily="{DynamicResource BaseFontFamily}"
             FontSize="{DynamicResource BaseFontSize}"
             DataContext="{dxmvvm:ViewModelSource Type={x:Type viewModels:LabelingViewModel}}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type viewModels:LabelingViewModel},
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="600"
             d:DesignWidth="1000">

    <!--
        라벨링 화면. 캡처 화면(CaptureMonitorView)과 같은 뼈대다(2026-09-14) -
        위에 도구 줄, 가운데 dxdo:DockLayoutManager, 아래 학습 칸과 상태 줄.
        예전에는 Grid + GridSplitter + dxlc:LayoutControl 이었는데 스플리터를 손으로 놓고 star 비율을 맞추는 일이
        번거로웠다. 도킹은 패널 사이 스플리터가 자동이고 ItemWidth 비율(0.22* : 0.58* : 0.2*)이 바로 된다.
        도킹 조작(끌기·띄우기·닫기·숨기기)은 껐다 - 배치를 저장하지 않으므로 옮겨 봐야 다음에 되돌아온다.
        목록(그림·검출)은 ListBoxEdit 이 아니라 GridControl 이다 - loss 로 정렬하고, 검출 이름은 칸에서 바로 고친다.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 행 번호가 그려지는 RowIndicator 템플릿이 DataTemplate.xaml 에, 숨은 행 번호 열 스타일이 GridColumnStyle.xaml 에 있다 -->
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/DataTemplate.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/GridColumnStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <dxmvvm:BooleanNegationConverter x:Key="NotBool" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Ctrl+Delete = 그림 지우기. 그림 판에 초점이 있어도 된다(그 자리의 Delete 는 사각형 지우기). -->
    <UserControl.InputBindings>
        <KeyBinding Key="Delete"
                    Command="{Binding DoDeleteImageCommand}"
                    Modifiers="Control" />

        <KeyBinding Key="A"
                    Command="{Binding DoDetectCommand}"
                    Modifiers="Alt" />
        <KeyBinding Key="S"
                    Command="{Binding DoAdoptPredictionsCommand}"
                    Modifiers="Alt" />
    </UserControl.InputBindings>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Command="{Binding OnInitializedCommand}"
                               EventName="Loaded" />

        <dxmvvm:DispatcherService />

        <!--
            libtorch 2.2GB 를 받기 전에 물어보는 데 쓴다. 선언하지 않으면 GetService 가
            null 이 아니라 예외로 터져, Guard 가 삼키고 아무 일도 안 일어난 것처럼 보인다.
            실제로 그랬다 - 학습 시작을 눌러도 화면이 그대로였다.
        -->
        <dx:DXMessageBoxService />

        <!-- 영상에서 뽑기 - 영상을 고르는 대화 상자. 빠뜨리면 Guard 가 예외를 삼켜 버튼이 아무 일도 안 한다. -->
        <dxmvvm:OpenFileDialogService />
    </dxmvvm:Interaction.Behaviors>

    <DockPanel LastChildFill="True">

        <!-- ── 데이터셋 (도구 줄) ────────────────────────────────────── -->
        <dxb:ToolBarControl AllowCustomizationMenu="False"
                            AllowQuickCustomization="False"
                            DockPanel.Dock="Top"
                            TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                            TextBlock.FontSize="{DynamicResource BaseFontSize}">

            <!--
                폴더는 보이기만 한다 - Automation 위 칸에서 고른 프로젝트 폴더다. 여기서 고르는 버튼은 뺐다(2026-09-14):
                위는 사격장인데 라벨링만 딴 폴더를 보는 어긋남이 생긴다.
            -->
            <dxb:BarEditItem Content="폴더"
                             EditValue="{Binding DatasetRoot, Mode=OneWay}"
                             EditWidth="420"
                             IsReadOnly="True"
                             ToolTip="{Binding DatasetRoot}">
                <dxb:BarEditItem.EditSettings>
                    <dxe:TextEditSettings />
                </dxb:BarEditItem.EditSettings>
            </dxb:BarEditItem>

            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding DoOpenFolderCommand}"
                               Content="탐색기로"
                               Glyph="{image:FreeImage ResourceName='axialis/basic/16x16/folder.png'}" />
            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding DoReloadCommand}"
                               Content="다시 읽기"
                               Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/refresh.png'}"
                               ToolTip="캡처 화면에서 새로 담은 그림을 가져옵니다." />

            <dxb:BarItemSeparator />

            <!-- 영상에서 뽑기(2026-09-15) - 녹화 영상에서 간격마다 한 장씩 데이터셋에 넣는다. 새 그림은 자동 라벨이 돈다. -->
            <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                               Command="{Binding DoExtractVideoCommand}"
                               Content="영상에서 뽑기"
                               Glyph="{image:FreeImage ResourceName='Axialis/Multimedia/16x16/record-control_record.png'}"
                               ToolTip="녹화한 영상(mp4)을 골라 옆 간격마다 한 장씩 뽑아 이 데이터셋에 넣습니다.&#10;앞 장과 거의 같은 장면(멈춘 화면)은 건너뛰고, 같은 영상을 다시 뽑으면 이미 넣은 장은 건너뜁니다.&#10;넣은 그림은 라벨이 없어 '새 그림은 자동으로' 가 켜져 있으면 자동 라벨이 돕니다 - 학습한 모델이 그 게임을 알 때만 점선이 뜹니다." />
            <dxb:BarEditItem Content="간격"
                             EditValue="{Binding ExtractInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             EditWidth="64"
                             ToolTip="영상 시각으로 몇 초마다 한 장씩 뽑을지. 짧을수록 비슷한 그림이 많아집니다.">
                <dxb:BarEditItem.EditSettings>
                    <dxe:ComboBoxEditSettings IsTextEditable="False"
                                              ItemsSource="{Binding ExtractIntervalChoices}" />
                </dxb:BarEditItem.EditSettings>
            </dxb:BarEditItem>
            <dxb:BarButtonItem Command="{Binding DoCancelExtractVideoCommand}"
                               Content="뽑기 중지"
                               ToolTip="영상에서 뽑던 것을 멈춥니다. 그때까지 뽑은 그림은 남습니다." />

            <dxb:BarItemSeparator />

            <!-- 짧은 글이지만 정적 항목은 한글을 안 그린 적이 있어(캡처 화면 실측) 읽기 전용 칸으로 둔다. -->
            <dxb:BarEditItem Content="진행"
                             EditValue="{Binding ProgressText, Mode=OneWay}"
                             EditWidth="150"
                             IsReadOnly="True">
                <dxb:BarEditItem.EditSettings>
                    <dxe:TextEditSettings />
                </dxb:BarEditItem.EditSettings>
            </dxb:BarEditItem>
        </dxb:ToolBarControl>

        <!-- ── 알림 (상태 줄) ─────────────────────────────────────────── -->
        <DockPanel Margin="4,0,4,4"
                   DockPanel.Dock="Bottom"
                   LastChildFill="True">
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#BF6A02"
                       DockPanel.Dock="Right"
                       Text="저장 안 함"
                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
            <dxe:TextEdit EditValue="{Binding StatusText, Mode=OneWay}"
                          IsReadOnly="True"
                          ShowBorder="False" />
        </DockPanel>


        <!-- ── (목록 | 그림 | 검출) / 학습 - dxdo:DockLayoutManager ─────────── -->
        <!--
            캡처 화면과 같은 방식. 끌기·띄우기·닫기·숨기기는 막는다 - 배치를 저장하지 않아서 옮겨 봐야 다음에 되돌아오고,
            닫으면 되살릴 길이 없다. 남는 것은 패널 사이 스플리터와 ItemWidth·ItemHeight 비율뿐이다.
            세로 그룹: 위가 목록·그림·검출 가로 그룹(*), 아래가 학습 패널(내용 높이만큼, 스플리터로 늘릴 수도 있다).
        -->
        <dxdo:DockLayoutManager FloatingMode="Desktop">
            <dxdo:LayoutGroup Orientation="Vertical">
                <dxdo:LayoutGroup ItemHeight="*"
                                  Orientation="Horizontal">

                    <!-- 그림 목록. loss 로 정렬해 혼자 높은 그림(라벨이 틀렸거나 다시 찍을 장면)을 바로 찾는다. -->
                    <dxdo:LayoutPanel x:Name="ImagesDockPanel"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowFloat="False"
                                      AllowHide="False"
                                      Caption="그림"
                                      ItemWidth="{Binding ImagesPanelWidth, Mode=OneWay, Converter={markup:PixelsToGridLengthConverter}, FallbackValue=0.22*}"
                                      ShowCaption="False">
                        <!--
                            행 번호 칸(인디케이터) 폭을 행 수에 맞춰 늘리기 위한 틀(캡처 화면과 같다). 숨은 Border 가
                            SharedSizeGroup 으로 "가장 넓은 행 번호" 만큼 넓어지고, 그 폭을 TableView 의 IndicatorWidth 로 되돌린다.
                            안 물리면 세 자리부터 앞이 잘린다.
                        -->
                        <Grid Grid.IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"
                                                  SharedSizeGroup="RowNumberGroup" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="ImagesRowNumberSizeProxy"
                                    Margin="-4"
                                    Visibility="Hidden" />

                            <!--
                                열은 내용 너비(IsColumnAutoWidth → 모든 열 Auto)고, 패널은 그 열들을 다 합친 너비다(ImagesPanelWidth, ViewModel 이
                                그리드 배치가 바뀔 때마다 잰다). 그래서 이름이 길어지면 패널이 같이 넓어지고 가로 스크롤이 안 생긴다.
                                ViewModel 은 ImagesGridObjectService 로 이 그리드를 찾는다.
                            -->
                            <controls:BaseGridControl Grid.Column="0"
                                                      Grid.ColumnSpan="2"
                                                      dependency:GridControlDependency.IsRowNumber="True"
                                                      AutoGenerateColumns="None"
                                                      ItemsSource="{Binding Items}"
                                                      SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ShowBorder="False">
                                <!-- 목록에서 Delete = 그림 지우기(탐색기·VS 솔루션 탐색기와 같다). 그림 판의 Delete 는 사각형 지우기라 여기만. -->
                                <dxg:GridControl.InputBindings>
                                    <KeyBinding Key="Delete"
                                                Command="{Binding DoDeleteImageCommand}" />
                                </dxg:GridControl.InputBindings>
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:UIObjectService x:Name="ImagesGridObjectService" />
                                    <!-- 정렬·열 순서를 문자열로 뽑고 되돌린다. ViewModel 이 이 이름으로 꺼내 설정에 남긴다. -->
                                    <dxmvvm:LayoutSerializationService x:Name="ImagesGridLayoutService" />
                                </dxmvvm:Interaction.Behaviors>

                                <dxg:GridControl.View>
                                    <!-- 열을 Auto 로 놓는 것은 ViewModel 이 InitializeControls 에서 한다(ApplyColumnAutoWidth) - 첨부 속성은 열이 생기기 전에 돌아 헛일이다. -->
                                    <controls:BaseTableView AllowEditing="False"
                                                            IndicatorWidth="{Binding Path=(Border.ActualWidth), ElementName=ImagesRowNumberSizeProxy, Mode=OneWay}"
                                                            ShowGroupPanel="False" />
                                </dxg:GridControl.View>

                                <!-- 행 번호용 숨은 언바운드 열. 왼쪽 인디케이터가 이 값을 쓴다. -->
                                <dxg:GridColumn Style="{StaticResource GridColumn.RowNumber.Style}" />

                                <!-- 찍은 것에만 표시를 둔다. 어디까지 했는지 목록에서 바로 보이게. -->
                                <dxg:GridColumn Width="24" FieldName="HasLabel" Header="" ToolTip="사각형을 찍어 저장한 그림">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center"
                                                       Foreground="#2E9E4F"
                                                       Text="●"
                                                       Visibility="{Binding RowData.Row.HasLabel, Converter={StaticResource BoolToVisibility}}" />
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn Width="120" FieldName="Name" Header="그림" />
                                <!-- 학습 뒤 다시 찾은 개수. 다 못 찾았거나 헛것이 있으면 주황. -->
                                <dxg:GridColumn Width="80" FieldName="Recognition" Header="재현율">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding RowData.Row.Recognition}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#2E9E4F" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RowData.Row.RecognitionIsPoor}"
                                                                         Value="True">
                                                                <Setter Property="Foreground" Value="#BF6A02" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </controls:BaseGridControl>
                        </Grid>
                    </dxdo:LayoutPanel>

                    <!-- 그림 + 사각형 -->
                    <dxdo:LayoutPanel x:Name="LabelDockPanel"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowFloat="False"
                                      AllowHide="False"
                                      Caption="라벨"
                                      ItemWidth="0.58*"
                                      ShowCaption="False">
                        <DockPanel LastChildFill="True">

                            <!-- 그림 넘기기·사각형 손보기·확대. 버튼 줄 대신 도구 줄이다(캡처 화면과 같은 모양). -->
                            <dxb:ToolBarControl AllowCustomizationMenu="False"
                                                AllowQuickCustomization="False"
                                                DockPanel.Dock="Top"
                                                TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                                                TextBlock.FontSize="{DynamicResource BaseFontSize}">
                                <dxb:BarButtonItem Command="{Binding DoPreviousCommand}"
                                                   Content="◀ 이전" />
                                <dxb:BarButtonItem Command="{Binding DoNextCommand}"
                                                   Content="다음 ▶" />
                                <dxb:BarButtonItem Command="{Binding DoNextUnlabeledCommand}"
                                                   Content="안 찍은 다음"
                                                   ToolTip="아직 사각형이 없는 그림으로 건너뜁니다." />
                                <dxb:BarButtonItem Command="{Binding DoCopyPreviousCommand}"
                                                   Content="앞 장 가져오기"
                                                   ToolTip="앞에서 가장 가까운, 라벨이 있는 그림의 사각형을 이 그림에 더합니다. 가져온 뒤 끌어서 맞추세요." />
                                <dxb:BarButtonItem Command="{Binding DoCopyBoxesCommand}"
                                                   Content="복사"
                                                   KeyGesture="Ctrl+C"
                                                   ToolTip="지금 그림의 사각형을 복사합니다(Ctrl+C). 앞 장 가져오기와 달리 아무 그림에서나 복사해 몇 장 뒤에든 붙일 수 있습니다." />
                                <dxb:BarButtonItem Command="{Binding DoPasteBoxesCommand}"
                                                   Content="붙여넣기"
                                                   KeyGesture="Ctrl+V"
                                                   ToolTip="복사해 둔 사각형을 이 그림에 더합니다(Ctrl+V). 지금 있는 것은 지우지 않습니다." />

                                <dxb:BarItemSeparator />

                                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                                   Command="{Binding DoDeleteBoxCommand}"
                                                   Content="고른 것 지우기"
                                                   Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/delete.png'}"
                                                   ToolTip="Delete 키로도 됩니다." />
                                <dxb:BarButtonItem Command="{Binding DoClearBoxesCommand}"
                                                   Content="모두 지우기" />
                                <!-- 그림 자체를 치운다(2026-09-15) - 영상에서 뽑다 섞인 쓸모없는 장면. 사각형 지우기와 헷갈리지 않게 이름에 "그림" 을 넣는다. -->
                                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                                   Command="{Binding DoDeleteImageCommand}"
                                                   Content="그림 지우기"
                                                   Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/picture-delete.png'}"
                                                   ToolTip="지금 그림을 라벨 파일과 함께 휴지통으로 보내고 다음 그림으로 갑니다(묻지 않습니다).&#10;잘못 지웠으면 휴지통에서 되살리고 '다시 읽기'.&#10;Ctrl+Delete, 또는 그림 목록에서 Delete." />
                                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                                   Command="{Binding DoSaveCommand}"
                                                   Content="저장"
                                                   Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/save.png'}"
                                                   ToolTip="그림을 넘길 때 자동으로 저장됩니다." />

                                <dxb:BarItemSeparator />

                                <!--
                                    그림 판 확대 - 캡처 미리보기와 같은 조작(2026-09-14). 콤보로 고르거나 직접 치고, 판 위에서
                                    휠은 마우스 아래를 두고 확대, 오른쪽 끌기는 화면 옮기기. 배율은 캔버스(LabelCanvas.Zoom)와
                                    양방향이라 휠로 바꾼 값이 여기에도 뜬다. 값이 Decimal 로 올 수 있어 ToDoubleConverter 로 잇는다.
                                -->
                                <dxb:BarEditItem Content="확대"
                                                 EditValue="{Binding LabelZoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={markup:ToDoubleConverter}}"
                                                 EditWidth="64"
                                                 ToolTip="그림을 키우고 줄입니다. 100% 면 창에 맞춤. 판 위에서 휠로도 되고, 오른쪽 버튼으로 끌면 옮겨집니다.">
                                    <dxb:BarEditItem.EditSettings>
                                        <dxe:ComboBoxEditSettings DisplayFormat="0%"
                                                                  IsTextEditable="True"
                                                                  ItemsSource="{Binding ZoomOptions}" />
                                    </dxb:BarEditItem.EditSettings>
                                </dxb:BarEditItem>
                                <dxb:BarButtonItem Command="{Binding DoZoomResetCommand}"
                                                   Content="맞춤"
                                                   ToolTip="확대를 1(창에 맞춤) 로 되돌립니다." />
                            </dxb:ToolBarControl>

                            <!--
                                끌어서 사각형을 그린다. 좌표를 다루는 일이라 컨트롤 하나로 두었다
                                (Markup/LabelCanvas). Boxes 는 컨트롤이 직접 고치고, ViewModel 은
                                바뀐 것을 CollectionChanged 로 안다. 확대·옮기기도 그 안이 한다 -
                                LayoutTransform 으로 키우면 테두리·글자까지 굵어져 경계가 안 보인다.
                            -->
                            <!--
                                학습 묶음 보기(학습 칸의 체크)를 켜면 학습하는 동안 라벨 판 위에 묶음 그림을 덮는다(2026-09-15).
                                뼈대가 아니라 같은 자리에 둘을 겹치는 것이라 Grid 한 칸이다. 끄거나 학습이 끝나면 라벨 판이 그대로 돌아온다.
                            -->
                            <Grid>
                                <Border Background="#20808080">
                                    <markup:LabelCanvas Boxes="{Binding Boxes}"
                                                        ClassNames="{Binding ClassNameSnapshot}"
                                                        CurrentClassId="{Binding SelectedClassIndex}"
                                                        ImageSource="{Binding CurrentImage}"
                                                        Predictions="{Binding Predictions}"
                                                        SelectedIndex="{Binding SelectedBoxIndex, Mode=TwoWay}"
                                                        Zoom="{Binding LabelZoom, Mode=TwoWay}" />
                                </Border>

                                <DockPanel Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                           LastChildFill="True"
                                           Visibility="{Binding IsTrainingBatchVisible, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Margin="6,4"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Top"
                                               TextWrapping="Wrap">
                                        <Run FontWeight="Bold"
                                             Text="학습 묶음" />
                                        <Run Text="{Binding TrainProgressLabel, Mode=OneWay}" />
                                        <Run Foreground="#666666"
                                             Text=" - 모델이 지금 한 번에 받는 그림 묶음입니다. 네 장을 이어 붙이고 비틀어(크기·자리·색) 바퀴마다 다르게 봅니다. 바퀴마다 새로 바뀝니다. 라벨을 고치려면 체크를 끄세요." />
                                    </TextBlock>
                                    <Image Source="{Binding TrainingBatchImage}"
                                           Stretch="Uniform" />
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </dxdo:LayoutPanel>

                    <!-- 검출 이름 -->
                    <dxdo:LayoutPanel x:Name="ClassesDockPanel"
                                      AllowClose="False"
                                      AllowDrag="False"
                                      AllowFloat="False"
                                      AllowHide="False"
                                      Caption="검출"
                                      ItemWidth="0.2*"
                                      ShowCaption="False">
                        <dxmvvm:Interaction.Behaviors>
                            <!-- ViewModel 이 이 패널의 너비를 설정에 남기고 되돌린다(ClassesPanelWidth). 그림 패널·학습 패널은 내용에서 매번 재므로 안 남긴다. -->
                            <dxmvvm:UIObjectService x:Name="ClassesPanelObjectService" />
                        </dxmvvm:Interaction.Behaviors>
                        <DockPanel LastChildFill="True">

                            <!--
                                이름을 따로 적는 칸은 없다(2026-09-14). 더하기는 임시 이름("검출 3")으로 넣고 바로 이름 칸을 열고,
                                그 뒤로는 이름 칸을 더블 클릭해 고친다 - VS 솔루션 탐색기와 같다. 지우기는 아무 라벨에도 안 쓰인 검출만 된다.
                            -->
                            <dxb:ToolBarControl AllowCustomizationMenu="False"
                                                AllowQuickCustomization="False"
                                                DockPanel.Dock="Top"
                                                TextBlock.FontFamily="{DynamicResource BaseFontFamily}"
                                                TextBlock.FontSize="{DynamicResource BaseFontSize}">
                                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                                   Command="{Binding DoAddClassCommand}"
                                                   Content="더하기"
                                                   Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/add.png'}"
                                                   ToolTip="임시 이름으로 넣고 바로 이름 칸을 엽니다. 이름은 나중에 더블 클릭으로 고칩니다." />
                                <dxb:BarButtonItem BarItemDisplayMode="ContentAndGlyph"
                                                   Command="{Binding DoDeleteClassCommand}"
                                                   Content="지우기"
                                                   Glyph="{image:FreeImage ResourceName='Axialis/Basic/16x16/delete.png'}"
                                                   ToolTip="고른 검출을 지웁니다. 아무 라벨에도 안 쓰인 검출만 지워집니다 - 라벨에는 번호가 들어 있어 뒤 번호가 당겨지는데, 그 라벨 파일도 같이 고칩니다. 쓰인 검출이면 어느 파일인지 상태 줄에 적습니다." />
                            </dxb:ToolBarControl>

                            <!-- 지금 찍는 검출의 색. 그림 위 사각형과 같은 색이어야 헷갈리지 않는다. -->
                            <Border Height="6"
                                    Margin="0,0,0,4"
                                    Background="{Binding CurrentClassBrush}"
                                    DockPanel.Dock="Top" />

                            <!--
                                이름·색은 그리드 안에서 고친다. 정렬은 막는다 - 줄의 자리가 곧 검출 번호다(번호 열 대신 행 번호 인디케이터다).
                                처음에는 편집이 안 되고(ShowingEditor 에서 막음) 칸을 더블 클릭했을 때만 그 칸이 열린다 - ViewModel 이
                                ClassGridObjectService 로 이 그리드를 찾아 그렇게 한다. 여러 줄을 골라 지우면 고른 것을 다 지운다.
                            -->
                            <Grid Grid.IsSharedSizeScope="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"
                                                      SharedSizeGroup="RowNumberGroup" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="ClassesRowNumberSizeProxy"
                                        Margin="-4"
                                        Visibility="Hidden" />

                                <controls:BaseGridControl Grid.Column="0"
                                                          Grid.ColumnSpan="2"
                                                          dependency:GridControlDependency.IsRowNumber="True"
                                                          AutoGenerateColumns="None"
                                                          ItemsSource="{Binding Classes}"
                                                          SelectedItem="{Binding SelectedClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ShowBorder="False"
                                                          ToolTip="여기서 고른 검출로 새 사각형이 그려집니다. 이름·색은 칸을 더블 클릭해 고칩니다.">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:UIObjectService x:Name="ClassGridObjectService" />
                                        <dxmvvm:LayoutSerializationService x:Name="ClassGridLayoutService" />
                                    </dxmvvm:Interaction.Behaviors>

                                    <dxg:GridControl.View>
                                        <controls:BaseTableView AllowEditing="True"
                                                                AllowSorting="False"
                                                                IndicatorWidth="{Binding Path=(Border.ActualWidth), ElementName=ClassesRowNumberSizeProxy, Mode=OneWay}"
                                                                ShowGroupPanel="False"
                                                                ShowSearchPanelMode="Never" />
                                    </dxg:GridControl.View>

                                    <!-- 행 번호용 숨은 언바운드 열. 왼쪽 인디케이터가 이 값을 쓴다. -->
                                    <dxg:GridColumn Style="{StaticResource GridColumn.RowNumber.Style}" />

                                    <!-- 사각형 색. 처음에는 번호에서 만든 기본 색이고, 더블 클릭해 고르면 class-colors.json 에 남는다. -->
                                    <dxg:GridColumn Width="40" AllowEditing="True" FieldName="Color" Header="색">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:PopupColorEditSettings DisplayMode="Color" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn Width="*" AllowEditing="True" FieldName="Name" Header="이름" />
                                </controls:BaseGridControl>
                            </Grid>
                        </DockPanel>
                    </dxdo:LayoutPanel>
                </dxdo:LayoutGroup>
                <!-- ── 학습 · 찾아보기 ──────────────────────────────────────── -->
                <!--
                    도킹 패널 안이다(2026-09-14). 내용은 Auto 높이인데 도킹 패널은 star·픽셀로만
                    잡히므로, 내용(TrainingContent)의 ActualHeight 를 픽셀 ItemHeight 로 묶는다(PixelsToGridLengthConverter, 여백 10). 190px 로 못 박았더니 모델 줄 아래가 비었다. 안의 ScrollViewer 는 스플리터로 줄였을 때 잘리지 않게 두는 것이다.
                    스플리터를 끌면 지역값이 바인딩을 덮어 그 뒤로는 손으로 잡은 높이다.
                    폼 칸은 dxlc:LayoutControl 이다(화면 규칙). 예전에 Auto 행 안에서 셋째 줄이 잘렸던 것은 높이를 안 주는 Grid 행 탓이었다 -
                    여기서는 LayoutControl 의 제 높이가 패널 높이가 되므로 잘릴 것이 없다. labeling-screen 검사가 패널·내용 높이를 잰다.
                -->
                <dxdo:LayoutPanel x:Name="TrainingDockPanel"
                                  AllowClose="False"
                                  AllowDrag="False"
                                  AllowFloat="False"
                                  AllowHide="False"
                                  Caption="학습"
                                  ItemHeight="{Binding ActualHeight, ElementName=TrainingContent, Mode=OneWay, Converter={markup:PixelsToGridLengthConverter}, ConverterParameter=10}"
                                  ShowCaption="False">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <!--
                            VerticalAlignment=Top 이 꼭 있어야 한다. ScrollViewer 는 내용이 뷰포트보다 작으면 뷰포트 높이로 늘려 배치하므로,
                            안 붙이면 ActualHeight = 패널 높이가 되어 "패널 높이 = 내용 + 10" 이 배치마다 10px 씩 자라는 되먹임이 된다(실측: 아래가 점점 넓어짐).
                        -->
                        <dxlc:LayoutControl x:Name="TrainingContent"
                                            Padding="4"
                                            VerticalAlignment="Top"
                                            Orientation="Vertical">

                            <!--
                                검출에 쓸 모델을 고른다(2026-09-14). 목록은 데이터셋 폴더의 보관본(detector.<이름>.onnx).
                                고르면 그 모델이 검출 자리(detector.onnx)에 앉고 켜 둔 스크립트·플레이 화면도 따라온다. 옆 글은 그 모델의 쪽지 한 줄.
                                시험은 YOLO11n, 넘겨줄 때는 D-FINE-N (YOLO 는 AGPL). 학습 중에는 못 바꾼다.
                            -->
                            <dxlc:LayoutItem Label="쓰는 모델">
                                <DockPanel LastChildFill="True">
                                    <dxe:ComboBoxEdit Width="280"
                                                      Margin="0,0,8,0"
                                                      DisplayMember="Name"
                                                      DockPanel.Dock="Left"
                                                      IsEnabled="{Binding IsTraining, Converter={StaticResource NotBool}}"
                                                      IsTextEditable="False"
                                                      ItemsSource="{Binding ModelChoices}"
                                                      NullText="(목록에 없는 모델)"
                                                      SelectedItem="{Binding SelectedModelChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="검출에 쓸 모델. 시험은 YOLO11n, 넘겨줄 때는 D-FINE-N 으로 고릅니다(YOLO 는 AGPL)." />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="#666666"
                                               Text="{Binding ModelSummary}"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </dxlc:LayoutItem>

                            <!-- 학습 -->
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem Width="140"
                                                 Label="바퀴(epoch)"
                                                 ToolTip="{Binding EpochHelp}">
                                    <dxe:SpinEdit EditValue="{Binding TrainEpochs, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsTraining, Converter={StaticResource NotBool}}"
                                                  MaxValue="500"
                                                  MinValue="1"
                                                  ToolTip="{Binding EpochHelp}" />
                                </dxlc:LayoutItem>
                                <!-- 학습 크기(YOLO) - 작은 검출을 잘 찾게 960·1280 까지(2026-09-15). D-FINE 은 640 고정이라 YOLO 일 때만 켜진다. -->
                                <dxlc:LayoutItem Width="150"
                                                 Label="학습 크기"
                                                 ToolTip="{Binding ImageSizeHelp}">
                                    <dxe:ComboBoxEdit DisplayFormatString="{}{0} px"
                                                      IsEnabled="{Binding CanChooseYoloImageSize}"
                                                      IsTextEditable="False"
                                                      ItemsSource="{Binding YoloImageSizes}"
                                                      SelectedItem="{Binding SelectedYoloImageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="{Binding ImageSizeHelp}" />
                                </dxlc:LayoutItem>
                                <!-- 아래 '쓰는 모델' 콤보에 고른 모델로 학습한다(TrainButtonText). YOLO 는 yolo-venv, D-FINE 은 제 저장소를 돌린다. -->
                                <dx:SimpleButton Width="131"
                                                 HorizontalAlignment="Left"
                                                 Command="{Binding DoTrainCommand}"
                                                 Content="{Binding TrainButtonText}"
                                                 ToolTip="아래 &apos;쓰는 모델&apos; 콤보에 고른 모델로 학습합니다.&#10;YOLO11n - 파이썬(yolo-venv), 98장 60바퀴에 약 5분.&#10;D-FINE-N - D-FINE 저장소(학습 폴더), 같은 데이터로 약 1시간 45분. 끝에 DirectML 고치기까지 자동입니다.&#10;둘 다 끝나면 검출에 바로 들어갑니다. 넘겨줄 모델은 D-FINE-N 입니다(YOLO 는 AGPL)." />
                                <dx:SimpleButton Width="70"
                                                 Command="{Binding DoCancelTrainCommand}"
                                                 Content="중지" />
                                <dxlc:LayoutItem Label="상태">
                                    <dxe:TextEdit EditValue="{Binding TrainingStatus, Mode=OneWay}"
                                                  IsReadOnly="True"
                                                  NullText="아직 안 돌렸습니다." />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>

                            <!--
                                찾아보기는 라벨을 고치는 일이 아니라 학습한 모델을 쓰는 일이라 이 칸에 둔다.
                                점선이 모델이 찾은 것, 실선이 사람이 찍은 것이다.
                            -->
                            <dxlc:LayoutGroup Orientation="Horizontal">
                                <dxlc:LayoutItem Width="255"
                                                 Label="신뢰도">
                                    <dxe:TrackBarEdit EditValue="{Binding MinimumScore, Mode=TwoWay}"
                                                      Maximum="0.95"
                                                      Minimum="0.05"
                                                      SmallStep="0.05"
                                                      TickFrequency="0.1"
                                                      TickItemDisplayMode="Tick"
                                                      ToolTip="낮추면 놓친 것까지 보이지만 헛것도 같이 늘어납니다."
                                                      ValueToolTipPlacement="TopLeft" />
                                </dxlc:LayoutItem>
                                <!-- 셋이 한 묶음이다: 모델이 점선으로 그려 주면(자동 라벨) 사람이 확정하거나 지운다. 지우는 것은 점선뿐 - 찍어 둔 라벨은 안 건드린다. -->
                                <dx:SimpleButton Width="100"
                                                 Command="{Binding DoDetectCommand}"
                                                 Content="자동 라벨(_A)"
                                                 ToolTip="학습한 모델로 이 그림에서 검출을 찾아 점선으로 겹쳐 그립니다. 아직 라벨이 아닙니다 - 확정해야 저장됩니다." />
                                <dx:SimpleButton Width="100"
                                                 Command="{Binding DoAdoptPredictionsCommand}"
                                                 Content="라벨 확정(_S)"
                                                 ToolTip="자동 라벨(점선)을 전부 내 라벨로 굳힙니다. 틀린 것은 굳힌 뒤 골라서 지우세요. 하나만 확정하려면 그림에서 그 점선을 누르세요." />
                                <!-- "라벨 지우기" 로 두면 옆의 "고른 것 지우기 · 모두 지우기" 와 헷갈린다 - 지우는 것이 점선뿐임을 이름에 담는다. -->
                                <dx:SimpleButton Width="120"
                                                 Command="{Binding DoClearPredictionsCommand}"
                                                 Content="자동 라벨 지우기"
                                                 ToolTip="확정하지 않은 자동 라벨(점선)만 지웁니다. 내가 찍어 둔 라벨(실선)은 그대로입니다." />
                                <!-- 라벨 없는 그림으로 넘어가면 자동 라벨을 알아서(2026-09-15). 학습한 모델이 있어야 돈다. -->
                                <dxe:CheckEdit HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Content="새 그림은 자동으로"
                                               IsChecked="{Binding AutoDetectNewImages, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               ToolTip="라벨이 하나도 없는 그림으로 넘어가면 '자동 라벨' 을 알아서 누릅니다(멈춘 뒤 0.25초).&#10;학습한 모델이 있어야 합니다 - 몇십 장을 손으로 찍고 한 번 학습하면 그다음부터 점선이 뜹니다.&#10;찍어 둔 라벨이 있는 그림은 건드리지 않고, 학습하는 동안은 쉽니다. 맞으면 '라벨 확정' 을 누르세요." />
                                <dxlc:LayoutItem Label="결과">
                                    <dxe:TextEdit EditValue="{Binding DetectStatus, Mode=OneWay}"
                                                  IsReadOnly="True"
                                                  NullText="아직 안 찾아봤습니다."
                                                  TextWrapping="NoWrap" />
                                </dxlc:LayoutItem>
                            </dxlc:LayoutGroup>

                            <!--
                                진행 막대와 loss 꺾은선. 글 한 줄로는 "돌고 있나" 밖에 안 보인다.
                                loss 가 내려가는지 제자리인지가 보여야 15분짜리 학습을 헛돌리지 않는다 -
                                실제로 학습률이 높아 제자리인 것을 모른 채 100바퀴를 돌렸다.
                            -->
                            <!--
                                꺾은선(44px)은 이 줄에 안 넣는다 - 넣으면 줄 높이가 44 가 되어 라벨 칸은 위, 체크는 가운데로 제각각 앉았다(실측 PNG).
                                진행 라벨(TrainProgressLabel)은 학습 전에는 빈 글이라 LayoutItem 의 Label 로 쓰면 칸이 통째로 빈 것처럼 보인다 -
                                라벨은 "진행" 으로 두고 그 글은 막대 오른쪽에 적는다. 막대는 0% 일 때 테두리가 없으면 안 보여 ShowBorder 를 켠다.
                            -->
                            <dxlc:LayoutGroup HorizontalAlignment="Left"
                                              Orientation="Horizontal">
                                <dxlc:LayoutItem Width="330"
                                                 HorizontalAlignment="Left"
                                                 Label="진행">
                                    <DockPanel HorizontalAlignment="Stretch"
                                               LastChildFill="True">
                                        <TextBlock MinWidth="70"
                                                   Margin="6,0,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Right"
                                                   Text="{Binding TrainProgressLabel}" />
                                        <dxe:ProgressBarEdit Height="18"
                                                             VerticalAlignment="Center"
                                                             EditValue="{Binding TrainPercent, Mode=OneWay}"
                                                             Maximum="100"
                                                             Minimum="0"
                                                             ShowBorder="True"
                                                             ToolTip="학습이 어디까지 왔는지. YOLO 는 묶음마다 움직이고, D-FINE 은 바퀴가 끝날 때 움직입니다." />
                                    </DockPanel>
                                </dxlc:LayoutItem>

                                <!-- 없어졌던 "학습 중인 그림 보기" 를 묶음으로 되살렸다(2026-09-15). 켜면 학습하는 동안 라벨 판 자리에 묶음 그림이 덮인다. -->
                                <dxe:CheckEdit Margin="30,0,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Content="학습 묶음 보기"
                                               IsChecked="{Binding ShowTrainingBatch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               ToolTip="켜면 학습하는 동안 라벨 판 자리에 모델이 지금 받는 그림 묶음(라벨 상자 포함)을 띄웁니다. 바퀴마다 바뀝니다.&#10;YOLO 는 여러 장을 이어 붙여 묶음으로 배워서 한 장씩이 아니라 묶음을 보여 줍니다. D-FINE 학습은 아직 그림을 보내지 않습니다.&#10;켜 둔 동안은 라벨을 고칠 수 없습니다 - 끄면 곧바로 라벨 판이 돌아옵니다." />

                                <!-- YOLO 학습이 쓸 카드. 따로 뜨는 파이썬이라 다음 학습부터 바로 먹는다. -->
                                <dxlc:LayoutItem Width="290"
                                                 Margin="30,0,0,0"
                                                 Label="GPU">
                                    <dxe:ComboBoxEdit IsTextEditable="False"
                                                      ItemsSource="{Binding GpuOptions}"
                                                      SelectedItem="{Binding SelectedGpuOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="YOLO 학습이 쓸 그래픽카드. 게임이 도는 카드를 피하면 학습도 게임도 덜 느려집니다." />
                                </dxlc:LayoutItem>

                                <TextBlock HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Foreground="#BF6A02"
                                           Text="{Binding GpuNotice}" />
                            </dxlc:LayoutGroup>

                            <!-- loss 꺾은선은 한 줄을 통째로 쓴다 - 넓을수록 내려가는지 제자리인지가 잘 보인다. -->
                            <dxlc:LayoutItem Label="loss">
                                <markup:LossSparkline Height="44"
                                                      ToolTip="학습 loss. 내려가면 배우는 중, 제자리면 학습률이나 데이터를 봐야 합니다. 로그 눈금입니다."
                                                      Values="{Binding LossHistory}" />
                            </dxlc:LayoutItem>

                        </dxlc:LayoutControl>
                    </ScrollViewer>
                </dxdo:LayoutPanel>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>

    </DockPanel>
</UserControl>
