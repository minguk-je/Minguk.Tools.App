<UserControl x:Class="Minguk.Tools.Views.InputDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:viewModels="clr-namespace:Minguk.Tools.ViewModels"
             Style="{DynamicResource BaseControlStyle}"
             FontFamily="{DynamicResource BaseFontFamily}"
             FontSize="{DynamicResource BaseFontSize}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type viewModels:InputDialogViewModel},
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="160"
             d:DesignWidth="260">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/ControlTemplate.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/DataTemplate.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/GridColumnStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dx:CurrentDialogService ClosingCommand="{Binding OnClosingCommand}" />
        <dx:DXMessageBoxService />
    </dxmvvm:Interaction.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Text="이름 : " />
                <dxe:TextEdit Width="200"
                              Text="{Binding ProtocolName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </StackPanel>

        <dx:ThemedWindowDialogButtonsControl Grid.Row="1"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top">
            <!-- Glyph="{Binding UICommand.Glyph, RelativeSource={RelativeSource Self}}" -->
            <dx:ThemedWindowDialogButton Command="{Binding UICommand.Command, RelativeSource={RelativeSource Self}}"
                                         Content="{Binding UICommand.Caption, RelativeSource={RelativeSource Self}}"
                                         UICommand="{Binding UICommandApply}" />
            <!-- Glyph="{Binding UICommand.Glyph, RelativeSource={RelativeSource Self}}" -->
            <dx:ThemedWindowDialogButton Command="{Binding UICommand.Command, RelativeSource={RelativeSource Self}}"
                                         Content="{Binding UICommand.Caption, RelativeSource={RelativeSource Self}}"
                                         UICommand="{Binding UICommandCancel}" />
        </dx:ThemedWindowDialogButtonsControl>
    </Grid>
</UserControl>
