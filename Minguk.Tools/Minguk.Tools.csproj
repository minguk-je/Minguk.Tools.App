<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IncludePackageReferencesDuringMarkupCompilation>true</IncludePackageReferencesDuringMarkupCompilation>
		<InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Microsoft.Extensions.Configuration.Binder.SourceGeneration</InterceptorsPreviewNamespaces>
		<Platforms>x64</Platforms>
		<!-- 플랫폼을 지정하지 않고 빌드할 때의 기본값 (sln/CLI 에서 명시하면 그 값이 우선) -->
		<Platform Condition="'$(Platform)' == 'AnyCPU'">x64</Platform>
	</PropertyGroup>

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- Windows.Graphics.Capture(WGC) 를 쓰려면 windows10 TFM 이 필요하다. WinRT 프로젝션이 이 TFM 에서만 들어온다.
		     TargetPlatformVersion 22621 : GraphicsCaptureSession.IsBorderRequired 를 컴파일하기 위한 최소치.
		     SupportedOSPlatformVersion 19041 : 실제로 요구하는 최소 OS (Windows 10 2004). -->
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>enable</Nullable>
		<RootNamespace>Minguk.Tools</RootNamespace>
		<AssemblyName>Minguk.Tools</AssemblyName>
		<ApplicationIcon>Resource\CI_Minguk.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- App.xaml 에 Main 을 두지 않고 Main.cs 에서 직접 띄운다 (Velopack 초기화가 Application 생성보다 먼저여야 함) -->
		<StartupObject>Minguk.Tools.App</StartupObject>
	</PropertyGroup>

	<ItemGroup>
		<!-- DevExpress WPF - TamsTools 와 같은 버전으로 고정한다. 버전이 어긋나면 테마 리소스 키가 안 맞는다. -->
		<PackageReference Include="DevExpress.Mvvm" Version="26.1.3" />
		<PackageReference Include="DevExpress.Images" Version="26.1.3" />
		<PackageReference Include="DevExpress.Wpf" Version="26.1.3" />
		<PackageReference Include="DevExpress.Wpf.Core" Version="26.1.3" />
		<PackageReference Include="DevExpress.Wpf.ThemesLW" Version="26.1.3" />

		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="NLog" Version="6.2.0" />
		<PackageReference Include="NLog.Extensions.Logging" Version="6.2.0" />
		<PackageReference Include="System.Reactive" Version="7.0.0" />
		<PackageReference Include="Velopack" Version="1.2.0" />
		<!-- WGC 로 받은 프레임은 D3D11 텍스처다. 그걸 만지려면 D3D11 바인딩이 필요하다. -->
		<PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
		<!-- 전처리 컴퓨트 셰이더를 런타임에 컴파일한다 (d3dcompiler_47.dll 은 Windows 기본 탑재) -->
		<PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
		<!-- WPF 의 D3DImage 는 D3D9 표면만 받는다. 캡처는 D3D11 이라 공유 표면으로 다리를 놓는다. -->
		<PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
		<!-- 추론. DirectML EP 라 GPU 벤더를 안 가린다 -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />

		<!--
		  DirectML 네이티브만 저장소에 두고 쓴다(Libs\DirectML\x64\).
		  ExcludeAssets="all" 로 패키지 쪽 복사를 끄지 않으면 같은 파일을 둘이 각각 복사해
		  어느 것이 출력에 남는지 빌드 순서에 달리게 된다.
		
		  관리 어셈블리(Microsoft.ML.OnnxRuntime.dll)는 건드리지 않는다.
		  그쪽은 System.Numerics.Tensors 를 물고 있어서 NuGet 이 계속 맡아야 한다.
		
		  올릴 때는 Microsoft.AI.DirectML 버전을 바꾸는 것만으로 끝나지 않는다.
		  새 버전 패키지의 bin\x64-win\ 에서 DLL 을 꺼내 Libs\DirectML\x64\ 를 덮어쓰고
		  같이 커밋해야 한다. onnxruntime 과 DirectML 은 짝이 맞아야 한다.
		-->
		<PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" ExcludeAssets="all" />
	</ItemGroup>

	<!--
	  Minguk.Image 는 소스 프로젝트가 아니라 미리 빌드해 둔 DLL 을 물린다.
	  csproj 안에 <Resource Include> 가 4만 개라, 소스로 두면 빌드할 때마다
	  그 거대한 csproj 를 평가하느라 시간을 버린다. 아이콘 팩은 거의 바뀌지 않으므로
	  DirectML 같은 외부 바이너리와 같은 취급을 한다 - sln 에서도 빠져 있다.

	  아이콘을 추가/교체해야 하면:
	    1) Minguk.Image\Minguk.Image.csproj 를 단독으로 열어 Release|x64 로 빌드하고
	    2) 나온 DLL 을 Libs\Minguk.Image.dll 로 덮어쓴 뒤 커밋한다.
	-->
	<ItemGroup>
	  <Reference Include="Minguk.Image">
	    <HintPath>..\Libs\Minguk.Image.dll</HintPath>
	    <Private>true</Private>
	  </Reference>
	</ItemGroup>

	<!--
	  Libs\ 는 프로젝트 폴더 밖이라 솔루션 탐색기에 나오지 않는다.
	  링크로 걸어 프로젝트 트리의 Libs\ 아래에 보이게만 한다.
	
	  빌드 결과는 달라지지 않는다 - CopyToOutputDirectory 를 주지 않았고,
	  Minguk.Image.dll 의 복사는 위의 Reference 가 Private=true 로 이미 하고 있다.
	
	  DevExpress\ko\ 의 위성 리소스 130 여 개는 넣지 않는다.
	  손댈 일이 없는데 트리만 길어진다.
	-->
	<ItemGroup>
	  <None Include="..\Libs\Minguk.Image.dll" Link="Libs\Minguk.Image.dll" />
	</ItemGroup>

	<!-- DirectML 네이티브. 출력 루트로 복사하고, 트리에는 Libs 아래로 보이게 한다. -->
	<ItemGroup>
	  <Content Include="..\Libs\DirectML\x64\DirectML.dll"
	           Link="Libs\DirectML\x64\DirectML.dll"
	           TargetPath="DirectML.dll">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<!--
	  디버그 레이어는 Debug 구성에만 넣는다.
	
	  패키지의 targets 는 구성을 보지 않는다 - Microsoft_AI_DirectML_SkipDebugLayerCopy 를
	  true 로 주지 않는 한 Release 에도 그대로 따라 들어간다. 여기서는 그 판단을 직접 한다.
	  DirectML.Debug.dll 은 디버그 레이어를 켰을 때만 쓰이므로 배포본에 있을 이유가 없다.
	-->
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
	  <Content Include="..\Libs\DirectML\x64\DirectML.Debug.dll"
	           Link="Libs\DirectML\x64\DirectML.Debug.dll"
	           TargetPath="DirectML.Debug.dll">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<!--
	  interception.dll 은 이 프로젝트만 쓰므로 프로젝트 안에 둔다.
	  Libs\ 는 여러 프로젝트가 나눠 쓰는 관리 어셈블리(Minguk.Image, DevExpress) 자리다.
	
	  x64\ 로 나눈 이유
	    Interception 은 x86 빌드도 배포한다. 비트수가 어긋나면 컴파일은 멀쩡히 통과하고
	    실행할 때 BadImageFormatException 으로 터진다. 폴더 이름에 박아 두면 잘못 넣기 어렵다.
	
	  TargetPath 를 주는 이유
	    DllImport 는 실행 파일 옆을 찾는다. 그냥 두면 출력에서도 Native\x64\ 밑으로 들어가
	    로드에 실패한다. Link 대신 TargetPath 를 쓰면 솔루션 탐색기에는 실제 폴더 그대로 보이고
	    출력만 루트로 간다.
	
	  None 이 아니라 Content 인 이유
	    Content 만 ProjectReference 를 타고 전파된다. 나중에 이 프로젝트를 참조하는
	    테스트 프로젝트가 생겨도 복사 규칙을 다시 쓰지 않아도 된다.
	-->
	<ItemGroup>
	  <None Remove="Native\x64\interception.dll" />
	  <Content Include="Native\x64\interception.dll" TargetPath="interception.dll">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Minguk.Base\Minguk.Base.csproj" />
	</ItemGroup>
	<!--
	  DevExpress 한국어 리소스(위성 어셈블리).

	  .NET 은 CurrentUICulture 에 맞춰 실행 파일 옆의 <문화권> 폴더에서 이것들을 찾는다.
	  없으면 조용히 영어로 나온다 - 그리드 검색창이 "Search" 로 나오던 것이 그 증상이다.

	  DevExpress 설치본(Components/Bin/NetCore/ko)에서 통째로 가져와 저장소에 넣었다.
	  3MB 남짓이라, 이렇게 두면 빌드 머신에 DevExpress 가 없어도 되고 배포본에도 그대로 들어간다.
	  DevExpress 버전을 올릴 때 이 폴더도 같이 갱신할 것.
	-->
	<ItemGroup>
		<None Include="..\Libs\DevExpress\ko\*.resources.dll">
			<Link>ko\%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>


	<!-- App.xaml 에 x:Class 진입점을 두지 않으므로 ApplicationDefinition 이 아니라 Page 로 넣는다 -->
	<ItemGroup>
		<ApplicationDefinition Remove="App.xaml" />
		<Page Include="App.xaml" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Settings.Designer.cs">
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
			<AutoGen>True</AutoGen>
			<DependentUpon>Settings.settings</DependentUpon>
		</Compile>
		<None Update="Properties\Settings.settings">
			<Generator>PublicSettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Content Include="AppSettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="AppSettings.*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<DependentUpon>AppSettings.json</DependentUpon>
		</Content>
		<Content Include="nlog.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<None Remove="AppSettings.json" />
		<None Remove="AppSettings.Development.json" />
		<None Remove="AppSettings.Production.json" />
		<None Remove="Resource\CI_Minguk.png" />
		<None Remove="Resource\CI_Minguk.ico" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resource\CI_Minguk.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="Resource\CI_Minguk.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>

	<!-- 폰트는 pack URI(./Fonts/#D2Coding)로 참조하므로 Resource 로 넣는다 -->
	<ItemGroup>
		<Resource Include="Fonts\D2Coding-Ver1.3.2-20180524.ttf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Fonts\D2CodingBold-Ver1.3.2-20180524.ttf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Resource>
	</ItemGroup>

</Project>
