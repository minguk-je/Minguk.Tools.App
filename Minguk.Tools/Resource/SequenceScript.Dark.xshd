<?xml version="1.0" encoding="utf-8"?>

<!--
    입력 시퀀스 스크립트 강조 (어두운 테마).

    스크립트는 C# 이다. AvalonEdit 이 들고 있는 기본 C# 정의를 쓰지 않는 이유는 두 가지다.
      하나, 그 정의는 밝은 테마 한 벌뿐이라 어두운 테마에서 읽기 어렵다.
      둘, 이 화면에서 실제로 부르는 것은 우리 API(Type·Click·MoveTo …)인데,
          그것이 여느 이름과 같은 색이면 무엇을 부를 수 있는지 눈에 안 들어온다.

    C# 전체를 칠하지 않는다. 이 화면에서 쓸 법한 것만 안다 - 모르는 낱말은 그냥 둔다.
    색만 다른 짝은 SequenceScript.Light.xshd 에 있다. 규칙이나 API 를 고치면 두 파일을 같이 고쳐야 한다.
-->
<SyntaxDefinition name="SequenceScript"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

    <Color name="Comment" foreground="#8B949E" fontStyle="italic" />
    <Color name="Keyword" foreground="#FF7B72" />
    <Color name="Api" foreground="#79C0FF" fontWeight="bold" />
    <Color name="Type" foreground="#D2A8FF" />
    <Color name="String" foreground="#A5D6FF" />
    <Color name="Number" foreground="#4EC9B0" />

    <RuleSet ignoreCase="false">

        <!--  주석과 글자가 먼저다. 그 안에 든 것은 낱말로 보지 않는다.  -->
        <Span color="Comment" begin="//" />
        <Span color="Comment" begin="#" />
        <Span color="Comment" multiline="true" begin="/\*" end="\*/" />

        <Span color="String" multiline="false">
            <Begin>"</Begin>
            <End>"</End>
            <RuleSet>
                <!--  \" 와 \\ 는 따옴표를 닫지 않는다.  -->
                <Span begin="\\" end="." />
            </RuleSet>
        </Span>

        <!--  이 화면에서 부를 수 있는 것들. 영문·한글 둘 다 같은 것을 가리킨다.  -->
        <Keywords color="Api">
            <Word>Type</Word>
            <Word>TypeLine</Word>
            <Word>Enter</Word>
            <Word>ToggleHangul</Word>
            <Word>Click</Word>
            <Word>RightClick</Word>
            <Word>ClickAt</Word>
            <Word>MoveTo</Word>
            <Word>Scroll</Word>
            <Word>Wait</Word>
            <Word>글자</Word>
            <Word>줄입력</Word>
            <Word>엔터</Word>
            <Word>한영</Word>
            <Word>클릭</Word>
            <Word>우클릭</Word>
            <Word>이동</Word>
            <Word>이동클릭</Word>
            <Word>휠</Word>
            <Word>쉬기</Word>
            <Word>Walk</Word><Word>걷기</Word><Word>Aim</Word>
            <Word>MoveBy</Word>
            <Word>Mobs</Word>
            <Word>NearestMob</Word>
            <Word>WaitMob</Word>
            <Word>ReadText</Word>
            <Word>ReadNumber</Word>
            <Word>Key</Word>
            <Word>KeyDown</Word>
            <Word>KeyUp</Word>
            <Word>IsStopped</Word>
            <Word>Print</Word>
            <Word>Watch</Word>
            <Word>Stop</Word>
            <Word>조준</Word>
            <Word>상대이동</Word>
            <Word>몹들</Word>
            <Word>가장가까운몹</Word>
            <Word>몹기다리기</Word>
            <Word>읽기</Word>
            <Word>숫자읽기</Word>
            <Word>키</Word>
            <Word>누르기</Word>
            <Word>떼기</Word>
            <Word>중지되었나</Word>
            <Word>출력</Word>
            <Word>보기</Word>
            <Word>끝</Word>
        </Keywords>

        <Keywords color="Keyword">
            <Word>var</Word>
            <Word>let</Word>
            <Word>const</Word>
            <Word>new</Word>
            <Word>for</Word>
            <Word>foreach</Word>
            <Word>in</Word>
            <Word>of</Word>
            <Word>while</Word>
            <Word>do</Word>
            <Word>if</Word>
            <Word>elif</Word>
            <Word>else</Word>
            <Word>switch</Word>
            <Word>case</Word>
            <Word>break</Word>
            <Word>continue</Word>
            <Word>return</Word>
            <Word>function</Word>
            <Word>def</Word>
            <Word>lambda</Word>
            <Word>class</Word>
            <Word>try</Word>
            <Word>except</Word>
            <Word>catch</Word>
            <Word>finally</Word>
            <Word>raise</Word>
            <Word>throw</Word>
            <Word>import</Word>
            <Word>from</Word>
            <Word>as</Word>
            <Word>pass</Word>
            <Word>and</Word>
            <Word>or</Word>
            <Word>not</Word>
            <Word>true</Word>
            <Word>false</Word>
            <Word>null</Word>
            <Word>True</Word>
            <Word>False</Word>
            <Word>None</Word>
        </Keywords>

        <Keywords color="Type">
            <Word>int</Word>
            <Word>string</Word>
            <Word>bool</Word>
            <Word>double</Word>
            <Word>char</Word>
            <Word>void</Word>
            <Word>MouseButton</Word>
            <Word>Math</Word>
            <Word>range</Word>
            <Word>len</Word>
            <Word>print</Word>
        </Keywords>

        <Rule color="Number">
            \b[+-]?\d+\b
        </Rule>
    </RuleSet>
</SyntaxDefinition>
