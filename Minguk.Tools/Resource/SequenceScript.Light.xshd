<?xml version="1.0" encoding="utf-8"?>

<!--
    입력 시퀀스 스크립트 강조 (밝은 테마).

    색은 이 PC 의 Visual Studio 2026 화면에서 옮겼다(2026-09-13). VS 의 C# 은 ReSharper 가 칠하므로
    VS 설정 파일(글꼴 및 색)이 아니라 ReSharper 라이트 기본색을 따른다.
      키워드·제어 키워드 #0000FF · 주석 #008000 · 문자열 #A31515 · 형식 #2B91AF
      메서드 #008B8B · 필드·속성 #800080 · 지역 변수/매개 변수·숫자·네임스페이스는 검정
    (VS 설정 파일의 제어 키워드 굵게·메서드 #74531F·지역 #1F377F 는 ReSharper 가 덮어써서 VS 화면에 안 보인다.)

    VS 는 컴파일러가 이름의 종류를 알려 주지만 여기는 정규식뿐이다. 그래서 어림한다.
      이름 뒤에 ( 가 오면 메서드, 점 뒤의 이름은 멤버, 나머지 이름은 지역 변수.
    규칙은 같은 자리에서 먼저 적힌 것이 이긴다 - 키워드가 이름 규칙보다 앞에 있어야 if( 가 메서드가 안 된다.

    C# 전체를 칠하지 않는다. 이 화면에서 쓸 법한 것만 안다.
    색만 다른 짝은 SequenceScript.Dark.xshd 에 있다. 규칙이나 API 를 고치면 두 파일을 같이 고쳐야 한다.
-->
<SyntaxDefinition name="SequenceScript"
                  xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

    <Color name="Comment" foreground="#008000" />
    <Color name="String" foreground="#A31515" />
    <Color name="Keyword" foreground="#0000FF" />
    <Color name="ControlKeyword" foreground="#0000FF" />
    <Color name="Type" foreground="#2B91AF" />
    <Color name="Method" foreground="#008B8B" />
    <Color name="Local" foreground="#1F377F" />
    <Color name="Plain" foreground="#000000" />
    <Color name="Member" foreground="#800080" />

    <RuleSet ignoreCase="false">

        <!--  주석과 글자가 먼저다. 그 안에 든 것은 낱말로 보지 않는다.  -->
        <Span color="Comment" begin="//" />
        <Span color="Comment" begin="#" />
        <Span color="Comment" multiline="true" begin="/\*" end="\*/" />

        <Span color="String" multiline="false">
            <Begin>"</Begin>
            <End>"</End>
            <RuleSet>
                <!--  \" 와 \\ 는 따옴표를 닫지 않는다.  -->
                <Span begin="\\" end="." />
            </RuleSet>
        </Span>
        <Span color="String" multiline="false">
            <Begin>'</Begin>
            <End>'</End>
            <RuleSet>
                <Span begin="\\" end="." />
            </RuleSet>
        </Span>

        <!--  VS 의 "keyword - control". 흐름을 바꾸는 것들.  -->
        <Keywords color="ControlKeyword">
            <Word>if</Word>
            <Word>elif</Word>
            <Word>else</Word>
            <Word>for</Word>
            <Word>foreach</Word>
            <Word>while</Word>
            <Word>do</Word>
            <Word>switch</Word>
            <Word>case</Word>
            <Word>default</Word>
            <Word>break</Word>
            <Word>continue</Word>
            <Word>return</Word>
            <Word>goto</Word>
            <Word>yield</Word>
            <Word>await</Word>
            <Word>try</Word>
            <Word>except</Word>
            <Word>catch</Word>
            <Word>finally</Word>
            <Word>throw</Word>
            <Word>raise</Word>
            <Word>pass</Word>
        </Keywords>

        <Keywords color="Keyword">
            <Word>var</Word>
            <Word>let</Word>
            <Word>const</Word>
            <Word>new</Word>
            <Word>in</Word>
            <Word>of</Word>
            <Word>is</Word>
            <Word>as</Word>
            <Word>when</Word>
            <Word>out</Word>
            <Word>ref</Word>
            <Word>static</Word>
            <Word>async</Word>
            <Word>using</Word>
            <Word>this</Word>
            <Word>typeof</Word>
            <Word>nameof</Word>
            <Word>function</Word>
            <Word>def</Word>
            <Word>lambda</Word>
            <Word>class</Word>
            <Word>import</Word>
            <Word>from</Word>
            <Word>global</Word>
            <Word>and</Word>
            <Word>or</Word>
            <Word>not</Word>
            <Word>true</Word>
            <Word>false</Word>
            <Word>null</Word>
            <Word>True</Word>
            <Word>False</Word>
            <Word>None</Word>
            <!--  C# 의 기본 형식은 VS 에서 키워드 색이다.  -->
            <Word>int</Word>
            <Word>long</Word>
            <Word>string</Word>
            <Word>bool</Word>
            <Word>double</Word>
            <Word>float</Word>
            <Word>decimal</Word>
            <Word>char</Word>
            <Word>byte</Word>
            <Word>object</Word>
            <Word>void</Word>
        </Keywords>

        <Keywords color="Type">
            <Word>MouseButton</Word>
            <Word>ScriptDetection</Word>
            <Word>Math</Word>
            <Word>Environment</Word>
            <Word>DateTime</Word>
            <Word>TimeSpan</Word>
            <Word>Stopwatch</Word>
            <Word>List</Word>
            <Word>Console</Word>
        </Keywords>

        <!--  네임스페이스는 VS 에서 본문색이다. 안 적으면 아래 지역 변수 규칙에 걸린다.  -->
        <Keywords color="Plain">
            <Word>System</Word>
        </Keywords>

        <!--  이 화면에서 부를 수 있는 것들(ScriptApiCatalog). 괄호 없이 적어도 메서드 색이다.  -->
        <Keywords color="Method">
            <Word>Type</Word><Word>글자</Word>
            <Word>TypeLine</Word><Word>줄입력</Word>
            <Word>Enter</Word><Word>엔터</Word>
            <Word>ToggleHangul</Word><Word>한영</Word>
            <Word>Click</Word><Word>클릭</Word>
            <Word>RightClick</Word><Word>우클릭</Word>
            <Word>ClickAt</Word><Word>이동클릭</Word>
            <Word>MoveTo</Word><Word>이동</Word>
            <Word>Scroll</Word><Word>휠</Word>
            <Word>Wait</Word><Word>쉬기</Word>
            <Word>Aim</Word><Word>조준</Word>
            <Word>MoveBy</Word><Word>상대이동</Word>
            <Word>MoveCursor</Word><Word>커서이동</Word>
            <Word>HitConfirmed</Word><Word>명중확인</Word>
            <Word>HealthBar</Word><Word>체력바</Word>
            <Word>HitByHealthBar</Word><Word>명중했나</Word>
            <Word>MoveToProject</Word><Word>프로젝트이동</Word>
            <Word>SetMouseMode</Word><Word>마우스모드</Word>
            <Word>SetAimZone</Word><Word>조준범위</Word>
            <Word>SetAimLead</Word><Word>앞질러겨누기</Word>
            <Word>SetAimConfirm</Word><Word>확인후쏘기</Word>
            <Word>MouseDown</Word><Word>버튼누르기</Word>
            <Word>MouseUp</Word><Word>버튼떼기</Word>
            <Word>Drag</Word><Word>끌기</Word>
            <Word>DragBy</Word><Word>상대끌기</Word>
            <Word>Detections</Word><Word>검출들</Word>
            <Word>NearestDetection</Word><Word>가장가까운검출</Word>
            <Word>TargetDetection</Word><Word>목표</Word>
            <Word>ReleaseTarget</Word><Word>목표풀기</Word>
            <Word>WaitDetection</Word><Word>검출기다리기</Word>
            <Word>ReadText</Word><Word>읽기</Word>
            <Word>ReadNumber</Word><Word>숫자읽기</Word>
            <Word>Ammo</Word><Word>탄약</Word>
            <Word>AmmoMax</Word><Word>탄약최대</Word>
            <Word>Health</Word><Word>체력</Word>
            <Word>HealthMax</Word><Word>체력최대</Word>
            <Word>Ultimate</Word><Word>궁극기</Word>
            <Word>UltimateReady</Word><Word>궁극기준비</Word>
            <Word>HasTextAt</Word><Word>글자있나</Word>
            <Word>Key</Word><Word>키</Word>
            <Word>KeyDown</Word><Word>누르기</Word>
            <Word>KeyUp</Word><Word>떼기</Word>
            <Word>Walk</Word><Word>걷기</Word>
            <Word>IsStopped</Word><Word>중지되었나</Word>
            <Word>Print</Word><Word>출력</Word>
            <Word>Watch</Word><Word>보기</Word>
            <Word>Stop</Word><Word>끝</Word>
            <Word>ResourcePath</Word><Word>리소스경로</Word>
            <Word>ResourceText</Word><Word>리소스글</Word>
            <Word>ResourceBytes</Word><Word>리소스바이트</Word>
            <Word>Setting</Word><Word>설정</Word>
            <Word>SetSetting</Word><Word>설정저장</Word>
            <Word>SettingList</Word><Word>설정목록</Word>
            <Word>HasSetting</Word><Word>설정있나</Word>
            <Word>PlaySound</Word><Word>소리</Word>
        </Keywords>

        <!--  이름 뒤에 ( 가 오면 메서드 - 스크립트 안에서 만든 함수도 VS 처럼 칠해진다.  -->
        <Rule color="Method">
            [\p{L}_][\p{L}\p{Nd}_]*(?=\s*\()
        </Rule>

        <!--  점 뒤의 이름은 멤버(검출.머리x). ReSharper 에서 속성·필드는 보라다.  -->
        <Rule color="Member">
            (?&lt;=\.)[\p{L}_][\p{L}\p{Nd}_]*
        </Rule>

        <Rule color="Plain">
            \b\d+(\.\d+)?[fFdDmMlL]?\b
        </Rule>

        <!--  남은 이름은 지역 변수로 본다.  -->
        <Rule color="Local">
            [\p{L}_][\p{L}\p{Nd}_]*
        </Rule>
    </RuleSet>
</SyntaxDefinition>
