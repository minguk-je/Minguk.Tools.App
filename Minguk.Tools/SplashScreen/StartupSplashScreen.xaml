<dx:SplashScreenWindow x:Class="Minguk.Tools.SplashScreen.StartupSplashScreen"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                       xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
                       xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
                       MinWidth="600"
                       MinHeight="400"
                       FontFamily="{DynamicResource BaseFontFamily}"
                       FontSize="{DynamicResource BaseFontSize}"
                       dx:DXDesignTimeHelper.Background="#FF2B67AF"
                       AllowAcrylic="True"
                       Topmost="True"
                       mc:Ignorable="d"
                       d:DataContext="{x:Static dxmvvm:DXSplashScreenViewModel.DesignTimeData}">
    <!--
        SplashScreenWindow 는 시작을 빠르게 하려고 자체 테마 메커니즘을 쓴다.
        그래서 현재 애플리케이션 테마가 여기 안의 컨트롤에는 적용되지 않는다.
        굳이 적용하려면 AllowTheming="True" 를 켜야 하는데, 그만큼 시작이 느려진다.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <dx:DXImage x:Name="PART_Logo"
                    Width="140"
                    Height="40"
                    Style="{DynamicResource ResourceKey={dxt:FluentSplashScreenThemeKey ResourceKey=LogoImageStyle}}"
                    Source="{Binding Logo}"
                    Stretch="UniformToFill" />

        <TextBlock x:Name="PART_Title"
                   Grid.Row="1"
                   Style="{DynamicResource ResourceKey={dxt:FluentSplashScreenThemeKey ResourceKey=TitleTextBoxStyle}}"
                   FontFamily="{DynamicResource BaseFontFamily}"
                   Text="{Binding Title}" />

        <StackPanel Grid.Row="2"
                    VerticalAlignment="Top"
                    Orientation="Vertical">
            <TextBlock x:Name="PART_SubTitle"
                       Style="{DynamicResource ResourceKey={dxt:FluentSplashScreenThemeKey ResourceKey=SubTitleTextBoxStyle}}"
                       FontFamily="{DynamicResource BaseFontFamily}"
                       Text="{Binding Subtitle}" />
            <ProgressBar Style="{DynamicResource ResourceKey={dxt:FluentSplashScreenThemeKey ResourceKey=ProgressBarStyle}}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Value="{Binding Progress}" />
        </StackPanel>

        <TextBlock x:Name="PART_Copyright"
                   Grid.Row="2"
                   Style="{DynamicResource ResourceKey={dxt:FluentSplashScreenThemeKey ResourceKey=CopyrightTextBoxStyle}}"
                   FontFamily="{DynamicResource BaseFontFamily}"
                   Text="{Binding Copyright}" />

        <TextBlock x:Name="PART_Status"
                   Grid.Row="2"
                   Style="{DynamicResource ResourceKey={dxt:FluentSplashScreenThemeKey ResourceKey=StatusTextBoxStyle}}"
                   FontFamily="{DynamicResource BaseFontFamily}"
                   Text="{Binding Status}" />
    </Grid>
</dx:SplashScreenWindow>
