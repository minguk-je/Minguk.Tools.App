<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                    xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/DataTemplate.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="BandHeader.Style"
           TargetType="dxg:BaseGridHeader">
        <Setter Property="Padding" Value="8,0,8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{Binding RowMinHeight, RelativeSource={RelativeSource AncestorType={x:Type dxg:TableView}}}" />
    </Style>


    <Style x:Key="GridColumn.RowNumber.Style"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="Width" Value="50" />
        <Setter Property="AllowColumnFiltering" Value="False" />
        <Setter Property="FieldName" Value="RowNumber" />
        <Setter Property="ShowInColumnChooser" Value="False" />
        <Setter Property="UnboundType" Value="Integer" />
        <Setter Property="Visible" Value="False" />
    </Style>

    <Style x:Key="GridColumn.Style"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="AllowColumnFiltering" Value="True" />
        <Setter Property="ShowInColumnChooser" Value="True" />
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="AllowCellMerge" Value="False" />
    </Style>

    <DataTemplate x:Key="GridColumn.Header.DataTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0,0,0,0"
                       Padding="0,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding}" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="GridColumn.TotalSummaryContentStyle"
           BasedOn="{StaticResource {dxgt:TotalSummaryThemeKey ResourceKey=TotalSummaryContentStyle}}"
           TargetType="dx:DataContentPresenter">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>


    <Style x:Key="colMENU_CD"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="Width" Value="80" />
        <Setter Property="FieldName" Value="MENU_CD" />
        <Setter Property="Header" Value="메뉴코드" />
        <Setter Property="HeaderTemplate" Value="{DynamicResource ColumnHeader}" />
    </Style>

    <Style x:Key="colMENU_NM"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="Width" Value="120" />
        <Setter Property="FieldName" Value="MENU_NM" />
        <Setter Property="Header" Value="메뉴이름" />
        <Setter Property="HeaderTemplate" Value="{DynamicResource ColumnHeader}" />
    </Style>

    <Style x:Key="colUPPER_MENU_CD"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="Width" Value="80" />
        <Setter Property="FieldName" Value="UPPER_MENU_CD" />
        <Setter Property="Header" Value="상위메뉴" />
        <Setter Property="HeaderTemplate" Value="{DynamicResource ColumnHeader}" />
    </Style>

    <Style x:Key="colDLL_NM"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="Width" Value="120" />
        <Setter Property="FieldName" Value="DLL_NM" />
        <Setter Property="Header" Value="DLL NAME" />
        <Setter Property="HeaderTemplate" Value="{DynamicResource ColumnHeader}" />
    </Style>

    <Style x:Key="colCLASS_NM"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="Width" Value="120" />
        <Setter Property="FieldName" Value="CLASS_NM" />
        <Setter Property="Header" Value="CLASS NAME" />
        <Setter Property="HeaderTemplate" Value="{DynamicResource ColumnHeader}" />
    </Style>

    <Style x:Key="colIMAGE_CD"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="Width" Value="80" />
        <Setter Property="FieldName" Value="IMAGE_CD" />
        <Setter Property="Header" Value="이미지코드" />
        <Setter Property="HeaderTemplate" Value="{DynamicResource ColumnHeader}" />
    </Style>

    <Style x:Key="colIMAGE_NM"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="Width" Value="120" />
        <Setter Property="FieldName" Value="IMAGE_NM" />
        <Setter Property="Header" Value="이미지이름" />
        <Setter Property="HeaderTemplate" Value="{DynamicResource ColumnHeader}" />
    </Style>

    <Style x:Key="colUPPER_IMAGE_CD"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="Width" Value="80" />
        <Setter Property="FieldName" Value="UPPER_IMAGE_CD" />
        <Setter Property="Header" Value="상위코드" />
        <Setter Property="HeaderTemplate" Value="{DynamicResource ColumnHeader}" />
    </Style>

    <Style x:Key="colIS_ACTIVE"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="Width" Value="50" />
        <Setter Property="FieldName" Value="IS_ACTIVE" />
        <Setter Property="Header" Value="사용" />
        <Setter Property="HeaderTemplate" Value="{DynamicResource ColumnHeader}" />
        <Setter Property="EditSettings">
            <Setter.Value>
                <dxe:CheckEditSettings />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="colSORT"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="Width" Value="50" />
        <Setter Property="FieldName" Value="SORT" />
        <Setter Property="Header" Value="정렬" />
        <Setter Property="HeaderTemplate" Value="{DynamicResource ColumnHeader}" />
        <Setter Property="AllowSorting" Value="True" />
        <Setter Property="EditSettings">
            <Setter.Value>
                <dxe:SpinEditSettings DisplayFormat="#,0" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="colDATETIME"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="Width" Value="140" />
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="AllowEditing" Value="False" />
        <Setter Property="AllowPrinting" Value="True" />
        <Setter Property="HeaderTemplate" Value="{DynamicResource ResourceKey=GridColumn.Header.DataTemplate}" />
        <Setter Property="Visible" Value="True" />
        <Setter Property="EditSettings">
            <Setter.Value>
                <dxe:DateEditSettings Mask="yyyy-MM-dd HH:mm:ss.fffff"
                                      MaskCulture="ko-KR"
                                      MaskUseAsDisplayFormat="True" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="colCREATE_DATETIME"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="Width" Value="140" />
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="AllowEditing" Value="False" />
        <Setter Property="AllowPrinting" Value="False" />
        <Setter Property="FieldName" Value="CREATE_DATETIME" />
        <Setter Property="Header" Value="생성일시" />
        <Setter Property="HeaderTemplate" Value="{DynamicResource ResourceKey=GridColumn.Header.DataTemplate}" />
        <Setter Property="ReadOnly" Value="True" />
        <Setter Property="Visible" Value="False" />
        <Setter Property="EditSettings">
            <Setter.Value>
                <dxe:DateEditSettings Mask="yyyy-MM-dd HH:mm:ss.fff"
                                      MaskCulture="ko-KR"
                                      MaskUseAsDisplayFormat="True" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="colCREATE_USER_ID"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="Width" Value="70" />
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="AllowEditing" Value="False" />
        <Setter Property="AllowPrinting" Value="False" />
        <Setter Property="FieldName" Value="CREATE_USER_ID" />
        <Setter Property="Header" Value="생성자" />
        <Setter Property="HeaderTemplate" Value="{DynamicResource ResourceKey=GridColumn.Header.DataTemplate}" />
        <Setter Property="ReadOnly" Value="True" />
        <Setter Property="Visible" Value="False" />
    </Style>

    <Style x:Key="colUPDATE_DATETIME"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="Width" Value="140" />
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="AllowEditing" Value="False" />
        <Setter Property="AllowPrinting" Value="False" />
        <Setter Property="FieldName" Value="UPDATE_DATETIME" />
        <Setter Property="Header" Value="수정일시" />
        <Setter Property="HeaderTemplate" Value="{DynamicResource ResourceKey=GridColumn.Header.DataTemplate}" />
        <Setter Property="ReadOnly" Value="True" />
        <Setter Property="Visible" Value="False" />
        <Setter Property="EditSettings">
            <Setter.Value>
                <dxe:DateEditSettings Mask="yyyy-MM-dd HH:mm:ss.fff"
                                      MaskCulture="ko-KR"
                                      MaskUseAsDisplayFormat="True" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="colUPDATE_USER_ID"
           TargetType="{x:Type dxg:GridColumn}">
        <Setter Property="Width" Value="70" />
        <Setter Property="AllowBestFit" Value="True" />
        <Setter Property="AllowEditing" Value="False" />
        <Setter Property="AllowPrinting" Value="False" />
        <Setter Property="FieldName" Value="UPDATE_USER_ID" />
        <Setter Property="Header" Value="수정자" />
        <Setter Property="HeaderTemplate" Value="{DynamicResource ResourceKey=GridColumn.Header.DataTemplate}" />
        <Setter Property="ReadOnly" Value="True" />
        <Setter Property="Visible" Value="False" />
    </Style>

</ResourceDictionary>