<Project Sdk="Microsoft.NET.Sdk">

	<!--
		글자 읽기 - IOcrEngine 과 엔진들(PP-OCRv5 ONNX GPU·CPU, Windows 내장 OCR), 고르는 팩터리, ONNX 세션 감싸개(OnnxDmlEngine).
		셸에서 떼어 냈다(사용자, 2026-09-18 "OCR 전체를 별도의 프로젝트로").

		OnnxDmlEngine(Minguk.Tools.Inference)이 여기 있는 이유 - 두 OCR 모델이 이것으로 돈다. 몹 찾기(셸의 OnnxDetector)도 같은 것을 쓰므로
		셸이 이 프로젝트를 참조해 가져다 쓴다. ONNX 패키지는 이 프로젝트와 셸(몹 찾기)이 같은 판(1.24.4)이어야 한다 - DirectML 네이티브(Libs\DirectML\x64)와 짝이다.

		참조: Minguk.Tools.Core(LabelBox - 읽은 단어의 자리). 셸·Vision 은 참조하지 않는다.
		자리 규칙(HudRegions·NameplateRegion)은 셸의 Vision\Ocr 에 남았다 - 엔진이 아니라 "어디를 읽나" 다.
		네임스페이스는 Minguk.Tools.Vision.Ocr 그대로다(RootNamespace Minguk.Tools).
	-->

	<PropertyGroup>
		<Platforms>x64</Platforms>
		<Platform Condition="'$(Platform)' == 'AnyCPU'">x64</Platform>
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<RootNamespace>Minguk.Tools</RootNamespace>
		<AssemblyName>Minguk.Tools.Ocr</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NLog" Version="6.2.0" />
		<!-- 추론. DirectML EP - 셸과 같은 판. 네이티브 DirectML 은 셸이 Libs\DirectML\x64 에서 나른다(패키지 쪽 복사는 끈다). -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.4" />
		<PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" ExcludeAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Minguk.Tools.Core\Minguk.Tools.Core.csproj" />
	</ItemGroup>

	<!--
	  글자 읽기 모델(PP-OCRv5, Apache-2.0). 도구\ppocr-onnx-내보내기.py 로 만들어 커밋한 것.
	  출력 루트를 어지럽히지 않게 Models\Ocr\ 로 보낸다. Content 라 이 프로젝트를 참조하는 셸·하네스 출력에도 따라간다.
	-->
	<ItemGroup>
	  <Content Include="..\Libs\PaddleOcr\det.onnx" Link="Libs\PaddleOcr\det.onnx" TargetPath="Models\Ocr\det.onnx">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="..\Libs\PaddleOcr\rec.onnx" Link="Libs\PaddleOcr\rec.onnx" TargetPath="Models\Ocr\rec.onnx">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="..\Libs\PaddleOcr\rec-dict.txt" Link="Libs\PaddleOcr\rec-dict.txt" TargetPath="Models\Ocr\rec-dict.txt">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <!-- PP-OCRv6 tiny·small (RapidOCR 배포 ONNX, Apache-2.0). SHA256 은 RapidOCR default_models.yaml 과 맞춰 받았다. -->
	  <Content Include="..\Libs\PaddleOcr\v6\*" Link="Libs\PaddleOcr\v6\%(Filename)%(Extension)" TargetPath="Models\Ocr\v6\%(Filename)%(Extension)">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

</Project>
