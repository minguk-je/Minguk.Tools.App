<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    이 파일이 없으면 사용자 전역 NuGet.Config(%AppData%\NuGet\NuGet.Config)의 소스를 그대로
    물려받는다. 거기에 이미 없어진 로컬 폴더가 등록돼 있으면(NU1301) 복원이 통째로 실패한다.
    <clear /> 로 끊고 이 프로젝트가 실제로 쓰는 두 곳만 남긴다.

    DevExpress 는 설치본에 딸려 오는 로컬 폴더 피드를 쓴다. 키를 파일에 적지 않아도 되고,
    설치된 버전과 패키지 버전이 어긋날 일도 없다.
    다른 PC 에서 경로가 다르면 이 값만 고치면 된다.
    온라인 피드(nuget.devexpress.com)를 쓰려면 개인 Feed Authorization Key 가 필요한데,
    그 키는 저장소에 커밋하지 말 것.
  -->
  <packageSources>
    <clear />
    <add key="DevExpress" value="C:\Program Files\DevExpress 26.1\Components\System\Components\Packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- DevExpress.* 는 DevExpress 피드에서만, 나머지는 nuget.org 에서만 받는다. -->
  <packageSourceMapping>
    <packageSource key="DevExpress">
      <package pattern="DevExpress.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
