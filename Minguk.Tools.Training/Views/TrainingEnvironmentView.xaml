<UserControl x:Class="Minguk.Tools.Training.Views.TrainingEnvironmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:controls="clr-namespace:Minguk.Base.Controls;assembly=Minguk.Base"
             xmlns:dependency="clr-namespace:Minguk.Base.Dependency;assembly=Minguk.Base"
             xmlns:viewModels="clr-namespace:Minguk.Tools.Training.ViewModels"
             Style="{DynamicResource BaseControlStyle}"
             FontFamily="{DynamicResource BaseFontFamily}"
             FontSize="{DynamicResource BaseFontSize}"
             DataContext="{dxmvvm:ViewModelSource Type={x:Type viewModels:TrainingEnvironmentViewModel}}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type viewModels:TrainingEnvironmentViewModel},
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="500"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 행 번호가 그려지는 RowIndicator 템플릿이 DataTemplate.xaml 에, 숨은 번호 열 스타일이 GridColumnStyle.xaml 에 있다 -->
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/DataTemplate.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/GridColumnStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Minguk.Base;component/Resource/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:EventToCommand Command="{Binding OnInitializedCommand}"
                               EventName="Loaded" />

        <!-- 폴더 고르기 대화 상자. 화면에 선언하지 않으면 Guard 가 예외를 삼켜 버튼이 죽은 것처럼 보인다. -->
        <dxmvvm:FolderBrowserDialogService />
    </dxmvvm:Interaction.Behaviors>

    <dxlc:LayoutControl Padding="8"
                        Orientation="Vertical">

        <!--
            자리 둘을 나눠 둔다(사용자 결정 2026-09-14).
              학습 경로    - 도구. 지워도 도구\학습-환경-준비.ps1 로 다시 만들면 된다.
              프로젝트 경로 - 내 것. 사진·라벨·모델. 다시 만들 수 없다 - 백업할 것은 이쪽이다.
            고치면 곧바로 저장하고 아래 표를 다시 그린다 - 설정 화면에 두었을 때는 바꾼 자리가 맞는지 볼 길이 없었다.
        -->
        <dxlc:LayoutGroup Header="폴더"
                          Orientation="Vertical"
                          View="GroupBox">

            <dxlc:LayoutGroup.GroupBoxStyle>
                <Style TargetType="dxlc:GroupBox">
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </dxlc:LayoutGroup.GroupBoxStyle>

            <dxlc:LayoutItem AddColonToLabel="False" Label="학습 경로">
                <dxe:ButtonEdit AllowDefaultButton="False"
                                EditValue="{Binding TrainingRoot, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                NullText="(설치 폴더\학습)"
                                ToolTip="파이썬 환경(YOLO·D-FINE) · D-FINE 저장소 · 사전학습 가중치 · 학습 결과가 이 폴더 아래 있습니다.&#10;가상환경은 복사해 옮길 수 없습니다 - 새 자리에는 도구\학습-환경-준비.ps1 로 다시 만드세요.">
                    <dxe:ButtonEdit.Buttons>
                        <dxe:ButtonInfo Command="{Binding DoChooseTrainingRootCommand}"
                                        Content="폴더"
                                        GlyphKind="Regular"
                                        ToolTip="폴더를 고릅니다." />
                    </dxe:ButtonEdit.Buttons>
                </dxe:ButtonEdit>
            </dxlc:LayoutItem>

            <dxlc:LayoutItem AddColonToLabel="False" Label="프로젝트 경로">
                <dxe:ButtonEdit AllowDefaultButton="False"
                                EditValue="{Binding ProjectsRoot, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                NullText="(설치 폴더\프로젝트)"
                                ToolTip="사진 · 라벨 · 모델 · 이름 붙인 자리 · 프레임 저장이 이 폴더 아래 있습니다. 다시 만들 수 없는 것들이라 백업할 것은 이쪽입니다.&#10;이미 담아 둔 데이터셋은 여기를 바꿔도 따라 옮겨지지 않습니다 - 폴더째 옮기고 라벨링 화면에서 다시 고르세요.">
                    <dxe:ButtonEdit.Buttons>
                        <dxe:ButtonInfo Command="{Binding DoChooseProjectsRootCommand}"
                                        Content="폴더"
                                        GlyphKind="Regular"
                                        ToolTip="폴더를 고릅니다." />
                    </dxe:ButtonEdit.Buttons>
                </dxe:ButtonEdit>
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>

        <dxlc:LayoutGroup HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Orientation="Horizontal">
            <dx:SimpleButton Width="90"
                             Command="{Binding DoRefreshCommand}"
                             Content="갱신" />
            <dx:SimpleButton Width="110"
                             Command="{Binding DoOpenTrainingRootCommand}"
                             Content="학습 폴더 열기" />
            <dx:SimpleButton Width="130"
                             Command="{Binding DoOpenProjectsRootCommand}"
                             Content="프로젝트 폴더 열기" />
        </dxlc:LayoutGroup>

        <dxlc:LayoutItem AddColonToLabel="False"
                         VerticalAlignment="Stretch"
                         Label="">
            <!--
                행 번호 칸(인디케이터) 폭을 행 수에 맞춰 늘리는 틀. 캡처 화면과 같은 구성이다 -
                숨은 Border 가 SharedSizeGroup 으로 가장 넓은 행 번호만큼 넓어지고, 그 폭을 IndicatorWidth 로 되돌린다.
                이걸 안 하면 세 자리부터 앞이 잘린다.
            -->
            <Grid Grid.IsSharedSizeScope="True">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RowNumberGroup" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 폭만 재는 자리. 눈에 보이지 않는다. Margin 은 셀 여백 보정. -->
                <Border x:Name="GridRowNumberSizeProxy"
                        Margin="-4"
                        Visibility="Hidden" />

                <controls:BaseGridControl Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          dependency:GridControlDependency.IsRowNumber="True"
                                          AutoGenerateColumns="None"
                                          ItemsSource="{Binding Items}">
                    <dxg:GridControl.View>
                        <controls:BaseTableView AllowEditing="False"
                                                IndicatorWidth="{Binding Path=(Border.ActualWidth), ElementName=GridRowNumberSizeProxy, Mode=OneWay}"
                                                ShowGroupPanel="False" />
                    </dxg:GridControl.View>

                    <!-- 행 번호용 숨은 언바운드 열. 왼쪽 인디케이터가 이 값을 쓴다. -->
                    <dxg:GridColumn Style="{StaticResource GridColumn.RowNumber.Style}" />

                    <dxg:GridColumn FieldName="Name" Header="무엇" />
                    <dxg:GridColumn FieldName="State" Header="상태" />
                    <dxg:GridColumn Width="*" FieldName="Path" Header="자리" />
                    <dxg:GridColumn Width="*" FieldName="Note" Header="없으면" />
                </controls:BaseGridControl>
            </Grid>
        </dxlc:LayoutItem>

        <dxlc:LayoutItem AddColonToLabel="False"
                         VerticalAlignment="Top"
                         Label="">
            <TextBlock Margin="2"
                       Text="{Binding Summary}"
                       TextWrapping="Wrap" />
        </dxlc:LayoutItem>

    </dxlc:LayoutControl>

</UserControl>
