<Project Sdk="Microsoft.NET.Sdk">

	<!--
		학습 환경 모듈 - 셸에 붙는 첫 기능 프로젝트다(2026-09-14).

		여기 든 것: 학습 도구(파이썬 환경·저장소·가중치)가 갖춰졌는지 보는 화면과, 학습 경로·프로젝트 경로를
		고르는 설정 페이지. 설정 페이지는 원래 셸의 ConfigView 에 있었는데 "기능은 제 프로젝트가 들고 온다" 는
		규칙에 맞춰 이리로 내렸다.

		기능 프로젝트를 하나 더 만들 때 이 폴더 모양을 그대로 따르면 된다 - csproj 는 Core 와 Base 만 참조하고,
		TrainingModule 처럼 IToolModule 구현을 하나 두고, 셸의 ToolModules.Use 에 한 줄 더한다.
	-->

	<PropertyGroup>
		<Platforms>x64</Platforms>
		<Platform Condition="'$(Platform)' == 'AnyCPU'">x64</Platform>
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>enable</Nullable>
		<RootNamespace>Minguk.Tools.Training</RootNamespace>
		<AssemblyName>Minguk.Tools.Training</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DevExpress.Mvvm" Version="26.1.3" />
		<PackageReference Include="DevExpress.Wpf" Version="26.1.3" />
		<PackageReference Include="DevExpress.Wpf.Core" Version="26.1.3" />
		<PackageReference Include="DevExpress.Wpf.ThemesLW" Version="26.1.3" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
	</ItemGroup>

	<!-- 메뉴 아이콘. 셸과 같은 취급이다 - 솔루션에 없는 외부 바이너리라 Reference + HintPath 로 문다. -->
	<ItemGroup>
	  <Reference Include="Minguk.Image">
	    <HintPath>..\Libs\Minguk.Image.dll</HintPath>
	    <Private>true</Private>
	  </Reference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Minguk.Base\Minguk.Base.csproj" />
		<ProjectReference Include="..\Minguk.Tools.Core\Minguk.Tools.Core.csproj" />
	</ItemGroup>

</Project>
